from __future__ import annotations

import cv2


def safe_read_image_from_bytes(data: bytes) -> "cv2.Mat":
    # Decode to avoid cv2.imread path issues.
    arr = cv2.imdecode(bytearray(data), cv2.IMREAD_COLOR)
    if arr is None:
        raise ValueError("Invalid image bytes")
    return arr


def resize_if_necessary(img: "cv2.Mat", *, max_w: int, max_h: int, max_pixels: int) -> "cv2.Mat":
    h, w = img.shape[:2]
    pixels = h * w
    if pixels <= max_pixels and w <= max_w and h <= max_h:
        return img

    scale = min(max_w / w, max_h / h, (max_pixels / pixels) ** 0.5)
    scale = float(max(scale, 0.05))
    new_w = max(1, int(w * scale))
    new_h = max(1, int(h * scale))

    resized = cv2.resize(img, (new_w, new_h), interpolation=cv2.INTER_AREA)
    return resized


def extract_embedding_placeholder(img: "cv2.Mat") -> list[float]:
    # MVP placeholder: return deterministic vector size 512.
    # Replace with InsightFace/YOLO inference in a later step.
    h, w = img.shape[:2]
    base = (h + w) % 1000
    vec = [(base + i) / 1000.0 for i in range(512)]
    return vec


def run_liveness_placeholder(img: "cv2.Mat") -> dict:
    # Passive liveness placeholder
    return {"liveness_score": 0.95, "is_live": True}
