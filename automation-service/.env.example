PORT=3007
NODE_ENV=development
DB_HOST=localhost
DB_PORT=5432
DB_NAME=automationdb
DB_USER=REPLACE_WITH_DB_USER
DB_PASSWORD=REPLACE_WITH_DB_PASSWORD
REDIS_URL=redis://redis:6379/0
JWT_SECRET=REPLACE_WITH_JWT_SECRET
JWT_ISSUER=face-recognition
JWT_AUDIENCE=face-recognition-users
NOTIFICATION_SERVICE_URL=http://notification-service:3006
BORROW_SERVICE_URL=http://borrow-service:8000
SCHEDULE_SERVICE_URL=http://schedule-service:3002
ACCESS_SERVICE_URL=http://access-service:3003
USER_SERVICE_URL=http://user-service:3001
CORS_ORIGINS=*

# Service-to-Service Authentication (uses same secret as JWT_ACCESS_SECRET)
SERVICE_JWT_SECRET=REPLACE_WITH_SERVICE_JWT_SECRET
