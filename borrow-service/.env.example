PORT=8000
NODE_ENV=development
POSTGRES_URL=REPLACE_WITH_POSTGRES_URL
USER_SERVICE_URL=http://localhost:3001
ACCESS_SERVICE_URL=http://localhost:3003
JWT_SECRET=REPLACE_WITH_JWT_SECRET
JWT_ISSUER=face-recognition
JWT_AUDIENCE=face-recognition-users
MAX_BORROW_DAYS=14
MAX_BORROW_BOOKS=3
GOOGLE_BOOKS_API_KEY=REPLACE_WITH_GOOGLE_BOOKS_API_KEY

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672

# Service-to-Service Authentication (uses same secret as JWT_ACCESS_SECRET)
SERVICE_JWT_SECRET=REPLACE_WITH_SERVICE_JWT_SECRET

# VietQR (thanh toán ngân hàng)
VIETQR_BANK_CODE=MB
VIETQR_ACCOUNT_NUMBER=0395324779
VIETQR_ACCOUNT_NAME=THU VIEN DAI HOC CONG NGHIEP TPHCM

# VietQR API - automatic reconciliation via api.vietqr.vn
# Sandbox: https://dev.vietqr.org | Production: https://api.vietqr.org
# Leave USERNAME/PASSWORD empty to keep static-QR fallback (no auto settle).
VIETQR_API_BASE_URL=https://dev.vietqr.org
VIETQR_API_USERNAME=
VIETQR_API_PASSWORD=
VIETQR_TERMINAL_CODE=
# Callback auth: credentials WE define and share with the VietQR team.
# VietQR calls POST /borrow/vietqr/token-generate (Basic) then
# POST /borrow/vietqr/transaction-sync (Bearer). ALL THREE REQUIRED.
VIETQR_CALLBACK_USERNAME=
VIETQR_CALLBACK_PASSWORD=
VIETQR_CALLBACK_SECRET=
