# API Gateway
PORT=80
NODE_ENV=production

# JWT
JWT_SECRET=REPLACE_WITH_JWT_SECRET

# Service URLs
USER_SERVICE=http://user-service:3001
BORROW_SERVICE=http://borrow-service:8000
NOTIFICATION_SERVICE=http://notification-service:3006
SCHEDULE_SERVICE=http://schedule-service:3002
ACCESS_SERVICE=http://access-service:3003
AI_SERVICE=http://ai-service:3004
AUTOMATION_SERVICE=http://automation-service:3007
FACE_RECOGNITION_API=http://face-recognition-service:5000

# Frontend
FRONTEND_URL=http://localhost:3000

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:19006

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
