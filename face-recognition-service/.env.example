# --- API/Worker common ---
APP_NAME=face-recognition-platform
ENV=dev
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:19006

# --- JWT ---
JWT_ISSUER=face-recognition
JWT_AUDIENCE=face-recognition-users
JWT_ACCESS_SECRET=REPLACE_WITH_JWT_ACCESS_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_JWT_REFRESH_SECRET
JWT_ACCESS_EXPIRES_MINUTES=15
JWT_REFRESH_EXPIRES_DAYS=30

# --- Service-to-Service Authentication ---
# Used for inter-service JWT tokens (same secret across all Node.js services)
# Generate a secure random string: openssl rand -hex 32
SERVICE_JWT_SECRET=REPLACE_WITH_SERVICE_JWT_SECRET

# --- RBAC ---
# Roles: admin, user
# (Seed users can be added later)

# --- Redis (Celery + Cooldown) ---
REDIS_URL=redis://redis:6379/0

# --- Postgres ---
POSTGRES_URL=REPLACE_WITH_POSTGRES_URL
POSTGRES_DB=facedb

# --- MinIO (Object Storage for encrypted raw images) ---
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=REPLACE_WITH_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=REPLACE_WITH_MINIO_SECRET_KEY
MINIO_BUCKET=face-raw-images

# --- Milvus ---
MILVUS_HOST=milvus
MILVUS_PORT=19530
MILVUS_COLLECTION=face_embeddings

# --- Inference ---
# Toggle based on available GPU.
USE_CUDA=false
MAX_IMAGE_WIDTH=1280
MAX_IMAGE_HEIGHT=1280
MAX_IMAGE_PIXELS=2073600  # 1280*1280

# --- Celery ---
# WARNING: Change default credentials in production!
CELERY_BROKER_URL=amqp://REPLACE_WITH_RABBITMQ_USER:REPLACE_WITH_RABBITMQ_PASSWORD@rabbitmq:5672
CELERY_RESULT_BACKEND=
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json

# --- RabbitMQ (for fanout subscriptions) ---
RABBITMQ_URL=amqp://REPLACE_WITH_RABBITMQ_USER:REPLACE_WITH_RABBITMQ_PASSWORD@rabbitmq:5672

# --- Liveness / Anti-spoofing ---
# Passive gate threshold (worker reads at call time; restart worker after change).
LIVENESS_THRESHOLD=0.5
# Kiosk active challenge (head turn/nod, multi-frame). Set false to skip the challenge.
ENABLE_ACTIVE_LIVENESS=true
# Active-challenge verdict bands on the multi-frame average score.
ACTIVE_LIVENESS_REJECT_BELOW=0.45
ACTIVE_LIVENESS_LIVE_ABOVE=0.65
# Challenge capture settings.
ACTIVE_LIVENESS_FRAMES=3
ACTIVE_LIVENESS_INTERVAL_MS=1500
ACTIVE_LIVENESS_MAX_ATTEMPTS=3
# Minimum normalized face-center displacement (fraction of inter-ocular
# distance) proving real head motion. Static replays never go live below this.
CHALLENGE_MOTION_MIN_DISPLACEMENT=0.15

# --- Privacy / Encryption ---
# Placeholder: implement encryption-at-rest via MinIO SSE or app-level encryption later.
# For local encrypted fallback:
DATA_ENCRYPTION_KEY=REPLACE_WITH_DATA_ENCRYPTION_KEY

