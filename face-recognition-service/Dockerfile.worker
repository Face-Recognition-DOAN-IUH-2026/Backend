FROM python:3.12-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 libglib2.0-0 && \
    rm -rf /var/lib/apt/lists/*

COPY pyproject.toml .

# Upgrade pip first to avoid hash mismatch issues, then install insightface + onnxruntime
RUN pip install --default-timeout=1000 --retries 20 --upgrade pip && \
    pip install --default-timeout=1000 --retries 20 --no-cache-dir insightface onnxruntime gevent

RUN pip install --default-timeout=1000 --retries 20 --no-cache-dir poetry && \
    poetry config virtualenvs.create false && \
    poetry config installer.parallel false

ENV POETRY_REQUESTS_TIMEOUT=120

RUN for i in 1 2 3 4 5; do poetry install --only main --no-root --no-interaction --no-ansi && break || sleep 5; done

# Model files are downloaded at runtime and cached in the 'insightface_models' volume

COPY . .

CMD ["celery", "-A", "worker.celery_app", "worker", "--loglevel=info", "--concurrency=2", "--include=worker.tasks"]