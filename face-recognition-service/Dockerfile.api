FROM python:3.12-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 libglib2.0-0 curl tesseract-ocr tesseract-ocr-vie tesseract-ocr-eng && \
    rm -rf /var/lib/apt/lists/*

COPY pyproject.toml .

# Upgrade pip then install insightface + onnxruntime (needed for face login sync path)
RUN pip install --default-timeout=1000 --retries 20 --upgrade pip && \
    pip install --default-timeout=1000 --retries 20 --no-cache-dir insightface onnxruntime gevent

RUN pip install --default-timeout=1000 --retries 20 --no-cache-dir poetry && \
    poetry config virtualenvs.create false && \
    poetry config installer.parallel false

ENV POETRY_REQUESTS_TIMEOUT=120

RUN for i in 1 2 3 4 5; do poetry install --only main --no-root --no-interaction --no-ansi && break || sleep 5; done

COPY . .

EXPOSE 8000

CMD ["uvicorn", "api.app:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000"]
