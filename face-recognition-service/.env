# --- API/Worker common ---
APP_NAME=face-recognition-platform
ENV=dev
LOG_LEVEL=INFO

# --- JWT ---
JWT_ISSUER=face-recognition
JWT_AUDIENCE=face-recognition-users
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_MINUTES=15
JWT_REFRESH_EXPIRES_DAYS=30

# --- CORS ---
CORS_ORIGINS=*

# --- RBAC ---
# Roles: admin, user

# --- Redis (Celery + Cooldown) ---
REDIS_URL=redis://redis:6379/0

# --- Postgres ---
POSTGRES_URL=postgresql+psycopg://postgres:postgres@postgres:5432/face_recognition
POSTGRES_DB=face_recognition

# --- MinIO (Object Storage for encrypted raw images) ---
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=face-raw-images

# --- Milvus ---
MILVUS_HOST=milvus
MILVUS_PORT=19530
MILVUS_COLLECTION=face_embeddings

# --- Inference ---
USE_CUDA=false
MAX_IMAGE_WIDTH=1280
MAX_IMAGE_HEIGHT=1280
MAX_IMAGE_PIXELS=2073600

# --- Celery ---
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json

# --- Camera Stream (IP Webcam từ điện thoại) ---
ENTRY_CAM_URL=http://192.168.1.13:8080/video   # Camera cổng vào (camera 1)
EXIT_CAM_URL=http://192.168.1.240:8080/video    # Camera cổng ra (camera 2)
# RELAY_API_URL=http://192.168.1.200/relay/on     # Mở cổng (nếu có)

# --- Face Recognition ---
FACE_MATCH_THRESHOLD=0.6
ACCESS_COOLDOWN_SECONDS=10

# --- Privacy / Encryption ---
DATA_ENCRYPTION_KEY=change_me_32_bytes_minimum