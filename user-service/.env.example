PORT=3001
NODE_ENV=development
JWT_SECRET=your-secret-key-change-in-production
JWT_REFRESH_SECRET=your-secret-key-change-in-production
JWT_ISSUER=face-recognition
JWT_AUDIENCE=face-recognition-users
JWT_ACCESS_EXPIRES_MINUTES=15
JWT_REFRESH_EXPIRES_DAYS=30
DB_HOST=postgres
DB_PORT=5432
DB_NAME=userdb
DB_USER=postgres
DB_PASSWORD=postgres
REDIS_URL=redis://redis:6379/0
INTERNAL_API_KEY=change-me-in-production
CORS_ORIGINS=*

# Dev bootstrap admin (only used when NODE_ENV != production)
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=password123
