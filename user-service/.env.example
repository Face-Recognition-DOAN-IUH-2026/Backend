PORT=3001
NODE_ENV=development
JWT_SECRET=REPLACE_WITH_JWT_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_JWT_REFRESH_SECRET
JWT_ISSUER=face-recognition
JWT_AUDIENCE=face-recognition-users
JWT_ACCESS_EXPIRES_MINUTES=15
JWT_REFRESH_EXPIRES_DAYS=30
DB_HOST=postgres
DB_PORT=5432
DB_NAME=userdb
DB_USER=REPLACE_WITH_DB_USER
DB_PASSWORD=REPLACE_WITH_DB_PASSWORD
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=*

# Service-to-Service Authentication (uses same secret as JWT_ACCESS_SECRET)
# Used for inter-service JWT tokens - all services must share this value
SERVICE_JWT_SECRET=REPLACE_WITH_SERVICE_JWT_SECRET

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672

# Dev bootstrap admin (only used when NODE_ENV != production)
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=REPLACE_WITH_DEFAULT_ADMIN_PASSWORD

# Cloudinary (avatar upload)
CLOUDINARY_CLOUD_NAME=dajviiaqn
CLOUDINARY_API_KEY=783844815573592
CLOUDINARY_API_SECRET=6fHg5w3ExN52EszGejeCD_QP8FQ
