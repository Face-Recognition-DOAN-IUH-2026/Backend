# ============================================
# Face Recognition Platform - Shared Config
# ============================================

# --- Common ---
APP_NAME=face-recognition-platform
ENV=dev
LOG_LEVEL=INFO
NODE_ENV=development

# --- JWT (ALL services use SAME secret for compatibility) ---
JWT_ACCESS_SECRET=change-me-to-a-secure-secret
JWT_REFRESH_SECRET=change-me-to-a-secure-secret
JWT_SECRET=change-me-to-a-secure-secret
JWT_ISSUER=face-recognition
JWT_AUDIENCE=face-recognition-users
JWT_ACCESS_EXPIRES_MINUTES=15
JWT_REFRESH_EXPIRES_DAYS=30
JWT_EXPIRES_IN=24h

# --- User Service JWT (for validating user-service tokens) ---
USER_SERVICE_JWT_SECRET=change-me-to-a-secure-secret

# --- Postgres ---
POSTGRES_URL=postgresql+psycopg://postgres:postgres@postgres:5432/face_recognition
DB_HOST=postgres
DB_PORT=5432
DB_NAME=face_recognition
DB_USER=postgres
DB_PASSWORD=postgres

# --- Redis ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- MinIO ---
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=face-raw-images

# --- Milvus ---
MILVUS_HOST=milvus
MILVUS_PORT=19530
MILVUS_COLLECTION=face_embeddings

# --- Inference ---
USE_CUDA=false
MAX_IMAGE_WIDTH=1280
MAX_IMAGE_HEIGHT=1280
MAX_IMAGE_PIXELS=2073600

# --- Privacy ---
DATA_ENCRYPTION_KEY=change-me-32-bytes-minimum

# --- Service URLs (for API Gateway) ---
FACE_RECOGNITION_API=http://face-recognition-api:8000
USER_SERVICE=http://user-service:3001
BORROW_SERVICE=http://borrow-service:8000
FRONTEND_URL=http://host.docker.internal:3000

# --- Internal API Key (service-to-service) ---
INTERNAL_API_KEY=borrow-internal-secret-key-change-in-production

# --- CORS ---
CORS_ORIGINS=*

# --- Camera ---
ENTRY_CAM_ID=entry_gate
EXIT_CAM_ID=exit_gate
ENTRY_CAM_URL=http://192.168.1.13:8080/video
EXIT_CAM_URL=http://192.168.1.240:8080/video
RELAY_API_URL=
FACE_MATCH_THRESHOLD=0.6
ACCESS_COOLDOWN_SECONDS=10
MAX_ENTRY_HOURS=24
ENABLE_PERSON_DETECTION=true
MIN_FACE_SIZE=80
FRAME_PROCESS_INTERVAL=0.5
