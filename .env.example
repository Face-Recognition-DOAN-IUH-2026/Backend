# ============================================
# Face Recognition Platform - Shared Config
# ============================================

# --- Common ---
APP_NAME=face-recognition-platform
ENV=dev
LOG_LEVEL=INFO
NODE_ENV=development

# --- JWT ---
JWT_ACCESS_SECRET=REPLACE_WITH_RANDOM_32_CHARS
JWT_REFRESH_SECRET=REPLACE_WITH_RANDOM_32_CHARS
JWT_SECRET=REPLACE_WITH_RANDOM_32_CHARS
JWT_ISSUER=face-recognition
JWT_AUDIENCE=face-recognition-users
JWT_ACCESS_EXPIRES_MINUTES=15
JWT_REFRESH_EXPIRES_DAYS=30
JWT_EXPIRES_IN=24h

# --- Google Books API ---
GOOGLE_BOOKS_API_KEY=REPLACE_WITH_GOOGLE_BOOKS_KEY

# --- User Service JWT ---
USER_SERVICE_JWT_SECRET=REPLACE_WITH_RANDOM_32_CHARS

# --- Postgres ---
POSTGRES_URL=postgresql+psycopg://postgres:postgres@postgres:5432/face_recognition
DB_HOST=postgres
DB_PORT=5432
DB_NAME=face_recognition
DB_USER=postgres
DB_PASSWORD=postgres

# --- Redis ---
REDIS_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672
CELERY_RESULT_BACKEND=

# --- MinIO ---
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=face-raw-images

# --- Milvus ---
MILVUS_HOST=milvus
MILVUS_PORT=19530
MILVUS_COLLECTION=face_embeddings

# --- Inference ---
USE_CUDA=false
MAX_IMAGE_WIDTH=1280
MAX_IMAGE_HEIGHT=1280
MAX_IMAGE_PIXELS=2073600

# --- Privacy ---
DATA_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_KEY

# --- Service URLs (for API Gateway) ---
FACE_RECOGNITION_API=http://face-recognition-api:8000
USER_SERVICE=http://user-service:3001
BORROW_SERVICE=http://borrow-service:8000
FRONTEND_URL=http://host.docker.internal:3000

# --- Internal API Key (service-to-service) ---
INTERNAL_API_KEY=REPLACE_WITH_RANDOM_32_CHARS

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:19006

# --- Camera ---
ENTRY_CAM_ID=entry_gate
EXIT_CAM_ID=exit_gate
ENTRY_CAM_URL=http://192.168.1.13:8080/video
EXIT_CAM_URL=http://192.168.1.240:8080/video
NEXT_PUBLIC_BORROW_CAM_URL=http://192.168.1.13:8080/video
RELAY_API_URL=
FACE_MATCH_THRESHOLD=0.6
ACCESS_COOLDOWN_SECONDS=10
MAX_ENTRY_HOURS=24
ENABLE_PERSON_DETECTION=true
MIN_FACE_SIZE=80
FRAME_PROCESS_INTERVAL=0.5

# --- AI ---
NVIDIA_API_KEY=REPLACE_WITH_NVIDIA_KEY
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
OPENROUTER_API_KEY=REPLACE_WITH_OPENROUTER_KEY
AI_MOCK_MODE=false
OPENROUTER_MODEL=openai/gpt-oss-20b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Jira Bug Reporting ---
JIRA_ENABLED=true
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@gmail.com
JIRA_API_TOKEN=REPLACE_WITH_JIRA_API_TOKEN
JIRA_PROJECT_KEY=LIB

# --- RabbitMQ ---
# WARNING: Change default credentials in production!
# Create dedicated users per service with limited permissions
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_URL=amqp://${RABBITMQ_USER}:${RABBITMQ_PASS}@rabbitmq:5672
