  async publishUserDeleted(userId: string, email: string): Promise<void> {
    try {
      await this.client.publish(
        'user.events',
        JSON.stringify({
          event: 'USER_DELETED',
          user_id: userId,
          email,
          timestamp: new Date().toISOString(),
        }),
      );
    } catch (e) {
      console.warn('Redis publish failed, face cleanup may be delayed:', e);
