<file path="access-service/src/services/AccessService.ts">
import { Between, In, MoreThanOrEqual } from 'typeorm';
import { randomUUID } from 'crypto';
import { AppDataSource } from '../data-source';
import { AccessLog } from '../entities/AccessLog';
import { PatronAccessState } from '../entities/PatronAccessState';
import {
  AccessRealtimeEvent,
  AccessRealtimeEventSchema,
  AccessStatus,
  AccessType,
  ACTIVE_CAMERA_IDS,
  ACCESS_STATUSES,
  RecognitionEventInputSchema,
} from '../contracts';
import { UserServiceClient } from '../clients/UserServiceClient';
import { realtimeHub } from '../realtime/RealtimeHub';
import { HttpError } from '../../../shared';

const logRepo = () => AppDataSource.getRepository(AccessLog);
const stateRepo = () => AppDataSource.getRepository(PatronAccessState);
const users = new UserServiceClient();

function toIso(value: Date | string | undefined | null) {
  if (!value) return new Date().toISOString();
  return value instanceof Date ? value.toISOString() : new Date(value).toISOString();
}

function normalizeStatus(status: unknown): AccessStatus {
  if (status === 'success') return 'granted';
  if (status === 'unknown') return 'no_match';
  if (typeof status === 'string' && (ACCESS_STATUSES as readonly string[]).includes(status)) return status as AccessStatus;
  return 'error';
}

function publicStatus(log: AccessLog) {
  return log.status === 'success' ? 'granted' : log.status;
}

async function enrichLogs(logs: AccessLog[]) {
  const userMap = await users.getUsers(logs.map((log) => log.patronId || '').filter(Boolean));
  return logs.map((log) => {
    const user = log.patronId ? userMap.get(log.patronId) : null;
    return {
      id: log.id,
      patron_id: log.patronId,
      access_type: log.accessType,
      verify_method: log.verifyMethod,
      confidence: log.confidence,
      camera_id: log.cameraId,
      image_url: log.imageUrl,
      status: publicStatus(log),
      access_time: log.accessTime,
      created_at: log.accessTime,
      event_id: log.eventId,
      source: log.source,
      user: user
        ? {
            id: user.id,
            full_name: user.fullName,
            fullName: user.fullName,
            email: user.email,
            student_code: user.studentCode,
            studentCode: user.studentCode,
            card_number: user.cardNumber,
            cardNumber: user.cardNumber,
          }
        : null,
      full_name: user?.fullName || null,
      student_code: user?.studentCode || null,
    };
  });
}

export class AccessService {
  async recordRecognitionEvent(input: any): Promise<AccessRealtimeEvent> {
    const parsedInput = RecognitionEventInputSchema.parse(input || {});
    const status = normalizeStatus(parsedInput.status);
    const cameraId = String(parsedInput.camera_id || 'unknown');
    const patronId = parsedInput.patron_id ? String(parsedInput.patron_id) : null;
    let accessType = parsedInput.access_type ? String(parsedInput.access_type) as AccessType : null;
    const occurredAt = toIso(parsedInput.occurred_at);

    if (!accessType && cameraId === 'entry_gate') accessType = 'entry';
    if (!accessType && cameraId === 'exit_gate') accessType = 'exit';
    if (!accessType && cameraId === 'kiosk' && patronId) {
      const state = await stateRepo().findOne({ where: { patronId } });
      accessType = state?.currentStatus === 'inside' ? 'exit' : 'entry';
    }

    const event: AccessRealtimeEvent = {
      event_id: String(parsedInput.event_id || randomUUID()),
      event_type: 'camera_event',
      camera_id: cameraId,
      access_type: accessType,
      status,
      patron_id: patronId,
      student_code: parsedInput.student_code || null,
      full_name: parsedInput.full_name || null,
      score: typeof parsedInput.score === 'number' ? parsedInput.score : parsedInput.confidence ?? null,
      bbox: parsedInput.bbox ?? null,
      landmarks: parsedInput.landmarks ?? null,
      occurred_at: occurredAt,
      source: parsedInput.source || 'face-recognition-service',
      image_url: parsedInput.image_url || null,
    };

    const realtimeEvent = AccessRealtimeEventSchema.parse(event);

    if (status === 'granted' && patronId && accessType) {
      await logRepo().save(logRepo().create({
        id: parsedInput.log_id || undefined,
        patronId,
        accessType,
        verifyMethod: parsedInput.verify_method || 'face',
        confidence: realtimeEvent.score ?? null,
        cameraId,
        imageUrl: realtimeEvent.image_url || null,
        status: 'success',
        eventId: realtimeEvent.event_id,
        source: realtimeEvent.source,
        accessTime: new Date(occurredAt),
      }));
      await this.upsertState(patronId, accessType, cameraId, new Date(occurredAt));
    }

    await realtimeHub.publish(realtimeEvent);
    return realtimeEvent;
  }

  async getRecent(limit = 20) {
    const logs = await logRepo().find({
      where: { cameraId: In([...ACTIVE_CAMERA_IDS]) },
      order: { accessTime: 'DESC' },
      take: Math.min(limit, 100),
    });
    return enrichLogs(logs);
  }

  async getLogs(query: { patronId?: string; dateFrom?: string; dateTo?: string; limit?: number }) {
    const where: any = { cameraId: In([...ACTIVE_CAMERA_IDS]) };
    if (query.patronId) {
      where.patronId = query.patronId;
    }
    if (query.dateFrom || query.dateTo) {
      const from = query.dateFrom ? new Date(query.dateFrom) : new Date('1970-01-01T00:00:00Z');
      const to = query.dateTo ? new Date(query.dateTo) : new Date();
      where.accessTime = Between(from, to);
    }
    const logs = await logRepo().find({
      where,
      order: { accessTime: 'DESC' },
      take: Math.min(query.limit || 200, 1000),
    });
    return enrichLogs(logs);
  }

  async getActive() {
    const MAX_INSIDE_HOURS = 24;
    const states = await stateRepo().find({
      where: { currentStatus: 'inside' },
      order: { lastEntryAt: 'DESC' },
    });

    const userMap = await users.getUsers(states.map((state) => state.patronId));

    const now = Date.now();
    const results: any[] = [];
    const staleIds: string[] = [];

    for (const state of states) {
      const user = userMap.get(state.patronId);

      if (!user || user.status === 'deleted') {
        staleIds.push(state.patronId);
        continue;
      }

      const entryTime = state.lastEntryAt ? new Date(state.lastEntryAt).getTime() : 0;
      const hoursInside = (now - entryTime) / (1000 * 60 * 60);
      if (hoursInside > MAX_INSIDE_HOURS) {
        staleIds.push(state.patronId);
        continue;
      }

      if (state.lastEntryCamera && !ACTIVE_CAMERA_IDS.includes(state.lastEntryCamera as any)) {
        continue;
      }

      results.push({
        id: state.patronId,
        patron_id: state.patronId,
        full_name: user.fullName || null,
        fullName: user.fullName || null,
        email: user.email || null,
        student_code: user.studentCode || null,
        studentCode: user.studentCode || null,
        current_status: state.currentStatus,
        currentStatus: state.currentStatus,
        last_entry_at: state.lastEntryAt,
        lastEntryAt: state.lastEntryAt,
        last_entry_camera: state.lastEntryCamera,
        lastEntryCamera: state.lastEntryCamera,
      });
    }

    if (staleIds.length > 0) {
      stateRepo().update(staleIds, { currentStatus: 'outside' }).catch(err => {
        console.error('[AccessService] Stale patron cleanup failed:', err);
      });
    }

    return results;
  }

  async getFrequency(days = 7) {
    const since = new Date();
    since.setDate(since.getDate() - Math.max(1, Math.min(days, 31)));
    const rows = await logRepo()
      .createQueryBuilder('log')
      .select(`DATE_TRUNC('day', log.accessTime)`, 'date')
      .addSelect('log.accessType', 'access_type')
      .addSelect('COUNT(*)', 'count')
      .where('log.accessTime >= :since', { since })
      .andWhere('log.cameraId IN (:...cameraIds)', { cameraIds: ACTIVE_CAMERA_IDS })
      .groupBy('date')
      .addGroupBy('log.accessType')
      .orderBy('date', 'ASC')
      .getRawMany();
    return rows.map((row) => ({
      date: row.date,
      access_type: row.access_type,
      count: Number(row.count),
    }));
  }

  async getStats() {
    const today = new Date();
    today.setHours(0, 0, 0, 0);

    const activeList = await this.getActive();
    const activeCount = activeList.length;

    const entryExitCounts = await logRepo()
      .createQueryBuilder('log')
      .select('log.access_type', 'accessType')
      .addSelect('COUNT(*)', 'count')
      .where('log.access_time >= :today', { today })
      .andWhere('log.camera_id IN (:...cameraIds)', { cameraIds: ACTIVE_CAMERA_IDS })
      .groupBy('log.access_type')
      .getRawMany();

    const todayEntries = Number(entryExitCounts.find(c => c.accessType === 'entry')?.count || 0);
    const todayExits = Number(entryExitCounts.find(c => c.accessType === 'exit')?.count || 0);

    return {
      active_inside: activeCount,
      activeInside: activeCount,
      today_entries: todayEntries,
      todayEntries,
      today_exits: todayExits,
      todayExits,
      today_total: todayEntries + todayExits,
      todayTotal: todayEntries + todayExits,
    };
  }

  async getStatus(patronId: string) {
    let state = await stateRepo().findOne({ where: { patronId } });
    if (!state) {
      state = stateRepo().create({ patronId, currentStatus: 'outside', lastEntryAt: null, lastEntryCamera: null });
      await stateRepo().save(state);
    }
    return {
      patron_id: patronId,
      current_status: state.currentStatus,
      currentStatus: state.currentStatus,
      last_entry_at: state.lastEntryAt,
      lastEntryAt: state.lastEntryAt,
      last_entry_camera: state.lastEntryCamera,
      lastEntryCamera: state.lastEntryCamera,
    };
  }

  async setStatus(patronId: string, currentStatus: 'inside' | 'outside', cameraId?: string | null) {
    if (!['inside', 'outside'].includes(currentStatus)) {
      throw new HttpError(400, 'Invalid current_status');
    }
    const accessType: AccessType = currentStatus === 'inside' ? 'entry' : 'exit';
    await this.upsertState(patronId, accessType, cameraId || 'manual', new Date());
    return this.getStatus(patronId);
  }

  private async upsertState(patronId: string, accessType: AccessType, cameraId: string, at: Date) {
    let state = await stateRepo().findOne({ where: { patronId } });
    if (!state) {
      state = stateRepo().create({ patronId, currentStatus: 'outside' });
    }
    if (accessType === 'entry') {
      state.currentStatus = 'inside';
      state.lastEntryAt = at;
      state.lastEntryCamera = cameraId;
    } else {
      state.currentStatus = 'outside';
      state.lastExitAt = at;
      state.lastExitCamera = cameraId;
    }
    await stateRepo().save(state);

    const { amqpClient } = require('../clients/AmqpClient');
    amqpClient.publish('user.access.status_changed', {
      patronId,
      currentStatus: state.currentStatus,
      lastEntryAt: state.lastEntryAt ? state.lastEntryAt.toISOString() : null,
      lastEntryCamera: state.lastEntryCamera || null,
      lastExitAt: state.lastExitAt ? state.lastExitAt.toISOString() : null,
      lastExitCamera: state.lastExitCamera || null,
    }).catch((err: any) => console.error('[AMQP] Failed to publish status changed event:', err.message));
  }
}

export const accessService = new AccessService();
</file>

<file path="ai-service/src/routes/chat.ts">
import { Router, Response } from 'express';
import { sessionStore } from '../sessions';
import { processMessage } from '../agent/agent';
import { AuthRequest } from '../../../shared';

const router = Router();

/**
 * @swagger
 * tags:
 *   - name: AI Assistant
 *     description: AI chatbot powered by NVIDIA NIM — supports book search, borrow history, overdue queries, schedules, and general library assistance
 */

/**
 * @swagger
 * /ai/chat:
 *   post:
 *     summary: Send a message to the AI assistant
 *     description: |
 *       Send a natural language message to the library AI assistant. The AI can:
 *       - Search for books by title, author, or topic
 *       - Retrieve patron borrow history
 *       - Check overdue books and due dates
 *       - Look up library schedules and opening hours
 *       - Answer general library questions
 *
 *       The response includes the AI's text reply and optional `toolResults` with structured data
 *       (book cards, schedule cards, overdue cards) that the frontend should render as rich UI components.
 *
 *       **Tool Results Types:**
 *       - `book_search` — list of books matching the query
 *       - `book_lookup` — single book detail
 *       - `patron_borrows` — patron borrow history with status
 *       - `overdue_books` — overdue borrow records with fine info
 *       - `library_schedule` — current and upcoming library hours
 *     tags: [AI Assistant]
 *     security:
 *       - bearerAuth: []
 *     requestBody:
 *       required: true
 *       content:
 *         application/json:
 *           schema:
 *             type: object
 *             required:
 *               - message
 *             properties:
 *               message:
 *                 type: string
 *                 description: The user's natural language message
 *                 example: "Tìm sách về lập trình Python"
 *               sessionId:
 *                 type: string
 *                 description: Existing session ID to continue a conversation. Omit to start a new session.
 *                 example: "sess_abc123xyz"
 *               patronId:
 *                 type: string
 *                 description: (Staff only) Override the patron ID to query on behalf of a specific patron
 *                 example: "3f7a8b2c-1234-5678-abcd-ef0123456789"
 *           examples:
 *             searchBooks:
 *               summary: Search for books
 *               value:
 *                 message: "Tìm sách lập trình Python cho người mới"
 *             borrowHistory:
 *               summary: Check borrow history
 *               value:
 *                 message: "Xem lịch sử mượn sách của tôi"
 *                 sessionId: "sess_abc123xyz"
 *             overdueBooks:
 *               summary: Check overdue books
 *               value:
 *                 message: "Tôi có sách nào trễ hạn không?"
 *             schedule:
 *               summary: Check library schedule
 *               value:
 *                 message: "Lịch trực thư viện tuần này như thế nào?"
 *     responses:
 *       200:
 *         description: AI response with optional structured tool results
 *         content:
 *           application/json:
 *             schema:
 *               type: object
 *               properties:
 *                 response:
 *                   type: string
 *                   description: The AI's text response in Vietnamese
 *                   example: "Tôi tìm thấy 3 cuốn sách về Python. Đây là danh sách:"
 *                 sessionId:
 *                   type: string
 *                   description: Session ID for continuing the conversation
 *                   example: "sess_abc123xyz"
 *                 userRole:
 *                   type: string
 *                   enum:
 *                     - patron
 *                     - staff
 *                     - admin
 *                   description: Role of the authenticated user
 *                 requiresConfirmation:
 *                   type: boolean
 *                   description: True when the AI needs user confirmation before executing an action
 *                 pendingAction:
 *                   type: object
 *                   nullable: true
 *                   description: Details of the pending action requiring confirmation
 *                   properties:
 *                     action:
 *                       type: string
 *                       example: "extend_borrow"
 *                     description:
 *                       type: string
 *                       example: "Gia hạn sách 'Clean Code' thêm 7 ngày?"
 *                     params:
 *                       type: object
 *                 toolResults:
 *                   type: array
 *                   description: Structured data returned by tool calls — render as rich UI cards
 *                   items:
 *                     type: object
 *                     properties:
 *                       tool:
 *                         type: string
 *                         description: Tool identifier
 *                         enum:
 *                           - search_books
 *                           - get_book_details
 *                           - get_patron_borrows
 *                           - get_overdue_books
 *                           - get_library_schedule
 *                       result:
 *                         type: object
 *                         properties:
 *                           success:
 *                             type: boolean
 *                           data:
 *                             description: Tool-specific structured data (books array, borrow records, schedule slots, etc.)
 *             examples:
 *               bookSearch:
 *                 summary: Book search result
 *                 value:
 *                   response: "Tôi tìm thấy 2 cuốn sách về Python:"
 *                   sessionId: "sess_abc123xyz"
 *                   userRole: "patron"
 *                   requiresConfirmation: false
 *                   toolResults:
 *                     - tool: "search_books"
 *                       result:
 *                         success: true
 *                         data:
 *                           - title: "Python Crash Course"
 *                             author: "Eric Matthes"
 *                             isbn: "9781593279288"
 *                             cover_url: "https://books.google.com/..."
 *                             available: true
 *       400:
 *         description: Missing or invalid message field
 *         content:
 *           application/json:
 *             schema:
 *               $ref: '#/components/schemas/Error'
 *       401:
 *         description: Unauthorized — missing or invalid Bearer token
 *         content:
 *           application/json:
 *             schema:
 *               $ref: '#/components/schemas/Error'
 *       429:
 *         description: Rate limit exceeded — AI provider is busy
 *         content:
 *           application/json:
 *             schema:
 *               type: object
 *               properties:
 *                 error:
 *                   type: string
 *                   example: "Rate limit exceeded"
 *                 message:
 *                   type: string
 *                   example: "Hệ thống đang bận, vui lòng thử lại sau vài giây."
 *       500:
 *         description: AI service internal error
 *         content:
 *           application/json:
 *             schema:
 *               $ref: '#/components/schemas/Error'
 */
router.post('/', async (req: AuthRequest, res: Response) => {
  try {
    const { message, sessionId } = req.body as {
      message: string;
      sessionId?: string;
    };

    if (!message || typeof message !== 'string') {
      res.status(400).json({ error: 'message is required and must be a string' });
      return;
    }

    const hasImageContent =
      message.includes('data:image/') ||
      /\bdata:image\/[^;]+;base64,/i.test(message) ||
      /\bimage\/[^;\s]*/i.test(message);

    if (hasImageContent) {
      res.status(400).json({
        error: 'Image input not supported',
        message: 'Xin lỗi, tính năng này chỉ hỗ trợ tin nhắn văn bản. Không hỗ trợ gửi ảnh.',
      });
      return;
    }

    const user = req.user;
    if (!user) {
      res.status(401).json({ error: 'User not authenticated' });
      return;
    }

    const trimmedMessage = message.trim().toLowerCase();
    if (trimmedMessage === 'clipboard' || trimmedMessage === 'paste' || trimmedMessage === 'dán') {
      res.json({
        response: 'Xin lỗi, tôi không thể truy cập clipboard của bạn. Bạn vui lòng nhập nội dung trực tiếp bằng văn bản nhé.',
        requiresConfirmation: false,
        toolResults: undefined,
        sessionId: undefined,
        userRole: user.role,
      });
      return;
    }

    const effectivePatronId = user.userId;

    let session = sessionId ? sessionStore.getOwned(sessionId, effectivePatronId) : undefined;

    if (!session) {
      session = sessionStore.create(effectivePatronId);
    }

    sessionStore.addMessage(session.id, {
      role: 'user',
      content: message,
      timestamp: Date.now(),
    });

    const sessionHistory = session.messages.map(m => ({
      role: m.role,
      content: m.content,
    }));

    const userContext = {
      userId: user.userId,
      email: user.email,
      role: user.role,
      fullName: user.fullName || undefined,
    };

    const result = await processMessage(
      message,
      session.id,
      effectivePatronId,
      sessionHistory,
      userContext,
    );

    sessionStore.addMessage(session.id, {
      role: 'assistant',
      content: result.response,
      timestamp: Date.now(),
    });

    if (result.requiresConfirmation && result.pendingTool) {
      sessionStore.setConfirmation(session.id, {
        action: message,
        toolName: result.pendingTool.name,
        toolArgs: result.pendingTool.args,
        description: result.pendingTool.description,
      });
    } else if (session?.pendingConfirmation) {
      sessionStore.setConfirmation(session.id, undefined);
    }

    res.json({
      response: result.response,
      requiresConfirmation: result.requiresConfirmation,
      pendingAction: result.pendingTool ? {
        action: result.pendingTool.name,
        description: result.pendingTool.description,
        params: result.pendingTool.args,
      } : undefined,
      toolResults: result.toolResults,
      sessionId: session.id,
      userRole: user.role,
    });
  } catch (error) {
    console.error('Chat error:', error);

    const errorMessage = error instanceof Error ? error.message : 'Unknown error';
    const isRateLimit = errorMessage.includes('429') || errorMessage.includes('rate limit');
    const isBothFailed = errorMessage.includes('Both LLM providers failed');

    const userMessage = isRateLimit
      ? 'Hệ thống đang bận, vui lòng thử lại sau vài giây.'
      : isBothFailed
        ? 'Dịch vụ AI tạm thời không khả dụng, vui lòng thử lại sau.'
        : 'Đã xảy ra lỗi, vui lòng thử lại.';

    res.status(isRateLimit ? 429 : isBothFailed ? 503 : 500).json({
      error: isRateLimit ? 'Rate limit exceeded' : isBothFailed ? 'Service unavailable' : 'Internal server error',
      message: userMessage,
      details: process.env.NODE_ENV === 'development' ? errorMessage : undefined,
    });
  }
});

/**
 * @swagger
 * /ai/chat/sessions/{sessionId}:
 *   get:
 *     summary: Retrieve an AI chat session
 *     description: |
 *       Retrieve a previous AI chat session including message history and any pending confirmation state.
 *       Use this to restore conversation context after app restart or page reload.
 *     tags: [AI Assistant]
 *     security:
 *       - bearerAuth: []
 *     parameters:
 *       - in: path
 *         name: sessionId
 *         required: true
 *         schema:
 *           type: string
 *         description: "The session ID from the chat response that had a pending confirmation"
 *         example: "sess_abc123xyz"
 *     responses:
 *       200:
 *         description: Session data with message history
 *         content:
 *           application/json:
 *             schema:
 *               type: object
 *               properties:
 *                 sessionId:
 *                   type: string
 *                   example: "sess_abc123xyz"
 *                 patronId:
 *                   type: string
 *                   example: "3f7a8b2c-1234-5678-abcd-ef0123456789"
 *                 messages:
 *                   type: array
 *                   items:
 *                     type: object
 *                     properties:
 *                       role:
 *                         type: string
 *                         enum:
 *                           - user
 *                           - assistant
 *                       content:
 *                         type: string
 *                       timestamp:
 *                         type: number
 *                         description: Unix timestamp in milliseconds
 *                 pendingConfirmation:
 *                   type: object
 *                   nullable: true
 *                   description: Pending action requiring user confirmation, or null
 *       401:
 *         description: Unauthorized
 *         content:
 *           application/json:
 *             schema:
 *               $ref: '#/components/schemas/Error'
 *       404:
 *         description: Session not found or expired
 *         content:
 *           application/json:
 *             schema:
 *               $ref: '#/components/schemas/Error'
 */
router.get('/sessions/:sessionId', (req: AuthRequest, res: Response) => {
  const { sessionId } = req.params;
  const user = req.user;

  if (!user) {
    res.status(401).json({ error: 'User not authenticated' });
    return;
  }

  const isStaff = user.role === 'admin' || user.role === 'staff';
  const patronId = isStaff ? undefined : user.userId;

  const session = patronId
    ? sessionStore.getOwned(sessionId, patronId)
    : sessionStore.get(sessionId);

  if (!session) {
    res.status(404).json({ error: 'Session not found' });
    return;
  }

  res.json({
    sessionId: session.id,
    patronId: session.patronId,
    messages: session.messages,
    pendingConfirmation: session.pendingConfirmation,
  });
});

export default router;
</file>

