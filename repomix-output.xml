router.post('/correct-email/request-otp', (req, res) => authController.requestEmailCorrection(req, res));

/**
 * @swagger
 * /auth/correct-email/verify:
 *   post:
 *     summary: Verify OTP and change email for unverified account
 *     tags: [Auth]
 *     requestBody:
 *       required: true
 *       content:
 *         application/json:
 *           schema:
