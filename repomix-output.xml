import { createProxyMiddleware } from 'http-proxy-middleware';
import { config } from './config';

export const setupProxy = (app: any) => {
  // Auth proxy - user-service handles email/password auth
  app.use('/auth', createProxyMiddleware({
    target: config.services.userService,
    changeOrigin: true,
    pathRewrite: (path: string, req: any) => {
      const originalPath = req.originalUrl || req.url;
      return originalPath;
    },
  }));

  // User Service proxy - use originalUrl to preserve full path
  app.use('/users', createProxyMiddleware({
    target: config.services.userService,
    changeOrigin: true,
    pathRewrite: (path: string, req: any) => {
      // Use originalUrl which has the full path before Express strips mount point
      const originalPath = req.originalUrl || req.url;
      return originalPath;
    },
  }));

  // Borrow Service proxy - must be before /api to catch /api/borrow first
  app.use('/api/borrow', createProxyMiddleware({
    target: config.services.borrowService,
    changeOrigin: true,
    pathRewrite: (path: string, req: any) => {
      const originalUrl = req.originalUrl || req.url;
      return originalUrl.replace(/^\/api\/borrow/, '/borrow');
    },
  }));

  // Notification Service proxy
  app.use('/notifications', createProxyMiddleware({
    target: config.services.notificationService,
    changeOrigin: true,
    pathRewrite: (path: string, req: any) => {
      const originalPath = req.originalUrl || req.url;
      return originalPath;
    },
  }));

  // Notification Service proxy (with /api prefix for web frontend)
  app.use('/api/notifications', createProxyMiddleware({
    target: config.services.notificationService,
    changeOrigin: true,
    pathRewrite: (path: string, req: any) => {
      const originalPath = req.originalUrl || req.url;
      return originalPath.replace(/^\/api/, '');
    },
  }));

  // Automation Service proxy
  app.use('/automation', createProxyMiddleware({
    target: config.services.automationService,
    changeOrigin: true,
    pathRewrite: (path: string, req: any) => {
      const originalPath = req.originalUrl || req.url;
      return originalPath;
    },
  }));

  // User Service proxy for /api/users
  app.use('/api/users', createProxyMiddleware({
    target: config.services.userService,
    changeOrigin: true,
    pathRewrite: (path: string, req: any) => {
      const originalPath = req.originalUrl || req.url;
      return originalPath.replace(/^\/api\/users/, '/users');
    },
  }));

  // Auth proxy for /api/auth (login, register, forgot-password, etc.)
  app.use('/api/auth', createProxyMiddleware({
    target: config.services.userService,
    changeOrigin: true,
    pathRewrite: (path: string, req: any) => {
      const originalPath = req.originalUrl || req.url;
      return originalPath.replace(/^\/api\/auth/, '/auth');
    },
  }));

  // Face API proxy
  app.use('/api', createProxyMiddleware({
    target: config.services.faceRecognitionApi,
    changeOrigin: true,
    pathRewrite: (path: string, req: any) => {
      const originalPath = req.originalUrl || req.url;
      // Strip /api prefix and use the rest
      const newPath = originalPath.replace(/^\/api/, '') || '/';
      return newPath;
    },
  }));

  app.use('/docs', createProxyMiddleware({
    target: config.services.faceRecognitionApi,
    changeOrigin: true,
  }));

  app.use('/openapi.json', createProxyMiddleware({
    target: config.services.faceRecognitionApi,
    changeOrigin: true,
  }));

  app.use('/redoc', createProxyMiddleware({
    target: config.services.faceRecognitionApi,
    changeOrigin: true,
  }));

  app.get('/healthz', (req: any, res: any) => {
    res.json({ status: 'ok', gateway: 'Node.js-API-Gateway', timestamp: new Date().toISOString() });
  });

  app.get('/', (req: any, res: any) => {
    res.json({
      name: 'Face Recognition Platform API Gateway',
      version: '1.0.0',
      gateway: 'Node.js',
    });
  });
};
