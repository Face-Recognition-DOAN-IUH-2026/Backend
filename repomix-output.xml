 *         schema:
 *           type: integer
 *           default: 7
 *     responses:
 *       200:
 *         description: Access frequency data
 */
router.get('/frequency', auth, requireRole(['admin', 'staff']), async (req, res, next) => {
  try {
    res.json(await accessService.getFrequency(Number(req.query.days || 7)));
  } catch (error) {
    next(error);
  }
});

/**
