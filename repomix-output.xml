import { Router, Response, NextFunction } from 'express';
import { z } from 'zod';
import { scheduleService } from '../services/ScheduleService';
import { AuthRequest, auth } from '../middlewares/auth';
import { requireRole } from '../middlewares/requireRole';

const router = Router();

