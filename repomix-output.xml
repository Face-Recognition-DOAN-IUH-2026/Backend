<file path="user-service/src/services/AuthService.ts">
import bcrypt from 'bcryptjs';
import jwt from 'jsonwebtoken';
import { User, UserRole } from '../entities/User.entity';
import { UserRepository } from '../repositories/UserRepository';
import { RedisService } from './RedisService';
import { config } from '../config';
import {
  RegisterDto,
  LoginDto,
  AuthResponse,
  TokenPayload,
  UserPublicDto,
} from '../dto';
import { UnauthorizedError, ForbiddenError, ConflictError } from '../errors';

export class AuthService {
  constructor(
    private userRepo: UserRepository,
    private redis: RedisService,
  ) {}

  async register(dto: RegisterDto): Promise<AuthResponse> {
    const existing = await this.userRepo.findByEmail(dto.email);
    if (existing) throw new ConflictError('Email already registered');

    const DEFAULT_PASSWORD = '11111111';
    const useAutoPassword = !dto.password;
    const passwordToHash = dto.password ?? DEFAULT_PASSWORD;
    const passwordHash = await bcrypt.hash(passwordToHash, 10);

    const userData: Partial<User> = {
      email: dto.email,
      passwordHash,
      fullName: dto.fullName ?? null,
      role: dto.role ?? 'user',
      passwordAutoGenerated: useAutoPassword,
    };

    if (dto.role === UserRole.PATRON) {
      const dupCode = dto.studentCode
        ? await this.userRepo.findByStudentCode(dto.studentCode)
        : null;
      if (dupCode) throw new ConflictError('Student code already exists');

      Object.assign(userData, {
        studentCode: dto.studentCode ?? null,
        className: dto.className ?? null,
        cardNumber: dto.studentCode ? `THV-${dto.studentCode}` : null,
        membershipExpiry: dto.membershipExpiry ?? '2099-12-31',
        issueDate: new Date().toISOString().split('T')[0],
      });
    }

    const user = await this.userRepo.create(userData);
    return this.buildAuthResponse(user);
  }

  async login(dto: LoginDto): Promise<AuthResponse> {
    let user: User | null = null;

    if (dto.studentCode) {
      user = await this.userRepo.findByStudentCode(dto.studentCode);
    } else if (dto.email) {
      user = await this.userRepo.findByEmail(dto.email);
    }

    if (!user) throw new UnauthorizedError('Invalid credentials');

    const valid = await bcrypt.compare(dto.password, user.passwordHash);
    if (!valid) throw new UnauthorizedError('Invalid credentials');

    if (user.status !== 'active') throw new ForbiddenError('Account is disabled');

    if (user.role === UserRole.PATRON && user.membershipExpiry) {
      const expiry = new Date(user.membershipExpiry);
      if (expiry < new Date()) throw new ForbiddenError('Membership has expired');
    }

    return this.buildAuthResponse(user);
  }

  async getUserById(id: string): Promise<UserPublicDto> {
    const user = await this.userRepo.findById(id);
    if (!user) throw new UnauthorizedError('User not found');
    return this.toPublic(user);
  }

  async refreshToken(refreshTokenStr: string): Promise<{ access_token: string; token_type: string }> {
    const payload = this.verifyToken(refreshTokenStr, 'refresh');
    const user = await this.userRepo.findById(payload.userId);
    if (!user) throw new UnauthorizedError('User not found');
    const accessToken = this.generateToken(
      { userId: user.id, email: user.email, role: user.role, fullName: user.fullName },
      'access',
    );
    return { access_token: accessToken, token_type: 'bearer' };
  }

  verifyToken(token: string, expectedType?: 'access' | 'refresh'): TokenPayload {
    let secret = expectedType === 'refresh' ? config.jwtRefreshSecret : config.jwtSecret;
    try {
      const decoded: any = jwt.verify(token, secret);
      if (expectedType && decoded.typ !== expectedType) {
        throw new Error(`Invalid token type: expected ${expectedType}`);
      }
      return {
        userId: decoded.sub,
        email: decoded.email || '',
        role: decoded.roles?.[0] || 'user',
        fullName: decoded.full_name || null,
      };
    } catch (err: any) {
      if (err.message?.includes('Invalid token type')) throw err;
      secret = config.jwtRefreshSecret;
      const decoded: any = jwt.verify(token, secret);
      if (expectedType && decoded.typ !== expectedType) {
        throw new Error(`Invalid token type: expected ${expectedType}`);
      }
      return {
        userId: decoded.sub,
        email: decoded.email || '',
        role: decoded.roles?.[0] || 'user',
        fullName: decoded.full_name || null,
      };
    }
  }

  private buildAuthResponse(user: User): AuthResponse {
    const payload: TokenPayload = {
      userId: user.id,
      email: user.email,
      role: user.role,
      fullName: user.fullName,
    };
    return {
      access_token: this.generateToken(payload, 'access'),
      refresh_token: this.generateToken(payload, 'refresh'),
      token_type: 'bearer',
      user: this.toPublic(user),
    };
  }

  private generateToken(payload: TokenPayload, type: 'access' | 'refresh'): string {
    const now = Math.floor(Date.now() / 1000);
    const exp =
      type === 'refresh'
        ? now + config.jwtRefreshExpiresDays * 86400
        : now + config.jwtAccessExpiresMinutes * 60;
    const secret = type === 'refresh' ? config.jwtRefreshSecret : config.jwtSecret;

    const jwtPayload: Record<string, any> = {
      sub: payload.userId,
      email: payload.email,
      iss: config.jwtIssuer,
      aud: config.jwtAudience,
      exp,
      iat: now,
      roles: [payload.role],
      typ: type,
    };
    if (payload.fullName) jwtPayload.full_name = payload.fullName;

    return jwt.sign(jwtPayload, secret);
  }

  toPublic(user: User): UserPublicDto {
    const dto: UserPublicDto = {
      id: user.id,
      email: user.email,
      fullName: user.fullName,
      role: user.role,
    };
    if (user.studentCode) dto.studentCode = user.studentCode;
    if (user.className) dto.className = user.className;
    if (user.identityNumber) dto.identityNumber = user.identityNumber;
    if (user.phone) dto.phone = user.phone;
    if (user.cardNumber) dto.cardNumber = user.cardNumber;
    if (user.issueDate) dto.issueDate = user.issueDate;
    if (user.membershipExpiry) dto.membershipExpiry = user.membershipExpiry;
    dto.status = user.status;
    dto.currentStatus = user.currentStatus;
    if (user.createdAt) dto.createdAt = user.createdAt.toISOString();
    if (user.updatedAt) dto.updatedAt = user.updatedAt.toISOString();
    return dto;
  }
}
</file>

<file path="user-service/src/services/PatronService.ts">
import bcrypt from 'bcryptjs';
import { PatronRepository } from '../repositories/PatronRepository';
import { RedisService } from './RedisService';
import {
  PatronPublicDto,
  CreatePatronDto,
  UpdatePatronDto,
  LookupResultDto,
  SearchResultDto,
} from '../dto';
import { ConflictError, NotFoundError } from '../errors';

export class PatronService {
  constructor(
    private patronRepo: PatronRepository,
    private redis: RedisService,
  ) {}

  async search(
    query?: string,
    status?: string,
    skip = 0,
    limit = 20,
  ): Promise<SearchResultDto> {
    const [patrons, total] = await this.patronRepo.findPatrons({
      query,
      status,
      skip,
      limit,
    });
    return {
      items: patrons.map((p) => this.toPatronPublic(p)),
      total,
    };
  }

  async lookup(
    studentCode?: string,
    cardNumber?: string,
  ): Promise<LookupResultDto> {
    let patron = studentCode
      ? await this.patronRepo.findByStudentCode(studentCode)
      : cardNumber
        ? await this.patronRepo.findByCardNumber(cardNumber)
        : null;

    if (!patron) {
      return { exists: false, patron: null, hasFace: false, isExpired: false };
    }

    const isExpired =
      !!patron.membershipExpiry && new Date(patron.membershipExpiry) < new Date();

    return {
      exists: true,
      patron: this.toPatronPublic(patron),
      hasFace: false,
      isExpired,
    };
  }

  async getById(id: string): Promise<PatronPublicDto> {
    const patron = await this.patronRepo.findById(id);
    if (!patron) throw new NotFoundError('Patron not found');
    return this.toPatronPublic(patron);
  }

  async create(dto: CreatePatronDto): Promise<PatronPublicDto> {
    const dupCode = await this.patronRepo.findByStudentCode(dto.studentCode);
    if (dupCode) throw new ConflictError('Student code already exists');

    const dupCard = await this.patronRepo.findByCardNumber(
      `THV-${dto.studentCode}`,
    );
    if (dupCard) throw new ConflictError('Student code already exists');

    const DEFAULT_PASSWORD = '11111111';
    const passwordHash = await bcrypt.hash(DEFAULT_PASSWORD, 10);

    const patron = await this.patronRepo.create({
      email: dto.email ?? `${dto.studentCode}@library.local`,
      passwordHash,
      fullName: dto.fullName,
      role: 'patron',
      studentCode: dto.studentCode,
      className: dto.className ?? null,
      cardNumber: `THV-${dto.studentCode}`,
      membershipExpiry: dto.membershipExpiry,
      issueDate: dto.issueDate ?? new Date().toISOString().split('T')[0],
      phone: dto.phone ?? null,
      status: 'active',
      currentStatus: 'outside',
      passwordAutoGenerated: true,
    });

    return this.toPatronPublic(patron);
  }

  async update(id: string, dto: UpdatePatronDto): Promise<PatronPublicDto> {
    const patron = await this.patronRepo.findById(id);
    if (!patron) throw new NotFoundError('Patron not found');

    const updated = await this.patronRepo.update(id, {
      fullName: dto.fullName,
      className: dto.className,
      identityNumber: dto.identityNumber,
      email: dto.email,
      phone: dto.phone,
      membershipExpiry: dto.membershipExpiry,
      status: dto.status as any,
    });

    return this.toPatronPublic(updated!);
  }

  async deletePatron(id: string): Promise<{ deleted: boolean; id: string }> {
    const patron = await this.patronRepo.findById(id);
    if (!patron) throw new NotFoundError('Patron not found');

    await this.patronRepo.deleteFacesByUserId(id);
    await this.patronRepo.deleteAccessLogsByUserId(id);
    await this.patronRepo.delete(id);
    await this.redis.publishUserDeleted(id, patron.email);

    return { deleted: true, id };
  }

  async changePassword(id: string, currentPassword: string | null, newPassword: string): Promise<void> {
    const patron = await this.patronRepo.findById(id);
    if (!patron) throw new NotFoundError('Patron not found');

    if (!patron.passwordAutoGenerated) {
      if (!currentPassword) {
        throw new Error('Current password is required');
      }
      const isValid = await bcrypt.compare(currentPassword, patron.passwordHash);
      if (!isValid) throw new Error('Current password is incorrect');
    }

    const newHash = await bcrypt.hash(newPassword, 10);
    await this.patronRepo.update(id, {
      passwordHash: newHash,
      passwordAutoGenerated: false,
    });
  }

  async getStats(): Promise<{
    totalPatrons: number;
    activePatrons: number;
    todayEntries: number;
    todayExits: number;
  }> {
    const totalPatrons = await this.patronRepo.countActivePatrons();
    const activePatrons = await this.patronRepo.countActiveInside();
    return { totalPatrons, activePatrons, todayEntries: 0, todayExits: 0 };
  }

  async getActivePatrons(): Promise<PatronPublicDto[]> {
    const patrons = await this.patronRepo.getActivePatrons();
    return patrons.map((p) => this.toPatronPublic(p));
  }

  private toPatronPublic(patron: any): PatronPublicDto {
    return {
      id: patron.id,
      fullName: patron.fullName,
      studentCode: patron.studentCode,
      className: patron.className,
      identityNumber: patron.identityNumber,
      email: patron.email,
      phone: patron.phone,
      cardNumber: patron.cardNumber,
      issueDate: patron.issueDate,
      membershipExpiry: patron.membershipExpiry,
      status: patron.status,
      currentStatus: patron.currentStatus,
      createdAt: patron.createdAt,
      updatedAt: patron.updatedAt,
      hasFace: false,
      passwordAutoGenerated: patron.passwordAutoGenerated ?? true,
    };
  }
}
</file>

