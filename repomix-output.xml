<file path="borrow-service/src/routes/waitlist.routes.ts">
import { Router } from 'express';
import { z } from 'zod';
import { auth, AuthRequest, requireRole } from '../middlewares/auth';
import { WaitlistService } from '../services/WaitlistService';

const router = Router();
router.use(auth);
const waitlistService = new WaitlistService();

function patronIdFrom(user: AuthRequest['user']) {
  if (!user?.id) throw Object.assign(new Error('Invalid or expired token'), { statusCode: 401 });
  return user.id;
}

router.post('/', requireRole(['patron', 'admin', 'staff'], 'Chỉ độc giả, admin, nhân viên mới vào danh sách chờ'), async (req: AuthRequest, res, next) => {
  try {
    const body = z.object({ book_id: z.string().uuid() }).parse(req.body);
    const userId = patronIdFrom(req.user);
    const entry = await waitlistService.joinWaitlist(body.book_id, userId);
    res.status(201).json(entry);
  } catch (error: any) {
    if (error.statusCode === 409) {
      res.status(409).json({ detail: error.message });
      return;
    }
    if (error.statusCode === 404) {
      res.status(404).json({ detail: error.message });
      return;
    }
    next(error);
  }
});

router.delete('/:id', requireRole(['patron', 'admin', 'staff'], 'Chỉ độc giả, admin, nhân viên mới hủy danh sách chờ'), async (req: AuthRequest, res, next) => {
  try {
    const userId = patronIdFrom(req.user);
    await waitlistService.cancelWaitlist(req.params.id, userId);
    res.status(204).end();
  } catch (error: any) {
    if (error.statusCode === 403) {
      res.status(403).json({ detail: error.message });
      return;
    }
    if (error.statusCode === 404) {
      res.status(404).json({ detail: error.message });
      return;
    }
    next(error);
  }
});

router.get('/', async (req: AuthRequest, res, next) => {
  try {
    const userId = patronIdFrom(req.user);
    const result = await waitlistService.listWaitlist(userId);
    res.json(result);
  } catch (error) {
    next(error);
  }
});

export default router;
</file>

<file path="borrow-service/src/services/BookService.ts">
import ExcelJS from 'exceljs';
import { BorrowRepository } from '../repositories/BorrowRepository';
import { HttpError } from '../middlewares/errorHandler';
import { serializeBookWithStats, serializeCopy } from './serializers';
import { fetchGoogleBooks } from '../clients/GoogleBooksClient';

export class BookService {
  private repo: BorrowRepository;

  constructor() {
    this.repo = new BorrowRepository();
  }

  async getOrCreateByIsbn(isbn: string) {
    let book = await this.repo.getBookByIsbn(isbn.trim());
    if (!book) {
      const meta = await fetchGoogleBooks(isbn);
      if (!meta) throw new HttpError(404, 'Khong tim thay sach');
      book = await this.repo.createBook(isbn, meta.title, meta.author, meta.coverUrl, undefined, {
        subtitle: meta.subtitle,
        publisher: meta.publisher,
        publishedDate: meta.publishedDate,
        description: meta.description,
        pageCount: meta.pageCount,
        categories: meta.categories,
        averageRating: meta.averageRating,
        language: meta.language,
        isbn10: meta.isbn10,
        isbn13: meta.isbn13,
      });
    }
    const total = await this.repo.countCopies(book.id);
    const available = await this.repo.countCopies(book.id, true);
    return serializeBookWithStats(book, total, available);
  }

  async listBooks(skip: number = 0, limit: number = 20, search?: string) {
    const { items, total, stats } = await this.repo.listBooks(skip, limit, search);
    const aggregateStats = await this.repo.getAggregateStats();
    return {
      items: items.map((book) => {
        const stat = stats.get(book.id) || { total: 0, available: 0 };
        return serializeBookWithStats(book, stat.total, stat.available);
      }),
      total,
      skip,
      limit,
      aggregateStats,
    };
  }

  async searchBooks(query: string) {
    const { items, stats } = await this.repo.listBooks(0, 20, query);
    return items.map((book) => {
      const stat = stats.get(book.id) || { total: 0, available: 0 };
      return serializeBookWithStats(book, stat.total, stat.available);
    });
  }

  async getBookById(bookId: string) {
    const book = await this.repo.getBookById(bookId);
    if (!book) throw new HttpError(404, 'Sách không tồn tại');
    const total = await this.repo.countCopies(book.id);
    const available = await this.repo.countCopies(book.id, true);
    return serializeBookWithStats(book, total, available);
  }

  async updateBook(bookId: string, fields: Record<string, any>) {
    const book = await this.repo.getBookById(bookId);
    if (!book) throw new HttpError(404, 'Khong tim thay sach');
    
    const updateFields: Record<string, any> = {};
    if (fields.title !== undefined) updateFields.title = fields.title;
    if (fields.subtitle !== undefined) updateFields.subtitle = fields.subtitle;
    if (fields.author !== undefined) updateFields.author = fields.author;
    if (fields.publisher !== undefined) updateFields.publisher = fields.publisher;
    if (fields.published_date !== undefined) updateFields.publishedDate = fields.published_date;
    if (fields.description !== undefined) updateFields.description = fields.description;
    if (fields.page_count !== undefined) updateFields.pageCount = fields.page_count;
    if (fields.categories !== undefined) updateFields.categories = fields.categories;
    if (fields.average_rating !== undefined) updateFields.averageRating = fields.average_rating;
    if (fields.language !== undefined) updateFields.language = fields.language;
    if (fields.shelf_location !== undefined) updateFields.shelfLocation = fields.shelf_location;
    if (fields.cover_url !== undefined) updateFields.coverUrl = fields.cover_url;
    
    const updated = await this.repo.updateBook(book.id, updateFields);
    if (!updated) throw new HttpError(500, 'Cập nhật sách thất bại');
    
    const total = await this.repo.countCopies(book.id);
    const available = await this.repo.countCopies(book.id, true);
    return serializeBookWithStats(updated, total, available);
  }

  async adjustQuantity(bookId: string, quantity: number) {
    const book = await this.repo.getBookById(bookId);
    if (!book) throw new HttpError(404, 'Khong tim thay sach');
    
    const total = await this.repo.countCopies(book.id);
    const available = await this.repo.countCopies(book.id, true);
    const borrowed = total - available;
    
    if (quantity < 1) throw new HttpError(400, 'So luong phai lon hon 0');
    if (quantity < borrowed) throw new HttpError(400, `Chi co the giam xuong toi thieu ${borrowed} ban (${borrowed} ban dang duoc muon)`);
    
    if (quantity > total) {
      const offset = await this.repo.getMaxBarcodeNumberForBook(book);
      const barcodes = Array.from({ length: quantity - total }, (_, i) => `LIB-${book.isbn}-${String(offset + i + 1).padStart(3, '0')}`);
      await this.repo.createCopiesBatchWithSkip(book.id, barcodes, book.shelfLocation);
    } else if (quantity < total) {
      const copies = await this.repo.getAvailableCopiesByBarcodeDesc(book.id);
      await this.repo.deleteCopies(copies.slice(0, total - quantity));
    }
    
    const nextTotal = await this.repo.countCopies(book.id);
    const nextAvailable = await this.repo.countCopies(book.id, true);
    return serializeBookWithStats(book, nextTotal, nextAvailable);
  }

  async bulkDeleteBooks(bookIds: string[]) {
    if (bookIds.length > 50) throw new HttpError(400, 'Toi da 50 sach mot lan');
    const result = await this.repo.bulkDeleteBooks(bookIds);
    return { ...result, success: result.deleted > 0 && result.errors.length === 0 };
  }

  async listBarcodes(bookId?: string, availableOnly: boolean = false) {
    const qb = this.repo.copies.createQueryBuilder('copy').orderBy('copy.createdAt', 'DESC').limit(200);
    if (bookId) qb.andWhere('copy.bookId = :bookId', { bookId });
    if (availableOnly) qb.andWhere('copy.isAvailable = true');
    const copies = await qb.getMany();
    return copies.map(serializeCopy);
  }

  async exportBooks() {
    const MAX_EXPORT = 10000;
    const { items } = await this.repo.listBooks(0, MAX_EXPORT);
    
    const wb = new ExcelJS.Workbook();
    const ws = wb.addWorksheet('Books');
    ws.addRow(['ISBN', 'Title', 'Author', 'Total Copies', 'Available Copies', 'Shelf Location', 'Created At']);

    const bookIds = items.map(b => b.id);
    const copyCounts = await this.repo.getCopyCountsByBookIds(bookIds);

    for (const book of items) {
      const counts = copyCounts.get(book.id) || { total: 0, available: 0 };
      ws.addRow([book.isbn, book.title, book.author || '', counts.total, counts.available, book.shelfLocation || '', book.createdAt?.toISOString?.() || '']);
    }
    
    return { workbook: wb, filename: 'books_export.xlsx' };
  }

  async getTemplate() {
    const wb = new ExcelJS.Workbook();
    const ws = wb.addWorksheet('Books Import');
    ws.addRow(['ISBN', 'Quantity']);
    ws.addRow(['9780544003415', 2]);
    ws.addRow(['9780439708180', 3]);
    return { workbook: wb, filename: 'book_import_template.xlsx' };
  }
}
</file>

<file path="borrow-service/src/services/ConfigService.ts">
import { AppDataSource } from '../data-source';
import { SystemConfig } from '../entities/SystemConfig';
import { config as envConfig } from '../config';
import { publishEvent } from '../utils/eventPublisher';
import type { FineBracket } from '../utils/fineCalculator';

const repo = () => AppDataSource.getRepository(SystemConfig);

export interface BorrowLimits {
  maxBorrowDays: number;
  maxBorrowBooks: number;
  maxBorrowBooksPerSlip: number;
  maxRenewals: number;
}

export interface FineConfig {
  fineBrackets: FineBracket[];
  finePerDay: number;
}

let cachedBorrowLimits: BorrowLimits | null = null;
let cachedFineConfig: FineConfig | null = null;
let lastBorrowCacheTime = 0;
let lastFineCacheTime = 0;
const CACHE_TTL_MS = 60 * 1000; // 1 minute

export function invalidateConfigCache() {
  cachedBorrowLimits = null;
  cachedFineConfig = null;
  lastBorrowCacheTime = 0;
  lastFineCacheTime = 0;
}

export class ConfigService {
  async getAll(): Promise<Record<string, SystemConfigEntry[]>> {
    const configs = await repo().find({ order: { category: 'ASC', configKey: 'ASC' } });
    const grouped: Record<string, SystemConfigEntry[]> = {};
    for (const c of configs) {
      if (!grouped[c.category]) grouped[c.category] = [];
      grouped[c.category].push({
        id: c.id,
        category: c.category,
        config_key: c.configKey,
        config_value: c.isEncrypted ? '••••••••' : c.configValue,
        label: c.label,
        description: c.description,
        is_encrypted: c.isEncrypted,
        updated_at: c.updatedAt.toISOString(),
        updated_by: c.updatedBy,
      });
    }
    return grouped;
  }

  async getByCategory(category: string): Promise<SystemConfigEntry[]> {
    const configs = await repo().find({
      where: { category },
      order: { configKey: 'ASC' },
    });
    if (configs.length === 0) throw new NotFoundError(`Category "${category}" not found`);
    return configs.map((c) => ({
      id: c.id,
      category: c.category,
      config_key: c.configKey,
      config_value: c.isEncrypted ? '••••••••' : c.configValue,
      label: c.label,
      description: c.description,
      is_encrypted: c.isEncrypted,
      updated_at: c.updatedAt.toISOString(),
      updated_by: c.updatedBy,
    }));
  }

  async updateCategory(
    category: string,
    values: Record<string, any>,
    updatedBy: string | null,
  ): Promise<SystemConfigEntry[]> {
    const configs = await repo().find({ where: { category } });
    if (configs.length === 0) throw new NotFoundError(`Category "${category}" not found`);

    for (const config of configs) {
      if (config.configKey in values) {
        const newValue = values[config.configKey];
        if (config.isEncrypted && newValue === '••••••••') continue;
        config.configValue = newValue;
        config.updatedBy = updatedBy;
        config.updatedAt = new Date();
      }
    }
    await repo().save(configs);

    // Invalidate local in-memory cache immediately so next calls get latest DB values
    invalidateConfigCache();

    // Broadcast config update event over AMQP for other services (e.g. notification-service, automation-service)
    try {
      await publishEvent('config.updated', {
        category,
        values,
        updatedBy,
        timestamp: new Date().toISOString(),
      });
      await publishEvent('system.config.updated', {
        category,
        keys: Object.keys(values),
        values,
        updatedBy,
        timestamp: new Date().toISOString(),
      });
    } catch (err: any) {
      console.warn('[ConfigService] Failed to broadcast config update event:', err.message);
    }

    return configs.map((c) => ({
      id: c.id,
      category: c.category,
      config_key: c.configKey,
      config_value: c.isEncrypted ? '••••••••' : c.configValue,
      label: c.label,
      description: c.description,
      is_encrypted: c.isEncrypted,
      updated_at: c.updatedAt.toISOString(),
      updated_by: c.updatedBy,
    }));
  }

  async getBorrowLimits(): Promise<BorrowLimits> {
    const now = Date.now();
    if (cachedBorrowLimits && now - lastBorrowCacheTime < CACHE_TTL_MS) {
      return cachedBorrowLimits;
    }

    try {
      const configs = await repo().find({ where: { category: 'borrow' } });
      const map: Record<string, any> = {};
      for (const c of configs) {
        map[c.configKey] = c.configValue;
      }

      cachedBorrowLimits = {
        maxBorrowDays: map['max_borrow_days'] !== undefined ? Number(map['max_borrow_days']) : envConfig.maxBorrowDays,
        maxBorrowBooks: map['max_borrow_books'] !== undefined ? Number(map['max_borrow_books']) : envConfig.maxBorrowBooks,
        maxBorrowBooksPerSlip: map['max_borrow_books_per_slip'] !== undefined ? Number(map['max_borrow_books_per_slip']) : envConfig.maxBorrowBooksPerSlip,
        maxRenewals: map['max_renewals'] !== undefined ? Number(map['max_renewals']) : envConfig.maxRenewals,
      };
      lastBorrowCacheTime = now;
      return cachedBorrowLimits;
    } catch (err: any) {
      console.warn('[ConfigService] Failed to read borrow limits from DB, falling back to envConfig:', err.message);
      return {
        maxBorrowDays: envConfig.maxBorrowDays,
        maxBorrowBooks: envConfig.maxBorrowBooks,
        maxBorrowBooksPerSlip: envConfig.maxBorrowBooksPerSlip,
        maxRenewals: envConfig.maxRenewals,
      };
    }
  }

  async getFineConfig(): Promise<FineConfig> {
    const now = Date.now();
    if (cachedFineConfig && now - lastFineCacheTime < CACHE_TTL_MS) {
      return cachedFineConfig;
    }

    try {
      const configs = await repo().find({ where: { category: 'fine' } });
      const map: Record<string, any> = {};
      for (const c of configs) {
        map[c.configKey] = c.configValue;
      }

      let brackets = map['fine_brackets'];
      if (typeof brackets === 'string') {
        try {
          brackets = JSON.parse(brackets);
        } catch {
          // ignore parse error
        }
      }

      cachedFineConfig = {
        fineBrackets: Array.isArray(brackets) ? brackets : [],
        finePerDay: map['fine_per_day'] !== undefined ? Number(map['fine_per_day']) : envConfig.finePerDay,
      };
      lastFineCacheTime = now;
      return cachedFineConfig;
    } catch (err: any) {
      console.warn('[ConfigService] Failed to read fine config from DB, falling back to defaults:', err.message);
      return {
        fineBrackets: [],
        finePerDay: envConfig.finePerDay,
      };
    }
  }

  async testEmail(config: {
    to: string;
    host: string;
    port: number;
    secure: boolean;
    user: string;
    pass: string;
    from: string;
  }): Promise<{ success: boolean; message: string }> {
    const nodemailer = await import('nodemailer');
    const transporter = nodemailer.default.createTransport({
      host: config.host,
      port: config.port,
      secure: config.secure,
      auth: { user: config.user, pass: config.pass },
      connectionTimeout: 5000,
      greetingTimeout: 5000,
    });
    try {
      await transporter.verify();
      await transporter.sendMail({
        from: config.from,
        to: config.to,
        subject: '[ThuVienIUH] Test kết nối SMTP',
        text: 'Cấu hình email SMTP đã hoạt động thành công!',
      });
      return { success: true, message: 'Gửi email test thành công' };
    } catch (err: any) {
      return { success: false, message: err?.message || 'Không thể gửi email test' };
    }
  }
}

