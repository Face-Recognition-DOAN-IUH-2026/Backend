<file path="borrow-service/src/clients/GoogleBooksClient.ts">
import { CircuitBreaker } from '../../../shared/utils/circuitBreaker';

const circuit = new CircuitBreaker(3, 60_000);

// Google Books API key - should be set via environment variable in production
const GOOGLE_BOOKS_API_KEY = process.env.GOOGLE_BOOKS_API_KEY || '';

export interface GoogleBooksMeta {
  title: string;
  subtitle?: string | null;
  author?: string | null;
  publisher?: string | null;
  publishedDate?: string | null;
  description?: string | null;
  pageCount?: number | null;
  categories?: string | null;
  averageRating?: number | null;
  language?: string | null;
  coverUrl?: string | null;
  isbn10?: string | null;
  isbn13?: string | null;
}

export async function fetchGoogleBooks(isbn: string): Promise<GoogleBooksMeta | null> {
  if (!circuit.canRequest()) return null;
  if (!GOOGLE_BOOKS_API_KEY) {
    console.warn('Google Books API key not configured');
    return null;
  }
  try {
    const url = `https://www.googleapis.com/books/v1/volumes?q=isbn:${isbn}&maxResults=1&key=${GOOGLE_BOOKS_API_KEY}`;
    const res = await fetch(url, { signal: AbortSignal.timeout(10_000) });
    if (!res.ok) {
      circuit.recordFailure();
      return null;
    }
    const data = await res.json() as any;
    circuit.recordSuccess();

    if (!data.items || data.items.length === 0) return null;
    const volume = data.items[0];
    const info = volume.volumeInfo;
    if (!info) return null;

    const isbn10 = info.industryIdentifiers?.find((id: any) => id.type === 'ISBN_10')?.identifier || null;
    const isbn13 = info.industryIdentifiers?.find((id: any) => id.type === 'ISBN_13')?.identifier || null;

    const thumbnail = info.imageLinks?.thumbnail
      || info.imageLinks?.smallThumbnail
      || null;

    const authors = Array.isArray(info.authors) ? info.authors.join(', ') : null;
    const categories = Array.isArray(info.categories) ? info.categories.join(', ') : null;

    return {
      title: info.title || `ISBN ${isbn}`,
      subtitle: info.subtitle || null,
      author: authors,
      publisher: info.publisher || null,
      publishedDate: info.publishedDate || null,
      description: info.description || null,
      pageCount: info.pageCount || null,
      categories,
      averageRating: info.averageRating || null,
      language: info.language || null,
      coverUrl: thumbnail,
      isbn10,
      isbn13,
    };
  } catch {
    circuit.recordFailure();
    return null;
  }
}
</file>

<file path="borrow-service/src/clients/NotificationServiceClient.ts">
import { config } from '../config';
import { amqpClient } from './AmqpClient';
import { getServiceToken } from '../../../shared/auth';

interface RequestOptions {
  method?: string;
  body?: any;
  timeout?: number;
}

async function request(url: string, options: RequestOptions = {}): Promise<any> {
  const { method = 'GET', body, timeout = 5000 } = options;
  const controller = new AbortController();
  const timer = setTimeout(() => controller.abort(), timeout);

  try {
    const res = await fetch(url, {
      method,
      headers: {
        'Content-Type': 'application/json',
        'Authorization': `Bearer ${getServiceToken('borrow-service', config.jwtSecret)}`,
      },
      body: body ? JSON.stringify(body) : undefined,
      signal: controller.signal,
    });
    clearTimeout(timer);
    if (!res.ok) {
      const text = await res.text().catch(() => '');
      throw new Error(`HTTP ${res.status}: ${text}`);
    }
    return res.json();
  } catch (error) {
    clearTimeout(timer);
    throw error;
  }
}

export const notificationServiceClient = {
  async sendNotification(input: {
    userId: string;
    type: string;
    title: string;
    message: string;
    data?: Record<string, any>;
  }) {
    try {
      const published = await amqpClient.publish('notification.send', {
        emailType: 'push',
        userId: input.userId,
        type: input.type,
        title: input.title,
        body: input.message,
        data: input.data || {},
      });
      if (published) {
        console.log('[AMQP] Published push notification event to RabbitMQ');
        return { success: true, via: 'rabbitmq' };
      }
    } catch (err: any) {
      console.error('[AMQP] RabbitMQ publish failed, falling back to HTTP sync:', err.message);
    }

    return request(`${config.notificationServiceUrl}/internal/`, {
      method: 'POST',
      body: input,
    });
  },
};
</file>

<file path="borrow-service/src/clients/OpenLibraryClient.ts">
import { CircuitBreaker } from '../../../shared/utils/circuitBreaker';

const circuit = new CircuitBreaker(3, 60_000);

export interface OpenLibraryMeta {
  title: string;
  author?: string | null;
  cover_url?: string | null;
}

export async function fetchOpenLibrary(isbn: string): Promise<OpenLibraryMeta | null> {
  if (!circuit.canRequest()) return null;
  try {
    const url = new URL('https://openlibrary.org/api/books');
    url.searchParams.set('bibkeys', `ISBN:${isbn}`);
    url.searchParams.set('format', 'json');
    url.searchParams.set('jscmd', 'data');
    const res = await fetch(url, { signal: AbortSignal.timeout(10_000) });
    if (!res.ok) {
      circuit.recordFailure();
      return null;
    }
    const data = await res.json() as any;
    const book = data[`ISBN:${isbn}`];
    circuit.recordSuccess();
    if (!book) return null;
    return {
      title: book.title || `ISBN ${isbn}`,
      author: book.authors?.[0]?.name || null,
      cover_url: book.cover?.medium || book.cover?.small || null,
    };
  } catch {
    circuit.recordFailure();
    return null;
  }
}
