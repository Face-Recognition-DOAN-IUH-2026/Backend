<file path="access-service/src/clients/UserServiceClient.ts">
import { config } from '../config';
import { getServiceToken } from '../../../shared/auth';
import { CircuitBreaker } from '../../../shared/utils/circuitBreaker';
import { retryWithBackoff } from '../../../shared/utils/retryWithBackoff';

export interface UserSummary {
  id: string;
  fullName?: string | null;
  email?: string | null;
  role?: string | null;
  status?: string | null;
  studentCode?: string | null;
  cardNumber?: string | null;
}

const circuit = new CircuitBreaker(5, 60_000);

export class UserServiceClient {
  async getUser(id: string): Promise<UserSummary | null> {
    if (!circuit.canRequest()) return null;
    try {
      return await retryWithBackoff(async () => {
        const res = await fetch(`${config.userServiceUrl}/internal/users/${id}`, {
          headers: { 'Authorization': `Bearer ${getServiceToken('access-service', config.jwtSecret)}` },
          signal: AbortSignal.timeout(3000),
        });
        if (res.status === 404) {
          circuit.recordSuccess();
          return null;
        }
        if (res.status >= 500) {
          circuit.recordFailure();
          throw new Error(`user-service ${res.status}`);
        }
        if (!res.ok) throw new Error(`user-service ${res.status}`);
        circuit.recordSuccess();
        return (await res.json()) as UserSummary;
      }, 2, 500);
    } catch {
      return null;
    }
  }

  async getUsers(ids: string[]): Promise<Map<string, UserSummary>> {
    const uniqueIds = [...new Set(ids.filter(Boolean))];
    if (uniqueIds.length === 0) return new Map();

    if (!circuit.canRequest()) {
      const results = await Promise.all(uniqueIds.map((id) => this.getUser(id)));
      const map = new Map<string, UserSummary>();
      results.forEach((user) => {
        if (user?.id) map.set(user.id, user);
      });
      return map;
    }

    try {
      const res = await fetch(`${config.userServiceUrl}/internal/users/batch`, {
        method: 'POST',
        headers: {
          'Authorization': `Bearer ${getServiceToken('access-service', config.jwtSecret)}`,
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({ ids: uniqueIds }),
        signal: AbortSignal.timeout(5000),
      });
      if (res.status >= 500) {
        circuit.recordFailure();
        throw new Error(`user-service batch ${res.status}`);
      }
      if (!res.ok) throw new Error(`user-service batch ${res.status}`);
      circuit.recordSuccess();
      const data = await res.json() as Record<string, UserSummary>;
      const map = new Map<string, UserSummary>();
      for (const [id, user] of Object.entries(data)) {
        if (user?.id) map.set(id, user);
      }
      return map;
    } catch {
      const results = await Promise.all(uniqueIds.map((id) => this.getUser(id)));
      const map = new Map<string, UserSummary>();
      results.forEach((user) => {
        if (user?.id) map.set(user.id, user);
      });
      return map;
    }
  }
}
</file>

<file path="access-service/src/realtime/RealtimeHub.ts">
import crypto from 'crypto';
import { randomUUID } from 'crypto';
import { Response } from 'express';
import { WebSocket } from 'ws';
import { amqpClient } from '../clients/AmqpClient';
import { config } from '../config';
import { AccessRealtimeEvent, FaceResultEvent } from '../contracts';

const EXCHANGE = 'access.realtime.fanout';

function signPayload(payload: object, secret: string): string {
  return crypto.createHmac('sha256', secret).update(JSON.stringify(payload)).digest('hex');
}

export class RealtimeHub {
  private sseClients = new Set<Response>();
  private wsClients = new Set<WebSocket>();
  private instanceId = randomUUID();

  async connectBroker() {
    try {
      await amqpClient.connect();
      await amqpClient.subscribeFanout(EXCHANGE, (message) => {
        if (message.originId === this.instanceId) return;
        if (message.signature && config.serviceJwtSecret) {
          const { signature, ...rest } = message;
          const expected = signPayload(rest, config.serviceJwtSecret);
          try {
            if (!crypto.timingSafeEqual(Buffer.from(signature, 'hex'), Buffer.from(expected, 'hex'))) {
              console.warn('[RealtimeHub] Invalid signature, ignoring event');
              return;
            }
          } catch {
            console.warn('[RealtimeHub] Signature verification failed, ignoring event');
            return;
          }
        }
        this.broadcastLocal(message.event as AccessRealtimeEvent);
      });
      console.log('[RealtimeHub] Connected to RabbitMQ fanout:', EXCHANGE);
    } catch (err: any) {
      console.error('[RealtimeHub] RabbitMQ connection failed:', err.message);
    }
  }

  addSseClient(res: Response) {
    this.sseClients.add(res);
    res.write(': connected\n\n');
    const interval = setInterval(() => res.write(': keepalive\n\n'), 25_000);
    res.on('close', () => {
      clearInterval(interval);
      this.sseClients.delete(res);
    });
  }

  addWsClient(ws: WebSocket) {
    this.wsClients.add(ws);
    ws.on('close', () => this.wsClients.delete(ws));
    ws.on('error', () => this.wsClients.delete(ws));
    ws.send(JSON.stringify({ type: 'connected', timestamp: new Date().toISOString() }));
  }

  async publish(event: AccessRealtimeEvent) {
    this.broadcastLocal(event);
    const body = {
      originId: this.instanceId,
      event,
      timestamp: new Date().toISOString(),
    };
    const signature = config.serviceJwtSecret ? signPayload(body, config.serviceJwtSecret) : '';
    await amqpClient.publishFanout(EXCHANGE, { ...body, signature });
  }

  private broadcastLocal(event: AccessRealtimeEvent) {
    const payload = JSON.stringify(event);
    for (const client of this.sseClients) {
      client.write(`event: camera_event\n`);
      client.write(`data: ${payload}\n\n`);
    }
    for (const client of this.wsClients) {
      if (client.readyState === WebSocket.OPEN) {
        client.send(JSON.stringify({ event: 'camera_event', data: event }));
      }
    }
  }

  broadcastFaceResult(event: FaceResultEvent) {
    const payload = JSON.stringify(event);
    for (const client of this.sseClients) {
      client.write(`event: face_result\n`);
      client.write(`data: ${payload}\n\n`);
    }
    for (const client of this.wsClients) {
      if (client.readyState === WebSocket.OPEN) {
        client.send(JSON.stringify({ event: 'face_result', data: event }));
      }
    }
  }
}

export const realtimeHub = new RealtimeHub();
