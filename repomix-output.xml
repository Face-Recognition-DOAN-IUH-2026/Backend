<file path="user-service/src/clients/AccessServiceClient.ts">
import { config } from '../config';
import { getServiceToken } from '../../../shared/auth';
import { CircuitBreaker } from '../../../shared/utils/circuitBreaker';

interface RequestOptions {
  method?: string;
  body?: any;
  timeout?: number;
}

export const accessCircuit = new CircuitBreaker(3, 30_000);

async function request(url: string, options: RequestOptions = {}): Promise<any> {
  if (!accessCircuit.canRequest()) {
    throw new Error('Access-service temporarily unavailable');
  }
  const { method = 'GET', body, timeout = 5000 } = options;
  const controller = new AbortController();
  const timer = setTimeout(() => controller.abort(), timeout);

  try {
    const res = await fetch(url, {
      method,
      headers: {
        'Content-Type': 'application/json',
        'Authorization': `Bearer ${getServiceToken('user-service', config.jwtSecret)}`,
      },
      body: body ? JSON.stringify(body) : undefined,
      signal: controller.signal,
    });
    clearTimeout(timer);
    if (!res.ok) {
      const text = await res.text().catch(() => '');
      throw new Error(`HTTP ${res.status}: ${text}`);
    }
    accessCircuit.recordSuccess();
    return res.json();
  } catch (error) {
    clearTimeout(timer);
    accessCircuit.recordFailure();
    throw error;
  }
}

export const accessServiceClient = {
  async getDailyStats(): Promise<{
    active_inside: number;
    today_entries: number;
    today_exits: number;
  }> {
    const result = await request(`${config.accessServiceUrl}/internal/access/stats`);
    return {
      active_inside: result.active_inside ?? result.activeInside ?? 0,
      today_entries: result.today_entries || result.todayEntries || 0,
      today_exits: result.today_exits || result.todayExits || 0,
    };
  },

  async getPatronStatus(patronId: string): Promise<string> {
    try {
      const result = await request(`${config.accessServiceUrl}/internal/access/patrons/${encodeURIComponent(patronId)}/status`);
      return result.currentStatus || result.current_status || 'outside';
    } catch {
      return 'outside';
    }
  },

  async setPatronStatus(patronId: string, status: 'inside' | 'outside', cameraId?: string): Promise<void> {
    await request(`${config.accessServiceUrl}/internal/access/patrons/${encodeURIComponent(patronId)}/status`, {
      method: 'POST',
      body: { current_status: status, camera_id: cameraId || 'manual' },
    });
  },
};
</file>

<file path="user-service/src/controllers/AuthController.ts">
import { Request, Response } from 'express';
import { authService } from '../services';
import { setAuthCookie, clearAuthCookie } from '../../shared/auth';

export class AuthController {
  async register(req: Request, res: Response) {
    try {
      const { email, password, full_name, role, student_code, skip_verification } = req.body;
      if (!email || !password) {
        res.status(400).json({ error: 'Email and password are required' });
        return;
      }
      const result = await authService.register({
        email,
        password,
        fullName: full_name,
        role: role || 'user',
        studentCode: student_code,
        skipVerification: skip_verification,
      });
      if (result.access_token) setAuthCookie(res, result.access_token);
      res.status(201).json(result);
    } catch (error: any) {
      res.status(error.statusCode || 400).json({ error: error.message || 'Registration failed' });
    }
  }

  async login(req: Request, res: Response) {
    try {
      const { email, student_code, password } = req.body;
      if (!password || (!email && !student_code)) {
        res.status(400).json({ error: 'Email/student_code and password are required' });
        return;
      }
      const result = await authService.login({
        email,
        studentCode: student_code,
        password,
      });
      if (result.access_token) setAuthCookie(res, result.access_token);
      res.json(result);
    } catch (error: any) {
      res.status(error.statusCode || 401).json({ error: error.message || 'Login failed' });
    }
  }

  async getMe(req: Request, res: Response) {
    try {
      const authHeader = req.headers.authorization;
      if (!authHeader?.startsWith('Bearer ')) {
        res.status(401).json({ error: 'No token provided' });
        return;
      }
      const token = authHeader.split(' ')[1];
      const payload = authService.verifyToken(token, 'access');
      const user = await authService.getUserById(payload.userId);
      res.json(user);
    } catch (error: any) {
      res.status(401).json({ error: 'Invalid token' });
    }
  }

  async refresh(req: Request, res: Response) {
    try {
      const { refresh_token } = req.body;
      if (!refresh_token) {
        res.status(400).json({ error: 'refresh_token required' });
        return;
      }
      const result = await authService.refreshToken(refresh_token);
      if (result.access_token) setAuthCookie(res, result.access_token);
      res.json(result);
    } catch (error: any) {
      res.status(401).json({ error: 'Invalid refresh token' });
    }
  }

  async logout(_req: Request, res: Response) {
    clearAuthCookie(res);
    res.json({ message: 'Logged out' });
  }

  async forgotPassword(req: Request, res: Response) {
    try {
      const { email } = req.body;
      if (!email) {
        res.status(400).json({ error: 'Email la bat buoc' });
        return;
      }
      await authService.forgotPassword(email);
      res.json({ message: 'Da gui ma reset qua email' });
    } catch (error: any) {
      res.status(error.statusCode || 400).json({ error: error.message });
    }
  }

  async verifyResetCode(req: Request, res: Response) {
    try {
      const { email, code } = req.body;
      if (!email || !code) {
        res.status(400).json({ error: 'Email va ma reset la bat buoc' });
        return;
      }
      const isValid = await authService.verifyResetCode(email, code);
      if (!isValid) {
        res.status(400).json({ error: 'Ma reset khong hop le hoac da het han' });
        return;
      }
      res.json({ valid: true });
    } catch (error: any) {
      res.status(400).json({ error: error.message });
    }
  }

  async resetPassword(req: Request, res: Response) {
    try {
      const { email, code, new_password } = req.body;
      if (!email || !code || !new_password) {
        res.status(400).json({ error: 'Email, ma reset, va mat khau moi la bat buoc' });
        return;
      }
      if (new_password.length < 6) {
        res.status(400).json({ error: 'Mat khau moi phai it nhat 6 ki tu' });
        return;
      }
      await authService.resetPassword(email, code, new_password);
      res.json({ message: 'Dat lai mat khau thanh cong' });
    } catch (error: any) {
      res.status(error.statusCode || 400).json({ error: error.message });
    }
  }

  async verifyEmail(req: Request, res: Response) {
    try {
      const { email, code } = req.body;
      if (!email || !code) {
        res.status(400).json({ error: 'Email va ma xac thuc la bat buoc' });
        return;
      }
      await authService.verifyEmail(email, code);
      res.json({ message: 'Xac thuc email thanh cong' });
    } catch (error: any) {
      res.status(error.statusCode || 400).json({ error: error.message });
    }
  }

  async resendVerification(req: Request, res: Response) {
    try {
      const { email } = req.body;
      if (!email) {
        res.status(400).json({ error: 'Email la bat buoc' });
        return;
      }
      await authService.resendVerificationEmail(email);
      res.json({ message: 'Da gui ma xac thuc moi' });
    } catch (error: any) {
      res.status(error.statusCode || 400).json({ error: error.message });
    }
  }

  async requestEmailCorrection(req: Request, res: Response) {
    try {
      const { current_email, new_email } = req.body;
      if (!current_email || !new_email) {
        res.status(400).json({ error: 'current_email va new_email la bat buoc' });
        return;
      }
      await authService.requestEmailCorrection(current_email, new_email);
      res.json({ message: 'Da gui ma OTP den email moi' });
    } catch (error: any) {
      res.status(error.statusCode || 400).json({ error: error.message });
    }
  }

  async verifyEmailCorrection(req: Request, res: Response) {
    try {
      const { current_email, new_email, code } = req.body;
      if (!current_email || !new_email || !code) {
        res.status(400).json({ error: 'current_email, new_email, va code la bat buoc' });
        return;
      }
      await authService.verifyEmailAndCorrect(current_email, new_email, code);
      res.json({ message: 'Doi email va xac thuc thanh cong' });
    } catch (error: any) {
      res.status(error.statusCode || 400).json({ error: error.message });
    }
  }

  async preRegisterOtp(req: Request, res: Response) {
    try {
      const { email } = req.body;
      if (!email) {
        res.status(400).json({ error: 'Email la bat buoc' });
        return;
      }
      await authService.sendPreRegisterOtp(email);
      res.json({ message: 'Da gui ma OTP qua email' });
    } catch (error: any) {
      res.status(error.statusCode || 400).json({ error: error.message });
    }
  }

  async preRegisterVerify(req: Request, res: Response) {
    try {
      const { email, code } = req.body;
      if (!email || !code) {
        res.status(400).json({ error: 'Email va ma OTP la bat buoc' });
        return;
      }
      const token = await authService.verifyPreRegisterOtp(email, code);
      res.json({ verification_token: token });
    } catch (error: any) {
      res.status(error.statusCode || 400).json({ error: error.message });
    }
  }

}

export const authController = new AuthController();
</file>

<file path="user-service/src/routes/auth.routes.ts">
import { Router } from 'express';
import { authController } from '../controllers';
import { requireRole } from '../middlewares/requireRole';
import { createAuth } from '../../../shared/auth';

const router = Router();

/**
 * @swagger
 * /auth/register:
 *   post:
 *     summary: Register a new user (admin/staff only)
 *     tags: [Auth]
 *     security:
 *       - bearerAuth: []
 *     requestBody:
 *       required: true
 *       content:
 *         application/json:
 *           schema:
 *             type: object
 *             required:
 *               - fullName
 *               - email
 *               - password
 *               - role
 *             properties:
 *               fullName:
 *                 type: string
 *               email:
 *                 type: string
 *                 format: email
 *               password:
 *                 type: string
 *                 format: password
 *               role:
 *                 type: string
 *                 enum: [admin, staff, patron]
 *               studentCode:
 *                 type: string
 *               phone:
 *                 type: string
 *     responses:
 *       201:
 *         description: User registered successfully
 *       400:
 *         description: Validation error
 *       401:
 *         description: Unauthorized
 *       403:
 *         description: Forbidden
 */
router.post('/register', requireRole('admin', 'staff'), (req, res) => authController.register(req, res));

/**
 * @swagger
 * /auth/login:
 *   post:
 *     summary: Authenticate user and return tokens
 *     tags: [Auth]
 *     requestBody:
 *       required: true
 *       content:
 *         application/json:
 *           schema:
 *             type: object
 *             required:
 *               - email
 *               - password
 *             properties:
 *               email:
 *                 type: string
 *                 format: email
 *               password:
 *                 type: string
 *                 format: password
 *     responses:
 *       200:
 *         description: Login successful, tokens returned
 *       401:
 *         description: Invalid credentials
 */
router.post('/login', (req, res) => authController.login(req, res));

/**
 * @swagger
 * /auth/refresh:
 *   post:
 *     summary: Refresh access token using refresh token
 *     tags: [Auth]
 *     requestBody:
 *       required: true
 *       content:
 *         application/json:
 *           schema:
 *             type: object
 *             required:
 *               - refreshToken
 *             properties:
 *               refreshToken:
 *                 type: string
 *     responses:
 *       200:
 *         description: New access token returned
 *       401:
 *         description: Invalid or expired refresh token
 */
router.post('/refresh', (req, res) => authController.refresh(req, res));

/**
 * @swagger
 * /auth/logout:
 *   post:
 *     summary: Logout and clear auth cookie
 *     tags: [Auth]
 *     responses:
 *       200:
 *         description: Logged out successfully
 */
router.post('/logout', (req, res) => authController.logout(req, res));

/**
 * @swagger
 * /auth/forgot-password:
 *   post:
 *     summary: Send password reset code to email
 *     tags: [Auth]
 *     requestBody:
 *       required: true
 *       content:
 *         application/json:
 *           schema:
 *             type: object
 *             required:
 *               - email
 *             properties:
 *               email:
 *                 type: string
 *                 format: email
 *     responses:
 *       200:
 *         description: Reset code sent if email exists
 *       404:
 *         description: Email not found
 */
router.post('/forgot-password', (req, res) => authController.forgotPassword(req, res));

/**
 * @swagger
 * /auth/verify-reset-code:
 *   post:
 *     summary: Verify password reset code
 *     tags: [Auth]
 *     requestBody:
 *       required: true
 *       content:
 *         application/json:
 *           schema:
 *             type: object
 *             required:
 *               - email
 *               - code
 *             properties:
 *               email:
 *                 type: string
 *                 format: email
 *               code:
 *                 type: string
 *     responses:
 *       200:
 *         description: Code verified successfully
 *       400:
 *         description: Invalid or expired code
 */
router.post('/verify-reset-code', (req, res) => authController.verifyResetCode(req, res));

/**
 * @swagger
 * /auth/reset-password:
 *   post:
 *     summary: Reset password with verified code
 *     tags: [Auth]
 *     requestBody:
 *       required: true
 *       content:
 *         application/json:
 *           schema:
 *             type: object
 *             required:
 *               - email
 *               - code
 *               - newPassword
 *             properties:
 *               email:
 *                 type: string
 *                 format: email
 *               code:
 *                 type: string
 *               newPassword:
 *                 type: string
 *                 format: password
 *     responses:
 *       200:
 *         description: Password reset successfully
 *       400:
 *         description: Invalid or expired code
