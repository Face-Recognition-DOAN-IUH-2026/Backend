/**
 * @swagger
 * /auth/correct-email/request-otp:
 *   post:
 *     summary: Request OTP to change email for unverified account
 *     tags: [Auth]
 *     requestBody:
 *       required: true
 *       content:
 *         application/json:
 *           schema:
 *             type: object
