import { Router, Request, Response } from 'express';
import { sessionStore } from '../sessions';
import { tools } from '../tools/tools';

const router = Router();

router.post('/', async (req: Request, res: Response) => {
  try {
    const { sessionId, action } = req.body as {
      sessionId: string;
      action: 'approve' | 'reject';
    };

    if (!sessionId || !action) {
      res.status(400).json({ error: 'sessionId and action are required' });
      return;
    }

    if (!['approve', 'reject'].includes(action)) {
      res.status(400).json({ error: 'action must be "approve" or "reject"' });
      return;
    }

    const session = sessionStore.get(sessionId);
    if (!session) {
      res.status(404).json({ error: 'Session not found or confirmation expired' });
      return;
    }

    if (!session.pendingConfirmation) {
      res.status(400).json({ error: 'No pending confirmation for this session' });
      return;
    }

    const pendingAction = session.pendingConfirmation;

    if (action === 'reject') {
      sessionStore.setConfirmation(sessionId, undefined);
      res.json({
        success: true,
        message: 'Hành động đã bị từ chối.',
      });
      return;
    }

    try {
      const tool = tools.find(t => t.name === pendingAction.toolName);

      if (tool) {
        const argValues = Object.values(pendingAction.toolArgs || {});
        const fn = tool.func as (...args: any[]) => any;
        const result = await fn(...argValues);
        sessionStore.setConfirmation(sessionId, undefined);

        res.json({
          success: true,
          message: 'Hành động đã được thực hiện thành công.',
          result,
        });
      } else {
        res.status(400).json({
          success: false,
          error: `Tool "${pendingAction.toolName}" not found`,
        });
      }
    } catch (error) {
      res.status(500).json({
        success: false,
        error: error instanceof Error ? error.message : 'Execution failed',
      });
    }
  } catch (error) {
    console.error('Confirm error:', error);
    res.status(500).json({
      error: 'Internal server error',
      message: error instanceof Error ? error.message : 'Unknown error',
    });
  }
});

export default router;
</file>

<file path="ai-service/src/sessions.ts">
import { v4 as uuidv4 } from 'uuid';

export interface ChatMessage {
  role: 'user' | 'assistant';
  content: string;
  timestamp: number;
}

export interface PendingConfirmation {
  action: string;
  toolName: string;
  toolArgs: Record<string, any>;
  description: string;
}

export interface ChatSession {
  id: string;
  messages: ChatMessage[];
  patronId?: string;
  pendingConfirmation?: PendingConfirmation;
}

class SessionStore {
  private sessions = new Map<string, ChatSession>();

  create(patronId?: string): ChatSession {
    const session: ChatSession = {
      id: uuidv4(),
      messages: [],
      patronId,
    };
    this.sessions.set(session.id, session);
    return session;
  }

  get(id: string): ChatSession | undefined {
    return this.sessions.get(id);
  }

  update(id: string, updates: Partial<ChatSession>): ChatSession | undefined {
    const session = this.sessions.get(id);
    if (!session) return undefined;

    const updated = { ...session, ...updates };
    this.sessions.set(id, updated);
    return updated;
  }

  addMessage(id: string, message: ChatMessage): ChatSession | undefined {
    const session = this.sessions.get(id);
    if (!session) return undefined;

    session.messages.push(message);
    return session;
  }

  setConfirmation(id: string, confirmation: PendingConfirmation | undefined): ChatSession | undefined {
    const session = this.sessions.get(id);
    if (!session) return undefined;

    session.pendingConfirmation = confirmation;
    return session;
  }

  hasPendingConfirmation(id: string): boolean {
    const session = this.sessions.get(id);
    return !!session?.pendingConfirmation;
  }

  delete(id: string): boolean {
    return this.sessions.delete(id);
  }
}

export const sessionStore = new SessionStore();
export default sessionStore;
</file>

<file path="ai-service/src/tools/tools.ts">
import axios from 'axios';
import { config } from '../config';

const INTERNAL_HEADERS = {
  'X-Internal-Api-Key': config.internalApiKey,
  'Content-Type': 'application/json',
};

export interface ToolResult {
  success: boolean;
  data?: any;
  error?: string;
}

async function safeGet<T>(url: string): Promise<ToolResult> {
  try {
    const response = await axios.get<T>(url, {
      headers: INTERNAL_HEADERS,
      timeout: 10000,
    });
    return { success: true, data: response.data };
  } catch (error) {
    const message = axios.isAxiosError(error)
      ? error.response?.data?.message || error.message
      : 'Unknown error';
    return { success: false, error: message };
  }
}

async function safePost<T>(url: string, body: any): Promise<ToolResult> {
  try {
    const response = await axios.post<T>(url, body, {
      headers: INTERNAL_HEADERS,
      timeout: 10000,
    });
    return { success: true, data: response.data };
  } catch (error) {
    const message = axios.isAxiosError(error)
      ? error.response?.data?.message || error.message
      : 'Unknown error';
    return { success: false, error: message };
  }
}

async function safePut<T>(url: string, body: any): Promise<ToolResult> {
  try {
    const response = await axios.put<T>(url, body, {
      headers: INTERNAL_HEADERS,
      timeout: 10000,
    });
    return { success: true, data: response.data };
  } catch (error) {
    const message = axios.isAxiosError(error)
      ? error.response?.data?.message || error.message
      : 'Unknown error';
    return { success: false, error: message };
  }
}

export async function searchBooks(query: string): Promise<ToolResult> {
  const url = `${config.borrowServiceUrl}/borrow/internal/books/search?query=${encodeURIComponent(query)}`;
  return safeGet<any>(url);
}

export async function getShelfLocation(bookId: string): Promise<ToolResult> {
  const url = `${config.borrowServiceUrl}/borrow/internal/shelves?book_id=${encodeURIComponent(bookId)}`;
  return safeGet<any>(url);
}

export async function getPatronInfo(patronId: string): Promise<ToolResult> {
  const url = `${config.userServiceUrl}/patrons/${encodeURIComponent(patronId)}`;
  return safeGet<any>(url);
}

export async function getPatronBorrows(patronId: string): Promise<ToolResult> {
  const url = `${config.borrowServiceUrl}/borrow/internal/patron/${encodeURIComponent(patronId)}`;
  return safeGet<any>(url);
}

export async function getOverdueBorrows(): Promise<ToolResult> {
  const url = `${config.borrowServiceUrl}/borrow/internal/overdue`;
  return safeGet<any>(url);
}

export async function getScheduleToday(): Promise<ToolResult> {
  const url = `${config.scheduleServiceUrl}/schedules/today`;
  const result = await safeGet<any>(url);

  if (result.success && result.data && Array.isArray(result.data)) {
    result.data.sort((a: any, b: any) => {
      const timeA = a.shift?.startTime || '';
      const timeB = b.shift?.startTime || '';
      return timeA.localeCompare(timeB);
    });
  }

  return result;
}

