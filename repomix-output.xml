            if not liveness.get("is_live", False):
                _delete_temp_frame(object_key)
                logger.warning("Enroll face: liveness check failed for patron_id %s, score=%.4f", patron_id, liveness.get("liveness_score", 0))
                return {
                    "status": "error",
