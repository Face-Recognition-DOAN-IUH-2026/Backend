<file path="notification-service/src/services/NotificationService.ts">
import { AppDataSource } from '../data-source';
import { Notification } from '../entities/Notification';

const repo = () => AppDataSource.getRepository(Notification);

export interface CreateNotificationInput {
  userId: string;
  type: string;
  title: string;
  body: string;
  data?: Record<string, any>;
}

export class NotificationService {
  async create(input: CreateNotificationInput): Promise<Notification> {
    const entity = repo().create({
      userId: input.userId,
      type: input.type,
      title: input.title,
      body: input.body,
      data: input.data || null,
    });
    return repo().save(entity);
  }

  async createMany(inputs: CreateNotificationInput[]): Promise<Notification[]> {
    const entities = inputs.map((input) =>
      repo().create({
        userId: input.userId,
        type: input.type,
        title: input.title,
        body: input.body,
        data: input.data || null,
      })
    );
    return repo().save(entities);
  }

  async list(userId: string, options: { unreadOnly?: boolean; skip?: number; limit?: number } = {}): Promise<{ items: Notification[]; total: number; unread: number }> {
    const { unreadOnly = false, skip = 0, limit = 20 } = options;

    const qb = repo().createQueryBuilder('n').where('n.user_id = :userId', { userId });

    if (unreadOnly) {
      qb.andWhere('n.is_read = false');
    }

    qb.orderBy('n.created_at', 'DESC').skip(skip).take(limit);

    const [items, total] = await qb.getManyAndCount();

    const unread = await repo().count({ where: { userId, isRead: false } });

    return { items, total, unread };
  }

  async getUnreadCount(userId: string): Promise<number> {
    return repo().count({ where: { userId, isRead: false } });
  }

  async markAsRead(id: string, userId: string): Promise<Notification | null> {
    const entity = await repo().findOne({ where: { id, userId } });
    if (!entity || entity.isRead) return entity;
    entity.isRead = true;
    entity.readAt = new Date();
    return repo().save(entity);
  }

  async markAllAsRead(userId: string): Promise<number> {
    const result = await repo()
      .createQueryBuilder()
      .update(Notification)
      .set({ isRead: true, readAt: new Date() })
      .where('user_id = :userId AND is_read = false', { userId })
      .execute();
    return result.affected || 0;
  }

  async findById(id: string): Promise<Notification | null> {
    return repo().findOne({ where: { id } });
  }

  async deleteOlderThan(userId: string, days: number): Promise<number> {
    const cutoff = new Date();
    cutoff.setDate(cutoff.getDate() - days);
    const result = await repo()
      .createQueryBuilder()
      .delete()
      .where('user_id = :userId AND created_at < :cutoff', { userId, cutoff })
      .execute();
    return result.affected || 0;
  }
}

export const notificationService = new NotificationService();
</file>

<file path="notification-service/src/subscribers/UserEventSubscriber.ts">
import crypto from 'crypto';
import Redis from 'ioredis';
import { config } from '../config';
import { AppDataSource } from '../data-source';
import { Notification } from '../entities/Notification';

interface UserDeletedMessage {
  event: 'USER_DELETED';
  user_id: string;
  email: string;
  timestamp: string;
  signature: string;
}

function signPayload(payload: object, secret: string): string {
  return crypto.createHmac('sha256', secret).update(JSON.stringify(payload)).digest('hex');
}

function verifySignature(msg: UserDeletedMessage): boolean {
  const { signature, ...rest } = msg;
  const expected = signPayload(rest, config.internalApiKey);
  try {
    return crypto.timingSafeEqual(Buffer.from(signature, 'hex'), Buffer.from(expected, 'hex'));
  } catch {
    return false;
  }
}

export async function startUserEventSubscriber(): Promise<void> {
  const redis = new Redis(config.redisUrl, {
    retryStrategy: (times) => Math.min(times * 50, 2000),
    maxRetriesPerRequest: 3,
  });

  redis.on('error', (err) => {
    console.error('[UserEventSubscriber] Redis error:', err.message);
  });

  await redis.subscribe('user.events', (err) => {
    if (err) {
      console.error('[UserEventSubscriber] Subscribe error:', err.message);
      return;
    }
    console.log('[UserEventSubscriber] Subscribed to user.events');
  });

  redis.on('message', async (_channel, raw) => {
    try {
      const msg: UserDeletedMessage = JSON.parse(raw);
      if (msg.event !== 'USER_DELETED') return;

      if (!verifySignature(msg)) {
        console.warn('[UserEventSubscriber] Invalid signature, ignoring event');
        return;
      }

      console.log(`[UserEventSubscriber] Processing USER_DELETED for ${msg.user_id}`);

      const repo = AppDataSource.getRepository(Notification);
      const result = await repo.delete({ userId: msg.user_id });
      console.log(`[UserEventSubscriber] Deleted ${result.affected ?? 0} notifications for user ${msg.user_id}`);
    } catch (e) {
      console.error('[UserEventSubscriber] Error processing event:', e);
    }
  });
}
