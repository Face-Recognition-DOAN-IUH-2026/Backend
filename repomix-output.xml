  try {
    res.json(await accessService.getStats());
  } catch (error) {
    next(error);
  }
});

/**
 * @swagger
 * /access/test-broadcast:
 *   post:
 *     summary: Broadcast a manual test recognition event
 *     tags: [Access]
 *     security:
 *       - bearerAuth: []
 *     requestBody:
 *       required: true
 *       content:
 *         application/json:
 *           schema:
 *             type: object
 *             properties:
 *               camera_id:
 *                 type: string
 *                 default: kiosk
 *               status:
 *                 type: string
 *                 default: granted
 *               patron_id:
 *                 type: string
 *               student_code:
 *                 type: string
 *               full_name:
 *                 type: string
 *               access_type:
 *                 type: string
 *                 enum: [entry, exit]
