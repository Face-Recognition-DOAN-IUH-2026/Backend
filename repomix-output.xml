<file path="automation-service/src/handlers/shiftReminderNotify.ts">
import { scheduleClient, notificationClient, userClient } from '../clients/serviceClients';

function localDate(value: Date): string {
  const year = value.getFullYear();
  const month = String(value.getMonth() + 1).padStart(2, '0');
  const day = String(value.getDate()).padStart(2, '0');
  return `${year}-${month}-${day}`;
}

export async function shiftReminderNotify(config: Record<string, any>): Promise<any> {
  const today = new Date();
  const tomorrow = new Date(today);
  tomorrow.setDate(tomorrow.getDate() + 1);
  const tomorrowStr = localDate(tomorrow);

  let assignments;
  try {
    assignments = await scheduleClient.getUpcomingAssignments(tomorrowStr, tomorrowStr);
  } catch {
    return { notified: 0, message: 'Failed to fetch upcoming schedule' };
  }

  const items = assignments?.items || [];
  if (items.length === 0) {
    return { notified: 0, message: 'No shifts tomorrow' };
  }

  const notifications = [];

  for (const item of items) {
    if (item.status === 'cancelled' || item.status === 'completed') continue;

    const staffName = item.staff?.fullName || 'Bạn';
    const shiftName = item.shift?.name || 'Ca trực';
    const startTime = item.shift?.startTime || '';
    const endTime = item.shift?.endTime || '';
    const zoneName = item.zone?.name || 'Khu vực';
    const workDate = item.workDate;

    const formattedDate = (() => {
      const d = new Date(`${workDate}T00:00:00`);
      return d.toLocaleDateString('vi-VN', { weekday: 'long', day: 'numeric', month: 'numeric' });
    })();

    notifications.push({
      userId: item.staffId,
      type: 'shift_reminder',
      title: `Nhắc nhở: Ca trực ngày mai`,
      body: `Xin chào ${staffName},\nBạn có ca trực vào ngày mai (${formattedDate}):\n- Ca: ${shiftName} (${startTime} - ${endTime})\n- Khu vực: ${zoneName}\nVui lòng có mặt đúng giờ.`,
      data: {
        scheduleId: item.id,
        shiftId: item.shiftId,
        zoneId: item.zoneId,
        workDate: item.workDate,
        shiftName,
        startTime,
        endTime,
        zoneName,
      },
    });
  }

  if (notifications.length === 0) {
    return { notified: 0, message: 'No valid shifts tomorrow' };
  }

  try {
    await notificationClient.createBulkNotifications(notifications);
    return { notified: notifications.length, message: `Sent ${notifications.length} reminders` };
  } catch (err) {
    console.error('[shiftReminderNotify] Failed to send notifications:', err);
    return { notified: 0, message: 'Failed to send notifications' };
  }
}
</file>

<file path="automation-service/src/handlers/stalePatronCleanup.ts">
import { accessClient } from '../clients/serviceClients';

const MAX_INSIDE_HOURS = 24;

export async function stalePatronCleanup(config: Record<string, any>): Promise<any> {
  const maxHours = config.max_inside_hours || MAX_INSIDE_HOURS;

  let activePatrons;
  try {
    activePatrons = await accessClient.getActivePatrons();
  } catch {
    return { checked: 0, cleaned: 0, message: 'Failed to fetch active patrons' };
  }

  const patronList = Array.isArray(activePatrons) ? activePatrons : (activePatrons as any)?.items || [];

  if (patronList.length === 0) {
    return { checked: 1, cleaned: 0, message: 'No patrons currently inside' };
  }

  const now = Date.now();
  const staleThreshold = now - maxHours * 60 * 60 * 1000;
  const stalePatrons = patronList.filter((p: any) => {
    const entryTime = new Date(p.last_entry_at || p.lastEntryAt || p.entered_at).getTime();
    return entryTime < staleThreshold;
  });

  if (stalePatrons.length === 0) {
    return { checked: 1, cleaned: 0, message: `No stale patrons (>${maxHours}h)` };
  }

  let cleaned = 0;
  let failed = 0;

  for (const patron of stalePatrons) {
    try {
      await accessClient.forceExitPatron(patron.id || patron.patron_id);
      cleaned++;
    } catch {
      failed++;
    }
  }

  return {
    checked: 1,
    cleaned,
    failed,
    stale_count: stalePatrons.length,
    max_hours: maxHours,
    message: `Auto-exited ${cleaned} stale patrons${failed > 0 ? `, ${failed} failed` : ''}`,
  };
}
</file>

<file path="automation-service/src/index.ts">
import 'reflect-metadata';
import express from 'express';
import cors from 'cors';
import { config } from './config';
import { AppDataSource } from './data-source';
import automationRoutes from './routes/automation.routes';
import internalRoutes from './routes/internal.routes';
import { errorHandler } from './middlewares/errorHandler';
import { cronScheduler } from './scheduler/CronScheduler';
import { eventBus } from './events/EventBus';

const app = express();

app.use(cors({ origin: config.corsOrigins.includes('*') ? true : config.corsOrigins, credentials: true }));
app.use(express.json({ limit: '1mb' }));

app.get('/health', (_req, res) => res.json({ status: 'ok', service: 'automation-service' }));
app.use('/automation', automationRoutes);
app.use('/internal', internalRoutes);

app.use(errorHandler);

async function start() {
  try {
    await AppDataSource.initialize();
    console.log('Database connected, running migrations...');
    await AppDataSource.runMigrations();
    console.log('Migrations completed');

    // Connect event bus
    await eventBus.connect();

    // Start cron scheduler
    await cronScheduler.start();

    app.listen(config.port, () => {
      console.log(`Automation service running on port ${config.port}`);
    });
  } catch (error) {
    console.error('Failed to start automation-service:', error);
    process.exit(1);
  }
}

// Graceful shutdown
process.on('SIGTERM', async () => {
  console.log('SIGTERM received, shutting down...');
  await cronScheduler.stop();
  process.exit(0);
});

start();
