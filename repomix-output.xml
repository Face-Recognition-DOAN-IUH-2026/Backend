<file path="automation-service/src/handlers/checkStaffAbsence.ts">
import { scheduleClient, notificationClient, userClient } from '../clients/serviceClients';

export async function checkStaffAbsence(config: Record<string, any>): Promise<any> {
  let assignments;
  try {
    assignments = await scheduleClient.getTodayAssignments();
  } catch {
    return { checked: 0, alerted: 0, message: 'Failed to fetch schedule' };
  }

  const assignmentList = Array.isArray(assignments) ? assignments : (assignments as any)?.items || [];

  if (assignmentList.length === 0) {
    return { checked: 0, alerted: 0, message: 'No assignments today' };
  }

  const now = new Date();
  const absentStaff: Array<{ staffId: string; shiftName: string; scheduledTime: string }> = [];

  for (const assignment of assignmentList) {
    const status = assignment.status;
    const staffId = assignment.staff_id || assignment.staffId;

    // If scheduled but not confirmed and shift has started
    if (status === 'scheduled' && assignment.shift_start) {
      const shiftStart = new Date(assignment.shift_start);
      const gracePeriod = 15 * 60 * 1000; // 15 minutes grace

      if (now.getTime() > shiftStart.getTime() + gracePeriod) {
        absentStaff.push({
          staffId,
          shiftName: assignment.shift_name || assignment.shiftName || 'Ca trực',
          scheduledTime: assignment.shift_start,
        });
      }
    }
  }

  if (absentStaff.length === 0) {
    return { checked: assignmentList.length, alerted: 0, message: 'All staff present or within grace period' };
  }

  // Get admin user IDs dynamically
  let adminUserIds: string[] = config.admin_user_ids || [];

  if (adminUserIds.length === 0) {
    try {
      const admins = await userClient.getUsersByRole('admin');
      adminUserIds = Array.isArray(admins) ? admins.map((u: any) => u.id) : [];
    } catch (err) {
      console.warn('[checkStaffAbsence] Failed to fetch admin users:', (err as Error)?.message || err);
    }
  }

  if (adminUserIds.length > 0) {
    const absentList = absentStaff
      .map((s) => `- ${s.staffId} (${s.shiftName} lúc ${s.scheduledTime})`)
      .join('\n');

    const notifications = adminUserIds.map((userId) => ({
      userId,
      type: 'anomaly_alert',
      title: `Cảnh báo: ${absentStaff.length} nhân viên vắng mặt`,
      body: `Nhân viên không check-in sau 15 phút:\n${absentList}`,
      data: { absentStaff, date: new Date().toISOString().split('T')[0] },
    }));

    await notificationClient.createBulkNotifications(notifications);
  }

  return { checked: assignmentList.length, alerted: absentStaff.length, absentStaff };
}
</file>

<file path="automation-service/src/handlers/membershipExpiryCheck.ts">
import { userClient, notificationClient, emailClient } from '../clients/serviceClients';

export async function membershipExpiryCheck(taskConfig: Record<string, any>): Promise<any> {
  const daysBefore = taskConfig.days_before || 7;

  try {
    const users = await userClient.getExpiringMemberships(daysBefore);

    if (!Array.isArray(users) || users.length === 0) {
      return { checked: 0, notified: 0, message: 'No expiring memberships' };
    }

    const notifications = users.map((user: any) => ({
      userId: user.id,
      type: 'membership_expiry',
      title: 'Thẻ thư viện sắp hết hạn',
      body: `Thẻ thư viện của bạn sẽ hết hạn vào ngày ${new Date(user.membershipExpiry).toLocaleDateString('vi-VN')}. Vui lòng gia hạn tại quầy thủ thư.`,
      data: { expiryDate: user.membershipExpiry, daysLeft: daysBefore },
    }));

    const emailPromises = users
      .filter((user: any) => user.email)
      .map((user: any) =>
        emailClient.sendMembershipExpiryEmail(user.email, user.membershipExpiry).catch((err: any) => {
          console.error(`[membershipExpiryCheck] Failed to send expiry email to ${user.email}:`, err);
        })
      );

    await Promise.allSettled(emailPromises);
    await notificationClient.createBulkNotifications(notifications);

    return { checked: users.length, notified: notifications.length };
  } catch {
    return { checked: 0, notified: 0, message: 'Error checking membership expiry' };
  }
}
</file>

<file path="automation-service/src/handlers/scheduleChangeNotify.ts">
import { notificationClient, userClient } from '../clients/serviceClients';
import { AutomationEvent } from '../events/EventBus';

export async function scheduleChangeNotify(
  _cfg: Record<string, any>,
  event?: AutomationEvent
): Promise<any> {
  if (!event || event.type !== 'schedule.changed') {
    return { notified: 0, message: 'Not a schedule.changed event' };
  }

  const { staffId, oldShift, newShift, shiftName, workDate, changeType } = event.payload;

  if (!staffId) {
    return { notified: 0, message: 'No staffId in event payload' };
  }

  let staffName = 'Nhân viên';
  try {
    const user = await userClient.getUser(staffId);
    if (user?.fullName) staffName = user.fullName;
  } catch (err) {
    console.warn('[scheduleChangeNotify] Failed to fetch user:', (err as Error)?.message || err);
  }

  const shiftDisplayName = shiftName || newShift || 'Chưa xác định';

  let message = '';
  switch (changeType) {
    case 'assigned':
      message = `Bạn đã được phân ca trực ngày ${workDate}: ${shiftDisplayName}.`;
      break;
    case 'cancelled':
      message = `Ca trực ngày ${workDate} (${shiftDisplayName}) đã bị hủy.`;
      break;
    default:
      message = `Lịch trực ngày ${workDate} đã thay đổi.`;
  }

  await notificationClient.createNotification({
    userId: staffId,
    type: 'schedule_change',
    title: 'Thay đổi lịch trực',
    body: message,
    data: { staffId, oldShift, newShift, workDate, changeType },
  });

  return { notified: 1 };
}
</file>

