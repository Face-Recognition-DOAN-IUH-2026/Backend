<file path="automation-service/src/events/EventBus.ts">
import Redis from 'ioredis';
import { config } from '../config';

const CHANNEL = 'automation.events';

export type AutomationEvent = {
  type: string;
  payload: Record<string, any>;
  timestamp: string;
};

type EventHandler = (event: AutomationEvent) => Promise<void>;

export class EventBus {
  private publisher?: Redis;
  private subscriber?: Redis;
  private handlers = new Map<string, EventHandler[]>();

  async connect() {
    if (!config.redisUrl) return;
    this.publisher = new Redis(config.redisUrl);
    this.subscriber = new Redis(config.redisUrl);
    await this.subscriber.subscribe(CHANNEL);
    this.subscriber.on('message', async (_channel, raw) => {
      try {
        const event: AutomationEvent = JSON.parse(raw);
        await this.dispatch(event);
      } catch {
        // Ignore malformed messages
      }
    });
    console.log('EventBus connected to Redis');
  }

  on(eventType: string, handler: EventHandler) {
    if (!this.handlers.has(eventType)) {
      this.handlers.set(eventType, []);
    }
    this.handlers.get(eventType)!.push(handler);
  }

  async publish(event: AutomationEvent) {
    // Local dispatch
    await this.dispatch(event);
    // Redis fan-out
    if (this.publisher) {
      await this.publisher.publish(CHANNEL, JSON.stringify(event));
    }
  }

  private async dispatch(event: AutomationEvent) {
    const handlers = this.handlers.get(event.type) || [];
    const wildcardHandlers = this.handlers.get('*') || [];
    const allHandlers = [...handlers, ...wildcardHandlers];

    for (const handler of allHandlers) {
      try {
        await handler(event);
      } catch (error) {
        console.error(`EventBus handler error for ${event.type}:`, error);
      }
    }
  }
}

export const eventBus = new EventBus();
</file>

<file path="automation-service/src/handlers/bookAvailabilityNotify.ts">
import { notificationClient } from '../clients/serviceClients';
import { config } from '../config';
import { AutomationEvent } from '../events/EventBus';

export async function bookAvailabilityNotify(
  _cfg: Record<string, any>,
  event?: AutomationEvent
): Promise<any> {
  if (!event || event.type !== 'book.returned') {
    return { notified: 0, message: 'Not a book.returned event' };
  }

  const { bookId, title: bookTitle } = event.payload;

  if (!bookId) {
    return { notified: 0, message: 'No bookId in event payload' };
  }

  // Check if there are patrons waiting for this book
  // Waitlist feature not yet implemented — return gracefully
  try {
    const response = await fetch(
      `${config.services.borrowService}/borrow/internal/book/${bookId}/waitlist`,
      {
        headers: {
          'x-internal-api-key': config.internalApiKey,
          'Content-Type': 'application/json',
        },
      }
    );

    if (!response.ok) {
      return { notified: 0, message: 'No waitlist available for this book' };
    }

    const waitlist = await response.json();

    if (!Array.isArray(waitlist) || waitlist.length === 0) {
      return { notified: 0, message: 'No patrons waiting for this book' };
    }

    const notifications = waitlist.map((entry: any) => ({
      userId: entry.patron_id || entry.patronId,
      type: 'book_available',
      title: 'Sách đã có sẵn',
      body: `Cuốn "${bookTitle || 'Sách'}" đã được trả. Bạn có thể mượn ngay bây giờ!`,
      data: { bookId, title: bookTitle },
    }));

    await notificationClient.createBulkNotifications(notifications);

    return { notified: notifications.length };
  } catch {
    return { notified: 0, message: 'Waitlist feature not available' };
  }
}
</file>

<file path="automation-service/src/handlers/checkDueSoonBorrows.ts">
import { borrowClient, notificationClient, userClient, emailClient } from '../clients/serviceClients';

export async function checkDueSoonBorrows(config: Record<string, any>): Promise<any> {
  const daysBefore = parseInt(config?.days_before) || 3;
  const dueSoon = await borrowClient.getDueSoonBorrows(daysBefore);

  if (!dueSoon || !Array.isArray(dueSoon) || dueSoon.length === 0) {
    return { checked: 0, notified: 0, message: 'No due-soon borrows' };
  }

  const notifications: Array<{ userId: string; type: string; title: string; body: string; data: Record<string, any> }> = [];

  for (const record of dueSoon) {
    const patronId = record.patron_id || record.patronId;
    if (!patronId) continue;

    let patronName = 'Bạn';
    try {
      const patron = await userClient.getUser(patronId);
      if (patron?.fullName) patronName = patron.fullName;
    } catch {}

    const bookTitle = record.title || record.book_title || record.book?.title || 'Sách';
    const dueDate = record.due_at || record.dueAt;
    const daysLeft = dueDate
      ? Math.max(0, Math.ceil((new Date(dueDate).getTime() - Date.now()) / (1000 * 60 * 60 * 24)))
      : 0;

    notifications.push({
      userId: patronId,
      type: 'due_soon_reminder',
      title: 'Sách sắp đến hạn trả',
      body: `${patronName}, cuốn "${bookTitle}" sẽ hết hạn trả vào ngày ${dueDate ? new Date(dueDate).toLocaleDateString('vi-VN') : 'không xác định'} (còn ${daysLeft} ngày). Vui lòng trả sách đúng hạn.`,
      data: {
        bookId: record.book_id || record.bookId,
        borrowRecordId: record.id,
        dueAt: dueDate,
        daysLeft,
      },
    });
  }

  if (notifications.length > 0) {
    await notificationClient.createBulkNotifications(notifications);
  }

  return { checked: dueSoon.length, notified: notifications.length };
}
</file>

<file path="automation-service/src/handlers/checkStaffAbsence.ts">
import { scheduleClient, notificationClient, userClient } from '../clients/serviceClients';

export async function checkStaffAbsence(config: Record<string, any>): Promise<any> {
  let assignments;
  try {
    assignments = await scheduleClient.getTodayAssignments();
  } catch {
    return { checked: 0, alerted: 0, message: 'Failed to fetch schedule' };
  }

  const assignmentList = Array.isArray(assignments) ? assignments : (assignments as any)?.items || [];

  if (assignmentList.length === 0) {
    return { checked: 0, alerted: 0, message: 'No assignments today' };
  }

  const now = new Date();
  const absentStaff: Array<{ staffId: string; shiftName: string; scheduledTime: string }> = [];

  for (const assignment of assignmentList) {
    const status = assignment.status;
    const staffId = assignment.staff_id || assignment.staffId;

    // If scheduled but not confirmed and shift has started
    if (status === 'scheduled' && assignment.shift_start) {
      const shiftStart = new Date(assignment.shift_start);
      const gracePeriod = 15 * 60 * 1000; // 15 minutes grace

      if (now.getTime() > shiftStart.getTime() + gracePeriod) {
        absentStaff.push({
          staffId,
          shiftName: assignment.shift_name || assignment.shiftName || 'Ca trực',
          scheduledTime: assignment.shift_start,
        });
      }
    }
  }

  if (absentStaff.length === 0) {
    return { checked: assignmentList.length, alerted: 0, message: 'All staff present or within grace period' };
  }

  // Get admin user IDs dynamically
  let adminUserIds: string[] = config.admin_user_ids || [];

  if (adminUserIds.length === 0) {
    try {
      const admins = await userClient.getUsersByRole('admin');
      adminUserIds = Array.isArray(admins) ? admins.map((u: any) => u.id) : [];
    } catch {}
  }

  if (adminUserIds.length > 0) {
    const absentList = absentStaff
      .map((s) => `- ${s.staffId} (${s.shiftName} lúc ${s.scheduledTime})`)
      .join('\n');

    const notifications = adminUserIds.map((userId) => ({
      userId,
      type: 'anomaly_alert',
      title: `Cảnh báo: ${absentStaff.length} nhân viên vắng mặt`,
      body: `Nhân viên không check-in sau 15 phút:\n${absentList}`,
      data: { absentStaff, date: new Date().toISOString().split('T')[0] },
    }));

    await notificationClient.createBulkNotifications(notifications);
  }

  return { checked: assignmentList.length, alerted: absentStaff.length, absentStaff };
}
</file>

<file path="automation-service/src/handlers/dailyStatsReport.ts">
import { accessClient, borrowClient, scheduleClient, notificationClient, userClient } from '../clients/serviceClients';

export async function dailyStatsReport(config: Record<string, any>): Promise<any> {
  const today = new Date().toISOString().split('T')[0];

  // Collect data in parallel
  const [accessStats, activePatrons, activeBorrowers, scheduleAssignments, books] = await Promise.allSettled([
    accessClient.getStats(),
    accessClient.getActivePatrons(),
    borrowClient.getActiveBorrowers(),
    scheduleClient.getTodayAssignments(),
    borrowClient.getBooks(0, 10),
  ]);

  const stats = {
    date: today,
    access: {
      activeInside: accessStats.status === 'fulfilled' ? (accessStats.value as any)?.active_inside || 0 : 0,
      todayEntries: accessStats.status === 'fulfilled' ? (accessStats.value as any)?.today_entries || 0 : 0,
      todayExits: accessStats.status === 'fulfilled' ? (accessStats.value as any)?.today_exits || 0 : 0,
    },
    borrows: {
      activeBorrowers: activeBorrowers.status === 'fulfilled' ? (activeBorrowers.value as any)?.total || 0 : 0,
    },
    schedule: {
      staffOnDuty: scheduleAssignments.status === 'fulfilled'
        ? Array.isArray(scheduleAssignments.value) ? scheduleAssignments.value.length : (scheduleAssignments.value as any)?.total || 0
        : 0,
    },
    books: {
      total: books.status === 'fulfilled' ? (books.value as any)?.total || 0 : 0,
    },
  };

  // Build report message
  const lines = [
    `Báo cáo thống kê thư viện ngày ${today}`,
    ``,
    `Lưu lượng truy cập:`,
    `  - Đang trong thư viện: ${stats.access.activeInside}`,
    `  - Lượt vào hôm nay: ${stats.access.todayEntries}`,
    `  - Lượt ra hôm nay: ${stats.access.todayExits}`,
    ``,
    `Mượn trả:`,
    `  - Đang mượn sách: ${stats.borrows.activeBorrowers}`,
    ``,
    `Nhân viên:`,
    `  - Đang trực: ${stats.schedule.staffOnDuty}`,
    ``,
    `Thư viện:`,
    `  - Tổng đầu sách: ${stats.books.total}`,
  ];

  const reportBody = lines.join('\n');

  // Get admin user IDs dynamically from config or user-service
  let adminUserIds: string[] = config.admin_user_ids || [];

  if (adminUserIds.length === 0) {
    try {
      const admins = await userClient.getUsersByRole('admin');
      adminUserIds = Array.isArray(admins) ? admins.map((u: any) => u.id) : [];
    } catch {
      // fallback: try staff as well
      try {
        const staff = await userClient.getUsersByRole('staff');
        adminUserIds = Array.isArray(staff) ? staff.map((u: any) => u.id) : [];
      } catch {}
    }
  }

  if (adminUserIds.length > 0) {
    const notifications = adminUserIds.map((userId) => ({
      userId,
      type: 'daily_report',
      title: `Báo cáo hàng ngày - ${today}`,
      body: reportBody,
      data: stats,
    }));
    await notificationClient.createBulkNotifications(notifications);
  }

  return { stats, notified: adminUserIds.length };
}
</file>

<file path="automation-service/src/handlers/fineNotification.ts">
import { notificationClient, userClient, emailClient } from '../clients/serviceClients';
import { AutomationEvent } from '../events/EventBus';

export async function fineNotification(_config: Record<string, any>, event?: AutomationEvent): Promise<any> {
  if (!event || event.type !== 'fine.incurred') {
    return { skipped: true, message: 'Not a fine.incurred event' };
  }

  const { patronId, bookTitle, fineAmount, daysOverdue, borrowRecordId } = event.payload;

  if (!patronId || !fineAmount) {
    return { skipped: true, message: 'Missing patronId or fineAmount' };
  }

  let patronName = 'Bạn';
  let patronEmail = '';
  try {
    const patron = await userClient.getUser(patronId);
    if (patron?.fullName) patronName = patron.fullName;
    if (patron?.email) patronEmail = patron.email;
  } catch {}

  await notificationClient.createNotification({
    userId: patronId,
    type: 'fine_notice',
    title: 'Phí phạt trễ hạn',
    body: `${patronName}, bạn bị phạt ${fineAmount.toLocaleString('vi-VN')}đ vì trả "${bookTitle || 'sách'}" trễ ${daysOverdue || 0} ngày.`,
    data: {
      bookTitle,
      fineAmount,
      daysOverdue,
      borrowRecordId,
    },
  });

  // Send fine email
  if (patronEmail) {
    try {
      await emailClient.sendFineEmail(patronEmail, bookTitle || 'Sách', fineAmount, daysOverdue || 0);
    } catch (err) {
      console.error(`[fineNotification] Failed to send fine email to ${patronEmail}:`, err);
    }
  }

  return { notified: 1, patronId, fineAmount };
}
