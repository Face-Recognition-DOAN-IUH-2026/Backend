<file path="user-service/src/services/AuthService.ts">
import bcrypt from 'bcryptjs';
import jwt from 'jsonwebtoken';
import axios from 'axios';
import { User, UserRole } from '../entities/User.entity';
import { UserRepository } from '../repositories/UserRepository';
import { RedisService } from './RedisService';
import { config } from '../config';
import {
  RegisterDto,
  LoginDto,
  AuthResponse,
  TokenPayload,
  UserPublicDto,
} from '../dto';
import { UnauthorizedError, ForbiddenError, ConflictError, NotFoundError, BadRequestError } from '../errors';

export class AuthService {
  constructor(
    private userRepo: UserRepository,
    private redis: RedisService,
  ) {}

  private normalizeEmail(email: string): string {
    return String(email || '').trim().toLowerCase();
  }

  async register(dto: RegisterDto): Promise<AuthResponse> {
    if (!dto.email || dto.email.trim() === '') {
      throw new BadRequestError('Email is required');
    }
    if (!dto.password || dto.password.trim() === '') {
      throw new BadRequestError('Password is required');
    }
    if (dto.password && dto.password.length < 6) {
      throw new BadRequestError('Password must be at least 6 characters');
    }
    dto.email = this.normalizeEmail(dto.email);
    const existing = await this.userRepo.findByEmail(dto.email);
    if (existing) throw new ConflictError('Email already registered');

    const DEFAULT_PASSWORD = '11111111';
    const useAutoPassword = !dto.password;
    const passwordToHash = dto.password ?? DEFAULT_PASSWORD;
    const passwordHash = await bcrypt.hash(passwordToHash, 10);

    const userData: Partial<User> = {
      email: dto.email,
      passwordHash,
      fullName: dto.fullName ?? null,
      role: dto.role ?? 'user',
      passwordAutoGenerated: useAutoPassword,
    };

    if (dto.role === UserRole.PATRON) {
      const dupCode = dto.studentCode
        ? await this.userRepo.findByStudentCode(dto.studentCode)
        : null;
      if (dupCode) throw new ConflictError('Student code already exists');

      Object.assign(userData, {
        studentCode: dto.studentCode ?? null,
        className: dto.className ?? null,
        course: dto.course ?? null,
        permanentAddress: dto.permanentAddress ?? null,
        cardNumber: dto.studentCode ? `THV-${dto.studentCode}` : null,
        membershipExpiry: dto.membershipExpiry ?? this.calculateExpiryFromCourse(dto.course),
        issueDate: new Date().toISOString().split('T')[0],
      });
    }

    const user = await this.userRepo.create(userData);
    return this.buildAuthResponse(user);
  }

  async login(dto: LoginDto): Promise<AuthResponse> {
    let user: User | null = null;

    if (dto.studentCode) {
      user = await this.userRepo.findByStudentCode(dto.studentCode);
    } else if (dto.email) {
      dto.email = this.normalizeEmail(dto.email);
      user = await this.userRepo.findByEmail(dto.email);
    }

    if (!user) throw new UnauthorizedError('Invalid credentials');

    const valid = await bcrypt.compare(dto.password, user.passwordHash);
    if (!valid) throw new UnauthorizedError('Invalid credentials');

    if (user.status !== 'active') throw new ForbiddenError('Account is disabled');

    if (user.role === UserRole.PATRON && user.membershipExpiry) {
      const expiry = new Date(user.membershipExpiry);
      if (expiry < new Date()) throw new ForbiddenError('Membership has expired');
    }

    return this.buildAuthResponse(user);
  }

  async getUserById(id: string): Promise<UserPublicDto> {
    const user = await this.userRepo.findById(id);
    if (!user) throw new UnauthorizedError('User not found');
    return this.toPublic(user);
  }

  async refreshToken(refreshTokenStr: string): Promise<{ access_token: string; token_type: string }> {
    const payload = this.verifyToken(refreshTokenStr, 'refresh');
    const user = await this.userRepo.findById(payload.userId);
    if (!user) throw new UnauthorizedError('User not found');
    if (user.status !== 'active') throw new ForbiddenError('Account is disabled');
    if (user.role === UserRole.PATRON && user.membershipExpiry) {
      const expiry = new Date(user.membershipExpiry);
      if (expiry < new Date()) throw new ForbiddenError('Membership has expired');
    }
    const accessToken = this.generateToken(
      { userId: user.id, email: user.email, role: user.role, fullName: user.fullName },
      'access',
    );
    return { access_token: accessToken, token_type: 'bearer' };
  }

  async forgotPassword(email: string): Promise<void> {
    const normalizedEmail = email.trim().toLowerCase();
    console.log(`[ForgotPassword] Looking up email: ${normalizedEmail}`);
    const user = await this.userRepo.findByEmail(normalizedEmail);

    if (!user) {
      console.log(`[ForgotPassword] User not found for email: ${normalizedEmail}`);
      throw new NotFoundError('Khong tim thay tai khoan voi email nay');
    }

    console.log(`[ForgotPassword] User found: ${user.id}, status: ${user.status}`);
    if (user.status !== 'active') {
      throw new ForbiddenError('Tai khoan da bi khoa');
    }

    const code = Math.floor(100000 + Math.random() * 900000).toString();

    await this.redis.setPasswordResetCode(normalizedEmail, code);
    console.log(`[ForgotPassword] Code stored in Redis, calling notification-service at: ${config.notificationServiceUrl}`);

    try {
      await axios.post(
        `${config.notificationServiceUrl}/internal/send-password-reset`,
        { toEmail: normalizedEmail, code },
        { headers: { 'x-internal-api-key': config.internalApiKey } }
      );
      console.log(`[ForgotPassword] Email sent successfully to ${normalizedEmail}`);
    } catch (e: any) {
      console.error('[ForgotPassword] Failed to send email:', e.response?.status, e.response?.data || e.message);
      throw new Error('Khong the gui email, vui long thu lai sau');
    }
  }

  async verifyResetCode(email: string, code: string): Promise<boolean> {
    const storedCode = await this.redis.getPasswordResetCode(email.toLowerCase());
    if (!storedCode || storedCode !== code) {
      return false;
    }
    return true;
  }

  async resetPassword(email: string, code: string, newPassword: string): Promise<void> {
    const isValid = await this.verifyResetCode(email, code);
    if (!isValid) {
      throw new UnauthorizedError('Ma reset khong hop le hoac da het han');
    }

    const user = await this.userRepo.findByEmail(email.toLowerCase());
    if (!user) {
      throw new NotFoundError('Khong tim thay tai khoan');
    }

    const passwordHash = await bcrypt.hash(newPassword, 10);
    await this.userRepo.update(user.id, { passwordHash, passwordAutoGenerated: false });

    await this.redis.deletePasswordResetCode(email.toLowerCase());
  }

  private calculateExpiryFromCourse(course: string | undefined): string {
    if (!course) return '2099-12-31';
    const rangeMatch = course.match(/(\d{4})\s*[-–]\s*(\d{4})/);
    if (rangeMatch) {
      const endYear = parseInt(rangeMatch[2], 10);
      return `${endYear}-12-31`;
    }
    const singleMatch = course.match(/(\d{4})/);
    if (singleMatch) {
      const year = parseInt(singleMatch[1], 10);
      return `${year}-12-31`;
    }
    return '2099-12-31';
  }

  verifyToken(token: string, expectedType?: 'access' | 'refresh'): TokenPayload {
    let secret = expectedType === 'refresh' ? config.jwtRefreshSecret : config.jwtSecret;
    try {
      const decoded: any = jwt.verify(token, secret);
      if (expectedType && decoded.typ !== expectedType) {
        throw new Error(`Invalid token type: expected ${expectedType}`);
      }
      return {
        userId: decoded.sub,
        email: decoded.email || '',
        role: decoded.roles?.[0] || 'user',
        fullName: decoded.full_name || null,
      };
    } catch (err: any) {
      if (err.message?.includes('Invalid token type')) throw err;
      try {
        const decoded: any = jwt.verify(token, config.jwtRefreshSecret);
        if (expectedType && decoded.typ !== expectedType) {
          throw new Error(`Invalid token type: expected ${expectedType}`);
        }
        return {
          userId: decoded.sub,
          email: decoded.email || '',
          role: decoded.roles?.[0] || 'user',
          fullName: decoded.full_name || null,
        };
      } catch {
        throw new UnauthorizedError('Invalid or expired token');
      }
    }
  }

  private buildAuthResponse(user: User): AuthResponse {
    const payload: TokenPayload = {
      userId: user.id,
      email: user.email,
      role: user.role,
      fullName: user.fullName,
    };
    return {
      access_token: this.generateToken(payload, 'access'),
      refresh_token: this.generateToken(payload, 'refresh'),
      token_type: 'bearer',
      user: this.toPublic(user),
    };
  }

  private generateToken(payload: TokenPayload, type: 'access' | 'refresh'): string {
    const now = Math.floor(Date.now() / 1000);
    const exp =
      type === 'refresh'
        ? now + config.jwtRefreshExpiresDays * 86400
        : now + config.jwtAccessExpiresMinutes * 60;
    const secret = type === 'refresh' ? config.jwtRefreshSecret : config.jwtSecret;

    const jwtPayload: Record<string, any> = {
      sub: payload.userId,
      email: payload.email,
      iss: config.jwtIssuer,
      aud: config.jwtAudience,
      exp,
      iat: now,
      roles: [payload.role],
      typ: type,
    };
    if (payload.fullName) jwtPayload.full_name = payload.fullName;

    return jwt.sign(jwtPayload, secret);
  }

  toPublic(user: User): UserPublicDto {
    const dto: UserPublicDto = {
      id: user.id,
      email: user.email,
      fullName: user.fullName,
      role: user.role,
    };
    if (user.studentCode) dto.studentCode = user.studentCode;
    if (user.className) dto.className = user.className;
    if (user.course) dto.course = user.course;
    if (user.permanentAddress) dto.permanentAddress = user.permanentAddress;
    if (user.identityNumber) dto.identityNumber = user.identityNumber;
    if (user.phone) dto.phone = user.phone;
    if (user.cardNumber) dto.cardNumber = user.cardNumber;
    if (user.issueDate) dto.issueDate = user.issueDate;
    if (user.membershipExpiry) dto.membershipExpiry = user.membershipExpiry;
    if (user.avatarUrl) dto.avatarUrl = user.avatarUrl;
    dto.status = user.status;
    dto.currentStatus = user.currentStatus;
    if (user.createdAt) dto.createdAt = user.createdAt.toISOString();
    if (user.updatedAt) dto.updatedAt = user.updatedAt.toISOString();
    return dto;
  }
}
</file>

<file path="user-service/src/services/UserService.ts">
import { AppDataSource } from '../data-source';
import { User } from '../entities/User.entity';
import { UserRepository } from '../repositories/UserRepository';
import { PatronRepository } from '../repositories/PatronRepository';
import { RedisService } from './RedisService';
import { CloudinaryService } from './CloudinaryService';
import { UserPublicDto } from '../dto';
import { NotFoundError, BadRequestError } from '../errors';

export class UserService {
  constructor(
    private userRepo: UserRepository,
    private patronRepo: PatronRepository,
    private redis: RedisService,
  ) {}

  async getAllUsers(): Promise<{ users: UserPublicDto[]; total: number }> {
    const [users, total] = await this.userRepo.findAll();
    return {
      users: users.map(this.toPublic),
      total,
    };
  }

  async getUserById(id: string): Promise<any> {
    const user = await this.userRepo.findById(id);
    if (!user) throw new NotFoundError('User not found');
    return {
      id: user.id,
      email: user.email,
      full_name: user.fullName,
      role: user.role,
      student_code: user.studentCode,
      class_name: user.className,
      phone: user.phone,
      card_number: user.cardNumber,
      status: user.status,
      current_status: user.currentStatus,
      last_entry_at: user.lastEntryAt,
      last_entry_camera: user.lastEntryCamera,
      membership_expiry: user.membershipExpiry,
      avatar_url: user.avatarUrl,
      created_at: user.createdAt,
    };
  }

  async updateAvatar(userId: string, buffer: Buffer, mimeType: string): Promise<string> {
    const user = await this.userRepo.findById(userId);
    if (!user) throw new NotFoundError('User not found');

    const cloudinarySvc = new CloudinaryService();
    const avatarUrl = await cloudinarySvc.uploadAvatar(userId, buffer, mimeType);
    await this.userRepo.update(userId, { avatarUrl });
    return avatarUrl;
  }

  async deleteAvatar(userId: string): Promise<void> {
    const user = await this.userRepo.findById(userId);
    if (!user) throw new NotFoundError('User not found');

    const cloudinarySvc = new CloudinaryService();
    await cloudinarySvc.deleteAvatar(userId);
    await this.userRepo.update(userId, { avatarUrl: null });
  }

  async updateAccessStatus(
    id: string,
    currentStatus: 'inside' | 'outside',
    cameraId?: string | null,
  ): Promise<any> {
    const user = await this.userRepo.findById(id);
    if (!user) throw new NotFoundError('User not found');

    const updates: any = { currentStatus };
    if (currentStatus === 'inside') {
      updates.lastEntryAt = new Date();
      updates.lastEntryCamera = cameraId ?? null;
    }

    const updated = await this.userRepo.update(id, updates);
    return this.getUserById(updated!.id);
  }

  async deleteUser(id: string): Promise<{ deleted: boolean; id: string; soft: boolean }> {
    const user = await this.userRepo.findById(id);
    if (!user) throw new NotFoundError('User not found');

    const queryRunner = AppDataSource.createQueryRunner();
    await queryRunner.connect();
    await queryRunner.startTransaction();

    try {
      await queryRunner.manager.update(User, id, { status: 'deleted' as any });
      await this.redis.publishUserDeleted(id, user.email);
      await queryRunner.commitTransaction();
    } catch (error) {
      await queryRunner.rollbackTransaction();
      throw error;
    } finally {
      await queryRunner.release();
    }

    return { deleted: true, id, soft: true };
  }

  async restoreUser(id: string): Promise<UserPublicDto> {
    const user = await this.userRepo.findById(id);
    if (!user) throw new NotFoundError('User not found');

    if (user.status !== 'deleted') {
      throw new BadRequestError('User is not deleted');
    }

    await this.userRepo.update(id, { status: 'active' });
    this.redis.publishUserUpdated(id, user.email);

    return this.getUserById(id);
  }

  private toPublic(user: any): UserPublicDto {
    return {
      id: user.id,
      email: user.email,
      fullName: user.fullName,
      role: user.role,
      status: user.status,
      avatarUrl: user.avatarUrl,
    };
  }
}
</file>

<file path="face-recognition-service/api/routers/face.py">
from __future__ import annotations

import asyncio
import base64
import uuid as _uuid

from fastapi import APIRouter, Depends, File, Form, HTTPException, UploadFile, status
from fastapi.concurrency import run_in_threadpool

from api.dependencies import get_current_user, require_role
from core.schemas import (
    EnrollmentResult,
    IdentificationResult,
    LivenessResult,
    VerificationResult,
)
from infra.cooldown import CooldownService
from infra.redis_cache import redis_client
from worker.tasks import (
    _upload_temp_frame,
    delete_user_task,
    enroll_task,
    identify_task,
    liveness_task,
    verify_task,
    batch_enroll_task,
)

router = APIRouter(prefix="/face", tags=["face"])
cooldown = CooldownService()


async def _store_temp_frame(raw: bytes) -> str:
    """Upload to MinIO and also store in Redis for fast worker access."""
    object_key = await run_in_threadpool(_upload_temp_frame, raw, str(_uuid.uuid4()))
    redis_client.setex(f"temp_frame:{object_key}", 120, raw)
    return object_key


@router.post("/enroll", response_model=EnrollmentResult, status_code=status.HTTP_410_GONE)
async def enroll(
    file: UploadFile = File(...),
    consent_given: bool = Form(True),
    angle: str = Form("frontal"),
    current_user: dict = Depends(get_current_user),
):
    raise HTTPException(
        status_code=status.HTTP_410_GONE,
        detail="Single-image enrollment is no longer supported. Use /face/enroll-batch with 4 angles."
    )


@router.post("/enroll-batch", response_model=EnrollmentResult, status_code=status.HTTP_202_ACCEPTED)
async def enroll_batch(
    frontal: UploadFile = File(...),
    right: UploadFile = File(...),
    left: UploadFile = File(...),
    down: UploadFile = File(...),
    consent_given: bool = Form(True),
    current_user: dict = Depends(get_current_user),
):
    if not consent_given:
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST, detail="Consent not given"
        )
    raw_frontal = await frontal.read()
    raw_right = await right.read()
    raw_left = await left.read()
    raw_down = await down.read()
    try:
        keys = await asyncio.gather(
            _store_temp_frame(raw_frontal),
            _store_temp_frame(raw_right),
            _store_temp_frame(raw_left),
            _store_temp_frame(raw_down),
        )
    except Exception as exc:
        raise HTTPException(status_code=status.HTTP_500_INTERNAL_SERVER_ERROR, detail=f"Failed to store temp frames: {exc}")
    task = batch_enroll_task.delay(user_id=current_user["id"], object_keys=keys)
    return EnrollmentResult(job_id=task.id)


@router.post("/verify", response_model=VerificationResult, status_code=status.HTTP_202_ACCEPTED)
async def verify(
    file: UploadFile = File(...),
    target_user_id: str = Form(...),
    consent_given: bool = Form(True),
    current_user: dict = Depends(get_current_user),
):
    if not consent_given:
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST, detail="Consent not given"
        )
    if not await cooldown.acquire(f"verify:{current_user['id']}"):
        raise HTTPException(
            status_code=status.HTTP_429_TOO_MANY_REQUESTS, detail="Cooldown active"
        )
    raw = await file.read()
    object_key = await _store_temp_frame(raw)
    task = verify_task.delay(user_id=target_user_id, object_key=object_key)
    return VerificationResult(job_id=task.id)


@router.post("/identify", response_model=IdentificationResult, status_code=status.HTTP_202_ACCEPTED)
async def identify(
    file: UploadFile = File(...),
    consent_given: bool = Form(True),
    current_user: dict = Depends(get_current_user),
):
    if not consent_given:
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST, detail="Consent not given"
        )
    if not await cooldown.acquire(f"identify:{current_user['id']}"):
        raise HTTPException(
            status_code=status.HTTP_429_TOO_MANY_REQUESTS, detail="Cooldown active"
        )
    raw = await file.read()
    object_key = await _store_temp_frame(raw)
    task = identify_task.delay(object_key=object_key)
    return IdentificationResult(job_id=task.id)


@router.post("/liveness", response_model=LivenessResult, status_code=status.HTTP_202_ACCEPTED)
async def liveness(
    file: UploadFile = File(...),
    consent_given: bool = Form(True),
    current_user: dict = Depends(get_current_user),
):
    if not consent_given:
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST, detail="Consent not given"
        )
    if not await cooldown.acquire(f"liveness:{current_user['id']}"):
        raise HTTPException(
            status_code=status.HTTP_429_TOO_MANY_REQUESTS, detail="Cooldown active"
        )
    raw = await file.read()
    object_key = await _store_temp_frame(raw)
    task = liveness_task.delay(object_key=object_key)
    return LivenessResult(job_id=task.id)


@router.delete("/{user_id}", status_code=status.HTTP_202_ACCEPTED)
async def delete_face(
    user_id: str,
    current_user: dict = Depends(require_role("admin")),
):
    task = delete_user_task.delay(user_id=user_id)
    return {"job_id": task.id}
</file>

