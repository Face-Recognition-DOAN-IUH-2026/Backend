<file path="automation-service/src/handlers/expireWaitlistNotifications.ts">
import { borrowClient, notificationClient } from '../clients/serviceClients';

export async function expireWaitlistNotifications(
  cfg: Record<string, any>,
  _event?: any
): Promise<any> {
  const expiryHours = cfg.expiryHours || 24;

  try {
    const expired = await borrowClient.getExpiredWaitlist(expiryHours);

    if (!Array.isArray(expired) || expired.length === 0) {
      return { expired: 0, advanced: 0, message: 'No expired notifications' };
    }

    let advanced = 0;

    const results = await Promise.allSettled(
      expired.map(async (entry: any) => {
        const advanceData = await borrowClient.advanceWaitlist(entry.id);

        if (advanceData?.next) {
          await notificationClient.createNotification({
            userId: advanceData.next.patron_id,
            type: 'book_available',
            title: 'Sách đã có sẵn',
            body: `Cuốn sách bạn đang chờ đã có sẵn. Bạn có thể mượn ngay bây giờ!`,
            data: { bookId: advanceData.next.book_id },
          });

          await borrowClient.batchNotifyWaitlist([advanceData.next.id]).catch((err: any) => {
            console.warn('[expireWaitlistNotifications] Failed to batch notify waitlist:', (err as Error)?.message || err);
          });
          advanced++;
        }
      })
    );

    const failCount = results.filter(r => r.status === 'rejected').length;
    if (failCount > 0) {
      console.warn(`[expireWaitlistNotifications] ${failCount}/${expired.length} waitlist advancements failed`);
    }

    return { expired: expired.length, advanced };
  } catch {
    return { expired: 0, advanced: 0, message: 'Expiry check failed' };
  }
}
</file>

<file path="automation-service/src/handlers/membershipExpiryCheck.ts">
import { userClient, notificationClient, emailClient } from '../clients/serviceClients';

export async function membershipExpiryCheck(taskConfig: Record<string, any>): Promise<any> {
  const daysBefore = taskConfig.days_before || 7;

  try {
    const users = await userClient.getExpiringMemberships(daysBefore);

    if (!Array.isArray(users) || users.length === 0) {
      return { checked: 0, notified: 0, message: 'No expiring memberships' };
    }

    const notifications = users.map((user: any) => ({
      userId: user.id,
      type: 'membership_expiry',
      title: 'Thẻ thư viện sắp hết hạn',
      body: `Thẻ thư viện của bạn sẽ hết hạn vào ngày ${new Date(user.membershipExpiry).toLocaleDateString('vi-VN')}. Vui lòng gia hạn tại quầy thủ thư.`,
      data: { expiryDate: user.membershipExpiry, daysLeft: daysBefore },
    }));

    const emailPromises = users
      .filter((user: any) => user.email)
      .map((user: any) =>
        emailClient.sendMembershipExpiryEmail(user.email, user.membershipExpiry).catch((err: any) => {
          console.error(`[membershipExpiryCheck] Failed to send expiry email to ${user.email}:`, err);
        })
      );

    await Promise.allSettled(emailPromises);
    await notificationClient.createBulkNotifications(notifications);

    return { checked: users.length, notified: notifications.length };
  } catch {
    return { checked: 0, notified: 0, message: 'Error checking membership expiry' };
  }
}
