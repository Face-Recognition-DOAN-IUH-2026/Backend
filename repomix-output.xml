    to: req.query.to as string | undefined,
    staffId: req.query.staff_id as string | undefined,
    zoneId: req.query.zone_id as string | undefined,
    shiftId: req.query.shift_id as string | undefined,
    status: req.query.status as string | undefined,
    page: req.query.page ? parseInt(req.query.page as string, 10) : undefined,
    limit: req.query.limit ? parseInt(req.query.limit as string, 10) : undefined,
  }));
}));
/**
 * @swagger
 * /schedules/assignments:
 *   post:
 *     summary: Create an assignment
 *     tags: [Schedule]
 *     security:
 *       - bearerAuth: []
 *     requestBody:
 *       required: true
 *       content:
 *         application/json:
 *           schema:
 *             type: object
 *             properties:
 *               staffId:
 *                 type: string
 *                 format: uuid
 *               shiftId:
 *                 type: string
 *                 format: uuid
 *               zoneId:
 *                 type: string
 *                 format: uuid
 *               workDate:
 *                 type: string
 *                 format: date
 *               note:
 *                 type: string
 *               status:
 *                 type: string
 *     responses:
 *       201:
 *         description: Assignment created
 */
router.post('/assignments', requireRole('admin'), asyncHandler(async (req, res) => {
  const force = req.query.force === 'true';
  res.status(201).json(await scheduleService.createAssignment(req.user!.userId, assignmentSchema.parse(req.body), force));
}));
router.post('/assignments/bulk', requireRole('admin'), asyncHandler(async (req, res) => {
  const force = req.query.force === 'true';
  res.status(201).json(await scheduleService.createAssignmentsBulk(req.user!.userId, z.array(assignmentSchema).parse(req.body), force));
}));

/**
 * @swagger
 * /schedules/assignments/week:
 *   delete:
 *     summary: Cancel all future assignments in a date range (bulk delete week)
 *     tags: [Schedule]
 *     security:
 *       - bearerAuth: []
 *     requestBody:
 *       required: true
 *       content:
 *         application/json:
 *           schema:
 *             type: object
 *             required: [from, to]
 *             properties:
 *               from:
 *                 type: string
 *                 format: date
 *               to:
 *                 type: string
 *                 format: date
 *               notify:
 *                 type: boolean
 *     responses:
 *       200:
 *         description: Assignments cancelled
 */
router.delete('/assignments/week', requireRole('admin'), asyncHandler(async (req, res) => {
  const { from, to, notify } = z.object({
    from: z.string().regex(/^\d{4}-\d{2}-\d{2}$/),
    to: z.string().regex(/^\d{4}-\d{2}-\d{2}$/),
    notify: z.boolean().optional().default(false),
  }).parse(req.body);
  res.json(await scheduleService.deleteWeekAssignments(req.user!.userId, from, to, notify));
}));

/**
 * @swagger
 * /schedules/assignments/{id}:
 *   put:
 *     summary: Update an assignment
 *     tags: [Schedule]
 *     security:
 *       - bearerAuth: []
 *     parameters:
 *       - in: path
 *         name: id
 *         required: true
 *         schema:
 *           type: string
 *           format: uuid
 *     requestBody:
 *       required: true
 *       content:
 *         application/json:
 *           schema:
 *             type: object
 *             properties:
 *               staffId:
 *                 type: string
 *                 format: uuid
 *               shiftId:
 *                 type: string
 *                 format: uuid
 *               zoneId:
 *                 type: string
 *                 format: uuid
 *               workDate:
 *                 type: string
 *                 format: date
 *               note:
 *                 type: string
 *               status:
 *                 type: string
 *     responses:
 *       200:
 *         description: Assignment updated
 */
router.put('/assignments/:id', requireRole('admin'), asyncHandler(async (req, res) => {
  const { id } = idParam.parse(req.params);
  const force = req.query.force === 'true';
  res.json(await scheduleService.updateAssignment(req.user!.userId, id, assignmentPatchSchema.parse(req.body), force));
}));
/**
 * @swagger
 * /schedules/assignments/{id}/move:
 *   post:
 *     summary: Move an assignment
 *     tags: [Schedule]
 *     security:
 *       - bearerAuth: []
 *     parameters:
 *       - in: path
 *         name: id
 *         required: true
 *         schema:
 *           type: string
 *           format: uuid
 *     requestBody:
 *       required: true
 *       content:
 *         application/json:
 *           schema:
 *             type: object
 *             properties:
 *               staffId:
 *                 type: string
 *                 format: uuid
 *               shiftId:
 *                 type: string
 *                 format: uuid
 *               zoneId:
 *                 type: string
 *                 format: uuid
 *               workDate:
 *                 type: string
 *                 format: date
 *               note:
 *                 type: string
 *               status:
 *                 type: string
 *     responses:
 *       200:
 *         description: Assignment moved
 */
router.post('/assignments/:id/move', requireRole('admin'), asyncHandler(async (req, res) => {
  const { id } = idParam.parse(req.params);
  res.json(await scheduleService.moveAssignment(req.user!.userId, id, assignmentPatchSchema.parse(req.body)));
}));
/**
 * @swagger
 * /schedules/assignments/{id}:
 *   delete:
 *     summary: Delete an assignment
 *     tags: [Schedule]
 *     security:
 *       - bearerAuth: []
 *     parameters:
 *       - in: path
 *         name: id
 *         required: true
 *         schema:
 *           type: string
 *           format: uuid
 *     responses:
 *       200:
 *         description: Assignment deleted
 */
router.delete('/assignments/:id', requireRole('admin'), asyncHandler(async (req, res) => {
  const { id } = idParam.parse(req.params);
  res.json(await scheduleService.deleteAssignment(req.user!.userId, id));
}));

/**
 * @swagger
 * /schedules/me:
 *   get:
 *     summary: Get current user schedule
 *     tags: [Schedule]
 *     security:
 *       - bearerAuth: []
 *     parameters:
 *       - in: query
 *         name: from
 *         schema:
 *           type: string
 *           format: date
 *       - in: query
 *         name: to
 *         schema:
 *           type: string
 *           format: date
 *     responses:
 *       200:
 *         description: Current user schedule retrieved
 */
router.get('/me', auth, asyncHandler(async (req, res) => {
  res.json(await scheduleService.listMine(req.user!.userId, req.query.from as string | undefined, req.query.to as string | undefined));
}));
/**
 * @swagger
 * /schedules/assignments/{id}/confirm:
 *   post:
 *     summary: Confirm an assignment
 *     tags: [Schedule]
 *     security:
 *       - bearerAuth: []
 *     parameters:
 *       - in: path
 *         name: id
 *         required: true
 *         schema:
 *           type: string
 *           format: uuid
 *     responses:
 *       200:
 *         description: Assignment confirmed
 */
router.post('/assignments/:id/confirm', auth, asyncHandler(async (req, res) => {
  const { id } = idParam.parse(req.params);
  res.json(await scheduleService.confirmAssignment(req.user!.userId, id));
}));
/**
 * @swagger
 * /schedules/assignments/{id}/check-in:
 *   post:
 *     summary: Check in to an assignment
 *     tags: [Schedule]
 *     security:
 *       - bearerAuth: []
 *     parameters:
 *       - in: path
 *         name: id
 *         required: true
 *         schema:
 *           type: string
 *           format: uuid
 *     requestBody:
 *       content:
 *         application/json:
 *           schema:
 *             type: object
 *             properties:
 *               method:
 *                 type: string
 *               lat:
 *                 type: number
 *               lng:
 *                 type: number
 *               wifiSsid:
 *                 type: string
 *     responses:
 *       200:
 *         description: Checked in
 */
router.post('/assignments/:id/check-in', auth, asyncHandler(async (req, res) => {
  const { id } = idParam.parse(req.params);
  const lat = req.body?.lat != null ? Number(req.body.lat) : undefined;
  const lng = req.body?.lng != null ? Number(req.body.lng) : undefined;
  const wifiSsid: string | undefined = req.body?.wifiSsid;
  res.json(await scheduleService.checkIn(req.user!.userId, id, req.body?.method || 'web', lat, lng, wifiSsid));
}));
/**
 * @swagger
 * /schedules/assignments/{id}/check-out:
 *   post:
 *     summary: Check out from an assignment
 *     tags: [Schedule]
 *     security:
 *       - bearerAuth: []
 *     parameters:
 *       - in: path
 *         name: id
 *         required: true
 *         schema:
 *           type: string
 *           format: uuid
 *     responses:
 *       200:
 *         description: Checked out
 */
router.post('/assignments/:id/check-out', auth, asyncHandler(async (req, res) => {
  const { id } = idParam.parse(req.params);
  res.json(await scheduleService.checkOut(req.user!.userId, id));
}));

/**
 * @swagger
 * /schedules/auto-schedule:
 *   post:
 *     summary: Auto-generate schedule
 *     tags: [Schedule]
 *     security:
 *       - bearerAuth: []
 *     requestBody:
 *       required: true
 *       content:
 *         application/json:
 *           schema:
 *             type: object
 *             properties:
 *               from:
 *                 type: string
 *                 format: date
 *               to:
 *                 type: string
 *                 format: date
 *     responses:
 *       200:
 *         description: Schedule generated
 */
router.post('/auto-schedule', requireRole('admin'), asyncHandler(async (req, res) => {
  const { from, to } = rangeSchema.parse(req.body);
  if (from > to) {
    res.status(400).json({ error: 'Ngay bat dau phai nho hon hoac bang ngay ket thuc' });
    return;
  }
  res.json(await scheduleService.autoSchedule(req.user!.userId, from, to));
}));

const geofenceSchema = z.object({
  zoneId: z.string().uuid(),
  latitude: z.number().min(-90).max(90),
  longitude: z.number().min(-180).max(180),
  radiusMeters: z.number().int().min(10).max(10000).optional(),
  addressHint: z.string().nullable().optional(),
  allowedWifiSsids: z.array(z.string()).nullable().optional(),
});
/**
 * @swagger
 * /schedules/geofence:
 *   get:
 *     summary: List geofence configurations
 *     tags: [Schedule]
 *     security:
 *       - bearerAuth: []
 *     responses:
 *       200:
 *         description: Geofence configs retrieved
 */
router.get('/geofence', requireRole('admin'), asyncHandler(async (_req, res) => {
  res.json(await scheduleService.listGeofenceConfigs());
}));
/**
 * @swagger
 * /schedules/geofence:
 *   put:
 *     summary: Set geofence for a zone
 *     tags: [Schedule]
 *     security:
 *       - bearerAuth: []
 *     requestBody:
 *       required: true
 *       content:
 *         application/json:
 *           schema:
 *             type: object
 *             properties:
 *               zoneId:
 *                 type: string
 *                 format: uuid
 *               latitude:
 *                 type: number
 *               longitude:
 *                 type: number
 *               radiusMeters:
 *                 type: integer
 *               addressHint:
 *                 type: string
 *               allowedWifiSsids:
 *                 type: array
 *                 items:
 *                   type: string
 *                 nullable: true
 *     responses:
 *       200:
 *         description: Geofence set
 */
router.put('/geofence', requireRole('admin'), asyncHandler(async (req, res) => {
  res.json(await scheduleService.setGeofence(req.user!.userId, geofenceSchema.parse(req.body)));
}));
/**
 * @swagger
 * /schedules/geofence/{zoneId}:
 *   delete:
 *     summary: Delete geofence for a zone
 *     tags: [Schedule]
 *     security:
 *       - bearerAuth: []
 *     parameters:
 *       - in: path
 *         name: zoneId
 *         required: true
 *         schema:
 *           type: string
 *           format: uuid
 *     responses:
 *       200:
 *         description: Geofence deleted
 */
router.delete('/geofence/:zoneId', requireRole('admin'), asyncHandler(async (req, res) => {
  const { zoneId } = z.object({ zoneId: z.string().uuid() }).parse(req.params);
  res.json(await scheduleService.deleteGeofence(req.user!.userId, zoneId));
}));

/**
 * @swagger
 * /schedules/auto-checkout:
 *   post:
 *     summary: Auto-checkout stale assignments
 *     tags: [Schedule]
 *     security:
 *       - bearerAuth: []
 *     responses:
 *       200:
 *         description: Auto-checkout completed
 */
router.post('/auto-checkout', requireRole(['admin']), asyncHandler(async (_req, res) => {
  res.json(await scheduleService.autoCheckoutStaleAssignments());
}));

/**
 * @swagger
 * /schedules/assignments/{id}/admin-confirm:
 *   post:
 *     summary: Admin force-confirm an assignment
 *     tags: [Schedule]
 *     security:
 *       - bearerAuth: []
 *     parameters:
 *       - in: path
 *         name: id
 *         required: true
 *         schema:
 *           type: string
 *           format: uuid
 *     responses:
 *       200:
 *         description: Assignment confirmed
 */
router.post('/assignments/:id/admin-confirm', requireRole(['admin']), asyncHandler(async (req, res) => {
  const { id } = idParam.parse(req.params);
  res.json(await scheduleService.adminConfirmAssignment(req.user!.userId, id));
}));

const adminAttendanceSchema = z.object({
  checkInAt: z.string().optional(),
  checkOutAt: z.string().optional(),
  status: z.string().optional(),
});
/**
 * @swagger
 * /schedules/assignments/{id}/attendance:
 *   put:
 *     summary: Admin fix attendance for an assignment
 *     tags: [Schedule]
 *     security:
 *       - bearerAuth: []
 *     parameters:
 *       - in: path
 *         name: id
 *         required: true
 *         schema:
 *           type: string
 *           format: uuid
 *     requestBody:
 *       content:
 *         application/json:
 *           schema:
 *             type: object
 *             properties:
 *               checkInAt:
 *                 type: string
 *               checkOutAt:
 *                 type: string
 *               status:
 *                 type: string
 *     responses:
 *       200:
 *         description: Attendance fixed
 */
router.put('/assignments/:id/attendance', requireRole(['admin']), asyncHandler(async (req, res) => {
  const { id } = idParam.parse(req.params);
  res.json(await scheduleService.adminFixAttendance(req.user!.userId, id, adminAttendanceSchema.parse(req.body)));
}));

const manualCheckInSchema = z.object({
  assignmentId: z.string().uuid(),
  note: z.string().min(1),
});

router.post('/attendance/manual-checkin', auth, asyncHandler(async (req, res) => {
  const { assignmentId, note } = manualCheckInSchema.parse(req.body);
  res.status(201).json(await scheduleService.requestManualCheckIn(assignmentId, req.user!.userId, note));
}));

router.put('/attendance/:id/approve-manual', requireRole(['admin']), asyncHandler(async (req, res) => {
  const { id } = idParam.parse(req.params);
  const checkInAt = req.body?.checkInAt ? new Date(req.body.checkInAt) : undefined;
  res.json(await scheduleService.approveManualCheckIn(req.user!.userId, id, checkInAt));
}));

router.put('/attendance/:id/reject-manual', requireRole(['admin']), asyncHandler(async (req, res) => {
  const { id } = idParam.parse(req.params);
  const { reason } = z.object({ reason: z.string().min(1) }).parse(req.body);
  res.json(await scheduleService.rejectManualCheckIn(req.user!.userId, id, reason));
}));

router.get('/attendance/manual-checkin-requests', requireRole(['admin']), asyncHandler(async (req, res) => {
  const status = req.query.status as string | undefined;
  res.json(await scheduleService.listManualCheckInRequests(status));
}));

/**
 * @swagger
 * /schedules/audit-logs:
 *   get:
 *     summary: List audit logs
 *     tags: [Schedule]
 *     security:
 *       - bearerAuth: []
 *     responses:
 *       200:
 *         description: Audit logs retrieved
 */
router.get('/audit-logs', requireRole(['admin']), asyncHandler(async (req, res) => {
  res.json(await scheduleService.auditLogs({
    page: req.query.page ? parseInt(req.query.page as string, 10) : undefined,
    limit: req.query.limit ? parseInt(req.query.limit as string, 10) : undefined,
    category: req.query.category as string | undefined,
    action: req.query.action as string | undefined,
    entityType: req.query.entityType as string | undefined,
    actorId: req.query.actorId as string | undefined,
    fromDate: req.query.fromDate as string | undefined,
    toDate: req.query.toDate as string | undefined,
    search: req.query.search as string | undefined,
  }));
}));

router.get('/audit-logs/stats', requireRole(['admin']), asyncHandler(async (req, res) => {
  res.json(await scheduleService.auditStats({
    fromDate: req.query.fromDate as string | undefined,
    toDate: req.query.toDate as string | undefined,
  }));
}));

export default router;
