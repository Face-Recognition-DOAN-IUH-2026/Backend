<file path="automation-service/src/handlers/accessAnomalyAlert.ts">
import { accessClient, notificationClient, userClient } from '../clients/serviceClients';

const STALE_HOURS = 8;

export async function accessAnomalyAlert(config: Record<string, any>): Promise<any> {
  let activePatrons;
  try {
    activePatrons = await accessClient.getActivePatrons();
  } catch {
    return { checked: 0, alerts: 0, message: 'Failed to fetch active patrons' };
  }

  const patronList = Array.isArray(activePatrons) ? activePatrons : (activePatrons as any)?.items || [];

  if (patronList.length === 0) {
    return { checked: 1, alerts: 0, message: 'No patrons currently inside' };
  }

  const now = Date.now();
  const staleThreshold = now - STALE_HOURS * 60 * 60 * 1000;
  const stalePatrons = patronList.filter((p: any) => {
    const entryTime = new Date(p.last_entry_at || p.lastEntryAt || p.entered_at).getTime();
    return entryTime < staleThreshold;
  });

  if (stalePatrons.length === 0) {
    return { checked: 1, alerts: 0, message: `No stale patrons (>${STALE_HOURS}h)` };
  }

  let adminUserIds: string[] = config.admin_user_ids || [];

  if (adminUserIds.length === 0) {
    try {
      const admins = await userClient.getUsersByRole('admin');
      adminUserIds = Array.isArray(admins) ? admins.map((u: any) => u.id) : [];
    } catch {}
  }

  if (adminUserIds.length > 0) {
    const formattedList = stalePatrons
      .map((p: any) => {
        const entryTime = new Date(p.last_entry_at || p.lastEntryAt || p.entered_at).getTime();
        const hours = Math.round((now - entryTime) / (1000 * 60 * 60));
        return `- ${p.full_name || p.student_code || p.patron_id || 'Unknown'} (${hours}h, ${p.last_entry_camera || p.lastEntryCamera || 'không rõ'})`;
      })
      .join('\n');

    const notifications = adminUserIds.map((userId) => ({
      userId,
      type: 'anomaly_alert',
      title: `Cảnh báo: ${stalePatrons.length} độc giả ở quá ${STALE_HOURS}h`,
      body: `Phát hiện ${stalePatrons.length} độc giả ở trong thư viện quá ${STALE_HOURS} giờ:\n${formattedList}\n\nCó thể gate không detect exit. Kiểm tra trang "Đang hiện diện".`,
      data: { stale_patrons: stalePatrons, timestamp: new Date().toISOString() },
    }));

    await notificationClient.createBulkNotifications(notifications);
  }

  return { checked: 1, alerts: 1, total_inside: patronList.length, stale_count: stalePatrons.length };
}
</file>

<file path="automation-service/src/handlers/checkOverdueBorrows.ts">
import { borrowClient, notificationClient, userClient, emailClient } from '../clients/serviceClients';

export async function checkOverdueBorrows(config: Record<string, any>): Promise<any> {
  const overdue = await borrowClient.getOverdueBorrows();

  if (!overdue || !Array.isArray(overdue) || overdue.length === 0) {
    return { checked: 0, notified: 0, message: 'No overdue borrows' };
  }

  const notifications: Array<{ userId: string; type: string; title: string; body: string; data: Record<string, any> }> = [];

  for (const record of overdue) {
    const patronId = record.patron_id || record.patronId;
    if (!patronId) continue;

    let patronName = 'Bạn';
    let patronEmail = '';
    try {
      const patron = await userClient.getUser(patronId);
      if (patron?.fullName) patronName = patron.fullName;
      if (patron?.email) patronEmail = patron.email;
    } catch {}

    const bookTitle = record.title || record.book_title || record.book?.title || 'Sách';
    const dueDate = record.due_at || record.dueAt;
    const daysOverdue = dueDate
      ? Math.floor((Date.now() - new Date(dueDate).getTime()) / (1000 * 60 * 60 * 24))
      : 0;

    notifications.push({
      userId: patronId,
      type: 'overdue_reminder',
      title: 'Sách quá hạn',
      body: `${patronName}, cuốn "${bookTitle}" đã quá hạn ${daysOverdue} ngày. Vui lòng trả sách sớm để tránh phí phạt.`,
      data: {
        bookId: record.book_id || record.bookId,
        borrowRecordId: record.id,
        dueAt: dueDate,
        daysOverdue,
      },
    });

    // Send overdue email
    if (patronEmail) {
      try {
        await emailClient.sendOverdueEmail(patronEmail, bookTitle, daysOverdue);
      } catch (err) {
        console.error(`[checkOverdueBorrows] Failed to send overdue email to ${patronEmail}:`, err);
      }
    }
  }

  if (notifications.length > 0) {
    await notificationClient.createBulkNotifications(notifications);
  }

  return { checked: overdue.length, notified: notifications.length };
}
