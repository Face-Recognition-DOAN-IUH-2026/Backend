 *     security:
 *       - bearerAuth: []
 *     responses:
 *       200:
 *         description: Zones retrieved
 */
router.get('/zones', requireDynamicPermission('schedules', 'read'), asyncHandler(async (_req, res) => {
  res.json(await scheduleService.listZones());
}));
/**
 * @swagger
 * /schedules/zones:
 *   post:
 *     summary: Create a zone
 *     tags: [Schedule]
 *     security:
 *       - bearerAuth: []
 *     requestBody:
 *       required: true
 *       content:
 *         application/json:
 *           schema:
 *             type: object
