<file path="face-recognition-service/infra/cooldown.py">
from __future__ import annotations

import redis.asyncio as aioredis

from infra.config import settings


class CooldownService:
    def __init__(self) -> None:
        self._redis: aioredis.Redis | None = None

    async def _get_redis(self) -> aioredis.Redis:
        if self._redis is None:
            self._redis = aioredis.from_url(
                settings.redis_url, encoding="utf-8", decode_responses=True
            )
        return self._redis

    async def acquire(self, key: str, cooldown_seconds: int = 5) -> bool:
        r = await self._get_redis()
        exists = await r.exists(f"cooldown:{key}")
        if exists:
            return False
        await r.setex(f"cooldown:{key}", cooldown_seconds, "1")
        return True

    async def close(self) -> None:
        if self._redis is not None:
            await self._redis.close()
            self._redis = None
</file>

<file path="face-recognition-service/infra/crypto.py">
from __future__ import annotations

import base64

from cryptography.fernet import Fernet

from infra.config import settings


def _get_fernet() -> Fernet:
    raw = settings.data_encryption_key.encode("utf-8")
    if len(raw) < 32:
        raw = raw + b"x" * (32 - len(raw))
    else:
        raw = raw[:32]
    key = base64.urlsafe_b64encode(raw)
    return Fernet(key)


def encrypt_data(data: bytes) -> bytes:
    return _get_fernet().encrypt(data)


def decrypt_data(data: bytes) -> bytes:
    return _get_fernet().decrypt(data)
