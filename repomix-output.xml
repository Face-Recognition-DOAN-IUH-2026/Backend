    if (!reservation) throw new HttpError(404, 'Khong tim thay dat hang');
    await reservationRepo.remove(reservation);
    res.json({ status: 'success', message: 'Huy dat hang thanh cong' });
  } catch (error) {
    next(error);
  }
});

/**
 * @swagger
 * /borrow/renew:
 *   post:
 *     summary: Renew a borrow
 *     tags: [Borrow]
 *     security:
 *       - bearerAuth: []
 *     requestBody:
 *       required: true
 *       content:
 *         application/json:
 *           schema:
 *             type: object
 *             required: [record_id]
 *             properties:
 *               record_id:
 *                 type: string
 *                 format: uuid
 *     responses:
 *       200:
 *         description: Renewal successful
 */
router.post('/renew', auth, async (req: AuthRequest, res, next) => {
  try {
    const body = z.object({ record_id: z.string().uuid() }).parse(req.body);
    const userId = patronIdFrom(req.user);

    const record = await AppDataSource.getRepository(BorrowRecord).findOne({
      where: { id: body.record_id, patronId: userId, status: 'borrowed' as any },
      relations: { book: true, copy: true },
    });
    if (!record) throw new HttpError(404, 'Khong tim thay phieu muon');
    if (record.status !== 'borrowed') throw new HttpError(409, 'Phieu muon nay da het hieu luc');
    if (record.renewalCount >= config.maxRenewals) {
      throw new HttpError(409, `Da dat gioi han gia han toi da ${config.maxRenewals} lan`);
    }

    const now = new Date();
    if (now > new Date(record.dueAt)) {
      throw new HttpError(409, 'Khong the gia han sach qua han. Vui long tra sach va muon lai.');
    }

    const newDueAt = new Date(record.dueAt);
    newDueAt.setDate(newDueAt.getDate() + config.maxBorrowDays);
    record.dueAt = newDueAt;
    record.renewalCount += 1;
    await AppDataSource.getRepository(BorrowRecord).save(record);

    res.json({
      status: 'success',
      message: `Gia han thanh cong. Han tra moi: ${newDueAt.toLocaleDateString('vi-VN')}`,
      record: serializeBorrowRecord(record),
    });
  } catch (error) {
    next(error);
  }
});

router.post('/waitlist', requireRole(['patron', 'admin', 'staff'], 'Chi doc gia moi co the vao danh sach cho'), async (req: AuthRequest, res, next) => {
  try {
    const body = z.object({ book_id: z.string().uuid() }).parse(req.body);
    const userId = patronIdFrom(req.user);
    const repo = new WaitlistRepository();
    const entry = await repo.joinWaitlist(body.book_id, userId);
    res.status(201).json({
      id: entry.id,
      book_id: entry.bookId,
      patron_id: entry.patronId,
      status: entry.status,
      created_at: entry.createdAt,
    });
  } catch (error: any) {
    if (error.statusCode === 409) {
      res.status(409).json({ detail: error.message });
      return;
    }
    if (error.statusCode === 404) {
      res.status(404).json({ detail: error.message });
      return;
    }
    next(error);
  }
});

router.delete('/waitlist/:id', requireRole(['patron', 'admin', 'staff'], 'Chi doc gia moi co the huy danh sach cho'), async (req: AuthRequest, res, next) => {
  try {
    const userId = patronIdFrom(req.user);
    const repo = new WaitlistRepository();
    await repo.cancelWaitlist(req.params.id, userId);
    res.status(204).end();
  } catch (error: any) {
    if (error.statusCode === 403) {
      res.status(403).json({ detail: error.message });
      return;
    }
    if (error.statusCode === 404) {
      res.status(404).json({ detail: error.message });
      return;
    }
    next(error);
  }
});

router.get('/waitlist', async (req: AuthRequest, res, next) => {
  try {
    const userId = patronIdFrom(req.user);
    const waitlistRepo = AppDataSource.getRepository('Waitlist');
    const entries = await waitlistRepo.find({
      where: { patronId: userId, status: 'waiting' as any },
      relations: { book: true },
      order: { createdAt: 'ASC' },
    });
    res.json({
      items: entries.map((e: any) => ({
        id: e.id,
        book_id: e.bookId,
        status: e.status,
        created_at: e.createdAt,
        book: e.book ? serializeBook(e.book) : null,
      })),
      total: entries.length,
    });
  } catch (error) {
    next(error);
  }
});

export default router;
