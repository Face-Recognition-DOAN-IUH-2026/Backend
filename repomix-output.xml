    it('should return 400 for invalid body', async () => {
      const response = await request(app)
        .post('/borrow/staff/slip/create')
        .set('Authorization', 'Bearer test-token').set('x-test-role', 'staff')
        .send({});

      expect(response.status).toBe(500);
