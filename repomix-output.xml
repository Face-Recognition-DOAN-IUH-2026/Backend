<file path="notification-service/src/routes/notification.routes.ts">
import { Router } from 'express';
import { createAuth } from '../../../shared/auth';
import type { AuthRequest } from '../../../shared/auth/types';
import { config } from '../config';
import { notificationService } from '../services/NotificationService';
import { notificationHub } from '../realtime/NotificationHub';

const auth = createAuth({
  jwtSecret: config.jwtSecret,
  jwtAudience: config.jwtAudience,
  jwtIssuer: config.jwtIssuer,
});

const router = Router();
router.use(auth);

/**
 * @swagger
 * /notifications:
 *   get:
 *     summary: List notifications
 *     tags: [Notifications]
 *     security:
 *       - bearerAuth: []
 *     parameters:
 *       - in: query
 *         name: unread
 *         schema:
 *           type: string
 *           enum: ['true', 'false']
 *         description: Filter unread notifications only
 *       - in: query
 *         name: skip
 *         schema:
 *           type: integer
 *           default: 0
 *         description: Number of items to skip
 *       - in: query
 *         name: limit
 *         schema:
 *           type: integer
 *           default: 20
 *         description: Maximum number of items to return
 *     responses:
 *       200:
 *         description: Paginated list of notifications
 */
router.get('/', async (req: AuthRequest, res, next) => {
  try {
    const userId = req.user!.userId;
    const unreadOnly = req.query.unread === 'true';
    const skip = parseInt(req.query.skip as string) || 0;
    const limit = parseInt(req.query.limit as string) || 20;
    const result = await notificationService.list(userId, { unreadOnly, skip, limit });
    res.json(result);
  } catch (error) {
    next(error);
  }
});

/**
 * @swagger
 * /notifications/unread-count:
 *   get:
 *     summary: Get unread notification count
 *     tags: [Notifications]
 *     security:
 *       - bearerAuth: []
 *     responses:
 *       200:
 *         description: Unread count
 *         content:
 *           application/json:
 *             schema:
 *               type: object
 *               properties:
 *                 count:
 *                   type: integer
 */
router.get('/unread-count', async (req: AuthRequest, res, next) => {
  try {
    const userId = req.user!.userId;
    const count = await notificationService.getUnreadCount(userId);
    res.json({ count });
  } catch (error) {
    next(error);
  }
});

/**
 * @swagger
 * /notifications/{id}/read:
 *   put:
 *     summary: Mark a notification as read
 *     tags: [Notifications]
 *     security:
 *       - bearerAuth: []
 *     parameters:
 *       - in: path
 *         name: id
 *         required: true
 *         schema:
 *           type: string
 *         description: Notification ID
 *     responses:
 *       200:
 *         description: Updated notification
 *       404:
 *         description: Notification not found
 */
router.put('/:id/read', async (req: AuthRequest, res, next) => {
  try {
    const userId = req.user!.userId;
    const result = await notificationService.markAsRead(req.params.id, userId);
    if (!result) {
      res.status(404).json({ error: 'Notification not found' });
      return;
    }
    res.json(result);
  } catch (error) {
    next(error);
  }
});

/**
 * @swagger
 * /notifications/read-all:
 *   put:
 *     summary: Mark all notifications as read
 *     tags: [Notifications]
 *     security:
 *       - bearerAuth: []
 *     responses:
 *       200:
 *         description: Updated count
 *         content:
 *           application/json:
 *             schema:
 *               type: object
 *               properties:
 *                 updated:
 *                   type: integer
 */
router.put('/read-all', async (req: AuthRequest, res, next) => {
  try {
    const userId = req.user!.userId;
    const count = await notificationService.markAllAsRead(userId);
    res.json({ updated: count });
  } catch (error) {
    next(error);
  }
});

/**
 * @swagger
 * /notifications/events:
 *   get:
 *     summary: SSE stream for real-time notifications
 *     tags: [Notifications]
 *     security:
 *       - bearerAuth: []
 *     responses:
 *       200:
 *         description: Server-Sent Events stream
 *         content:
 *           text/event-stream:
 *             schema:
 *               type: string
 */
router.get('/events', (req: AuthRequest, res, next) => {
  try {
    const userId = req.user!.userId;
    res.setHeader('Content-Type', 'text/event-stream');
    res.setHeader('Cache-Control', 'no-cache');
    res.setHeader('Connection', 'keep-alive');
    res.setHeader('X-Accel-Buffering', 'no');
    res.flushHeaders();
    notificationHub.addSseClient(userId, res);
  } catch (err) {
    next(err);
  }
});

export default router;
</file>

<file path="notification-service/src/subscribers/AmqpSubscriber.ts">
import { amqpClient } from '../clients/AmqpClient';
import { notificationService } from '../services/NotificationService';
import { notificationHub } from '../realtime/NotificationHub';
import { EmailService } from '../services/EmailService';

const emailService = new EmailService();

export async function startAmqpSubscriber(): Promise<void> {
  try {
    // Verify SMTP at startup
    await emailService.verifyConnection();

    await amqpClient.connect();

    await amqpClient.consume(
      'notification_service_queue',
      ['book.borrowed', 'book.returned', 'notification.send'],
      async (envelope) => {
        const { eventType, payload } = envelope;
        console.log(`[AMQP] Processing event ${eventType} on notification-service`);

        try {
          if (eventType === 'book.borrowed') {
            const { patronId, title, dueAt } = payload;
            if (!patronId || !title) return;

            const dateStr = dueAt ? new Date(dueAt).toLocaleDateString('vi-VN') : '';
            const body = `Bạn đã mượn thành công cuốn sách "${title}". Vui lòng trả trước ngày ${dateStr}.`;

            const notification = await notificationService.create({
              userId: patronId,
              type: 'borrow',
              title: 'Mượn sách thành công',
              body,
              data: payload,
            });
            await notificationHub.publish(patronId, notification);
            console.log(`[AMQP] Created borrow notification for user ${patronId}`);
          }
          
          else if (eventType === 'book.returned') {
            const { patronId, title } = payload;
            if (!patronId || !title) return;

            const body = `Bạn đã hoàn thành trả cuốn sách "${title}". Cảm ơn bạn!`;

            const notification = await notificationService.create({
              userId: patronId,
              type: 'return',
              title: 'Trả sách thành công',
              body,
              data: payload,
            });
            await notificationHub.publish(patronId, notification);
            console.log(`[AMQP] Created return notification for user ${patronId}`);
          }
          
          else if (eventType === 'notification.send') {
            const { emailType, userId, type: notifType, title, body, data, toEmail, code, bookTitle, daysOverdue, fineAmount, expiryDate } = payload;

            if (emailType === 'push') {
              if (!userId || !notifType || !title || !body) {
                console.warn('[AMQP] Invalid push notification payload:', payload);
                return;
              }
              const notification = await notificationService.create({
                userId,
                type: notifType,
                title,
                body,
                data: data || {},
              });
              await notificationHub.publish(userId, notification);
              console.log(`[AMQP] Created push notification for user ${userId}: ${title}`);
              return;
            }

            if (!toEmail) {
              console.warn('[AMQP] Invalid notification.send payload (missing toEmail):', payload);
              return;
            }

            console.log(`[AMQP] Sending email of type ${emailType} to ${toEmail}`);

            if (emailType === 'password_reset') {
              await emailService.sendPasswordResetCode(toEmail, code);
            } else if (emailType === 'email_verification') {
              await emailService.sendEmailVerificationCode(toEmail, code);
            } else if (emailType === 'overdue') {
              await emailService.sendOverdueEmail(toEmail, bookTitle, daysOverdue);
            } else if (emailType === 'fine') {
              await emailService.sendFineEmail(toEmail, bookTitle, fineAmount, daysOverdue);
            } else if (emailType === 'membership_expiry') {
              await emailService.sendMembershipExpiryEmail(toEmail, new Date(expiryDate));
            } else if (emailType === 'email_change') {
              await emailService.sendEmailChangeCode(toEmail, code);
            } else {
              console.warn(`[AMQP] Unknown email type: ${emailType}`);
            }
          }
        } catch (err: any) {
          console.error(`[AMQP] Processing error on ${eventType}: ${err.message}`);
          throw err;
        }
      }
    );

    console.log('[AMQP] Notification-service subscriber initialized');
  } catch (err: any) {
    console.error('[AMQP] Failed to start notification-service subscribers:', err.message);
  }
}
</file>

<file path="notification-service/src/subscribers/UserEventSubscriber.ts">
import crypto from 'crypto';
import { config } from '../config';
import { AppDataSource } from '../data-source';
import { Notification } from '../entities/Notification';
import { amqpClient } from '../clients/AmqpClient';

interface UserDeletedMessage {
  event: 'USER_DELETED';
  user_id: string;
  email: string;
  timestamp: string;
  signature: string;
}

function signPayload(payload: object, secret: string): string {
  return crypto.createHmac('sha256', secret).update(JSON.stringify(payload)).digest('hex');
}

function verifySignature(msg: UserDeletedMessage): boolean {
  const { signature, ...rest } = msg;
  const expected = signPayload(rest, config.serviceJwtSecret);
  try {
    return crypto.timingSafeEqual(Buffer.from(signature, 'hex'), Buffer.from(expected, 'hex'));
  } catch {
    return false;
  }
}

export async function startUserEventSubscriber(): Promise<void> {
  try {
    await amqpClient.connect();
    await amqpClient.subscribeFanoutReliable('user.events.fanout', async (payload: any) => {
      try {
        const msg: UserDeletedMessage = payload;
        if (msg.event !== 'USER_DELETED') return;

        if (!verifySignature(msg)) {
          console.warn('[UserEventSubscriber] Invalid signature, ignoring event');
          return;
        }

        console.log(`[UserEventSubscriber] Processing USER_DELETED for ${msg.user_id}`);

        const repo = AppDataSource.getRepository(Notification);
        const result = await repo.delete({ userId: msg.user_id });
        console.log(`[UserEventSubscriber] Deleted ${result.affected ?? 0} notifications for user ${msg.user_id}`);
      } catch (e) {
        console.error('[UserEventSubscriber] Error processing event:', e);
      }
    });
    console.log('[UserEventSubscriber] Subscribed to user.events.fanout');
  } catch (err: any) {
    console.error('[UserEventSubscriber] RabbitMQ connection failed:', err.message);
  }
}
