      // Patrons should NOT have admin tools
      expect(tools.find(t => t.name === 'get_overdue_borrows')).toBeUndefined();
    });

    it('should provide staff+ tools for staff role without injectUserId', () => {
      const tools = getToolDefsForRole('staff');
