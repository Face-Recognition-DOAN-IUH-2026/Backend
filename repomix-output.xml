import axios from 'axios';
import { config } from '../config';

const CHUNK_SIZE = 500;

interface EmbeddingResponse {
  data: Array<{
    embedding: number[];
  }>;
}

export function chunkText(text: string, chunkSize: number = CHUNK_SIZE): string[] {
  const chunks: string[] = [];
  const sentences = text.match(/[^.!?]+[.!?]+/g) || [text];
  let currentChunk = '';

  for (const sentence of sentences) {
    if ((currentChunk + sentence).length <= chunkSize) {
      currentChunk += sentence;
    } else {
      if (currentChunk) {
        chunks.push(currentChunk.trim());
      }
      currentChunk = sentence;
    }
  }

  if (currentChunk.trim()) {
    chunks.push(currentChunk.trim());
  }

  return chunks;
}

export async function embedText(text: string): Promise<number[]> {
  const response = await axios.post<EmbeddingResponse>(
    'https://integrate.api.nvidia.com/v1/embeddings',
    {
      input: text,
      model: config.nvidiaEmbedModel,
    },
    {
      headers: {
        'Authorization': `Bearer ${config.nvidiaApiKey}`,
        'Content-Type': 'application/json',
      },
      timeout: 60000,
    }
  );

  if (response.data.data && response.data.data.length > 0) {
    return response.data.data[0].embedding;
  }

  throw new Error('No embedding returned from NVIDIA API');
}

export async function embedTexts(texts: string[]): Promise<number[][]> {
  if (texts.length === 0) return [];

  const response = await axios.post<EmbeddingResponse>(
    'https://integrate.api.nvidia.com/v1/embeddings',
    {
      input: texts,
      model: config.nvidiaEmbedModel,
    },
    {
      headers: {
        'Authorization': `Bearer ${config.nvidiaApiKey}`,
        'Content-Type': 'application/json',
      },
      timeout: 120000,
    }
  );

  if (response.data.data && response.data.data.length > 0) {
    return response.data.data.map(item => item.embedding);
  }

  throw new Error('No embeddings returned from NVIDIA API');
}

export default { chunkText, embedText, embedTexts };
</file>

<file path="ai-service/src/rag/indexer.ts">
import fs from 'fs';
import path from 'path';
import { getCollection, resetCollection } from '../clients/chromadb';
import { chunkText } from './embedder';
import { v4 as uuidv4 } from 'uuid';

interface DocMetadata {
  source: string;
  doc_title: string;
}

function getDocTitle(filePath: string): string {
  const fileName = path.basename(filePath, '.md');
  const titles: Record<string, string> = {
    'gio-mo-cua': 'Giờ Mở Cửa',
    'quy-dinh-muon-tra': 'Quy Định Mượn Trả',
    'vi-tri-tang': 'Vị Trí Tầng',
    'cau-hoi-thuong-gap': 'Câu Hỏi Thường Gặp',
    'the-loai-sach': 'Thể Loại Sách',
    'quy-dinh-the': 'Quy Định Thẻ',
    'chinh-sach-phat': 'Chính Sách Phạt',
  };
  return titles[fileName] || fileName;
}

function extractFrontmatter(content: string): { metadata: Record<string, string>; body: string } {
  const frontmatterMatch = content.match(/^---\n([\s\S]*?)\n---\n([\s\S]*)$/);
  if (frontmatterMatch) {
    const metadata: Record<string, string> = {};
    const frontmatterLines = frontmatterMatch[1].split('\n');
    for (const line of frontmatterLines) {
      const colonIndex = line.indexOf(':');
      if (colonIndex > 0) {
        const key = line.substring(0, colonIndex).trim();
        const value = line.substring(colonIndex + 1).trim();
        metadata[key] = value;
      }
    }
    return { metadata, body: frontmatterMatch[2] };
  }
  return { metadata: {}, body: content };
}

export async function indexDocuments(): Promise<void> {
  console.log('Starting document indexing...');

  const docsPath = path.join(__dirname, '..', '..', 'src', 'docs');
  const files = fs.readdirSync(docsPath).filter(f => f.endsWith('.md'));

  if (files.length === 0) {
    console.log('No documents found to index');
    return;
  }

  console.log(`Found ${files.length} documents to index`);

  const collection = await resetCollection();

  let totalChunks = 0;

  for (const file of files) {
    const filePath = path.join(docsPath, file);
    const content = fs.readFileSync(filePath, 'utf-8');
    const { body } = extractFrontmatter(content);
    const docTitle = getDocTitle(filePath);
    const chunks = chunkText(body);

    console.log(`Processing "${docTitle}": ${chunks.length} chunks`);

    if (chunks.length > 0) {
      const ids = chunks.map(() => uuidv4());
      const metadatas: DocMetadata[] = chunks.map(() => ({
        source: file,
        doc_title: docTitle,
      }));

      await collection.add({
        ids,
        documents: chunks,
        metadatas: metadatas as any,
      });

      totalChunks += chunks.length;
    }
  }

  console.log(`Indexing complete: ${totalChunks} total chunks from ${files.length} documents`);
}

export default { indexDocuments };
</file>

<file path="ai-service/src/rag/retriever.ts">
import { getCollection } from '../clients/chromadb';

export interface RetrievedDocument {
  id: string;
  content: string;
  source: string;
  docTitle: string;
  distance?: number;
}

export async function retrieve(query: string, topK: number = 5): Promise<RetrievedDocument[]> {
  const collection = await getCollection();

  try {
    const results = await collection.query({
      queryTexts: [query],
      nResults: topK,
      include: ['documents', 'metadatas', 'distances'] as any,
    });

    const documents: RetrievedDocument[] = [];

    if (results.documents && results.documents.length > 0) {
      const docs = results.documents[0];
      const metadatas = results.metadatas?.[0] || [];
      const distances = results.distances?.[0] || [];
      const ids = results.ids?.[0] || [];

      for (let i = 0; i < docs.length; i++) {
        const metadata = metadatas[i] as Record<string, string> || {};
        documents.push({
          id: ids[i] || String(i),
          content: docs[i] || '',
          source: metadata.source || '',
          docTitle: metadata.doc_title || '',
          distance: distances[i],
        });
      }
    }

    return documents;
  } catch {
    const allDocs = await collection.get({
      include: ['documents', 'metadatas'] as any,
    });

    const queryLower = query.toLowerCase();
    const scored: RetrievedDocument[] = [];

    if (allDocs.documents && allDocs.metadatas && allDocs.ids) {
      for (let i = 0; i < allDocs.documents.length; i++) {
        const doc = allDocs.documents[i] || '';
        const meta = (allDocs.metadatas[i] || {}) as Record<string, string>;
        const docLower = doc.toLowerCase();

        const words = queryLower.split(/\s+/).filter(w => w.length > 2);
        let score = 0;
        for (const word of words) {
          if (docLower.includes(word)) score++;
        }

        if (score > 0) {
          scored.push({
            id: allDocs.ids[i] || String(i),
            content: doc,
            source: meta.source || '',
            docTitle: meta.doc_title || '',
            distance: 1 - score / words.length,
          });
        }
      }
    }

    scored.sort((a, b) => (a.distance ?? 1) - (b.distance ?? 1));
    return scored.slice(0, topK);
  }
}

export default { retrieve };
</file>

