<file path="borrow-service/src/clients/NotificationServiceClient.ts">
import { config } from '../config';
import { amqpClient } from './AmqpClient';
import { getServiceToken } from '../../../shared/auth';

interface RequestOptions {
  method?: string;
  body?: any;
  timeout?: number;
}

async function request(url: string, options: RequestOptions = {}): Promise<any> {
  const { method = 'GET', body, timeout = 5000 } = options;
  const controller = new AbortController();
  const timer = setTimeout(() => controller.abort(), timeout);

  try {
    const res = await fetch(url, {
      method,
      headers: {
        'Content-Type': 'application/json',
        'Authorization': `Bearer ${getServiceToken('borrow-service', config.jwtSecret)}`,
      },
      body: body ? JSON.stringify(body) : undefined,
      signal: controller.signal,
    });
    clearTimeout(timer);
    if (!res.ok) {
      const text = await res.text().catch(() => '');
      throw new Error(`HTTP ${res.status}: ${text}`);
    }
    return res.json();
  } catch (error) {
    clearTimeout(timer);
    throw error;
  }
}

export const notificationServiceClient = {
  async sendNotification(input: {
    userId: string;
    type: string;
    title: string;
    message: string;
    data?: Record<string, any>;
  }) {
    try {
      const published = await amqpClient.publish('notification.send', {
        emailType: 'push',
        userId: input.userId,
        type: input.type,
        title: input.title,
        body: input.message,
        data: input.data || {},
      });
      if (published) {
        console.log('[AMQP] Published push notification event to RabbitMQ');
        return { success: true, via: 'rabbitmq' };
      }
    } catch (err: any) {
      console.error('[AMQP] RabbitMQ publish failed, falling back to HTTP sync:', err.message);
    }

    return request(`${config.notificationServiceUrl}/internal/`, {
      method: 'POST',
      body: input,
    });
  },
};
