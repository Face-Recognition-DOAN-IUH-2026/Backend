FROM python:3.12-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 libglib2.0-0 && \
    rm -rf /var/lib/apt/lists/*

COPY pyproject.toml .
RUN pip install --no-cache-dir poetry && \
    poetry config virtualenvs.create false && \
    poetry install --only main --no-root --no-interaction --no-ansi

# Install insightface + onnxruntime via pip (faster than poetry, avoids dependency resolution timeout)
RUN pip install --no-cache-dir insightface onnxruntime gevent

# Pre-download buffalo_l model and bake it into the image layer (not BuildKit cache)
RUN python -c "import insightface; from insightface.app import FaceAnalysis; app = FaceAnalysis(name='buffalo_l', providers=['CPUExecutionProvider']); app.prepare(ctx_id=0, det_size=(640,640)); print('buffalo_l model cached')"

# Pre-download MobileNet SSD model for person detection (fail silently, will retry at runtime)
RUN python -c "import urllib.request,os; os.makedirs('/app/models',exist_ok=True); urllib.request.urlretrieve('https://raw.githubusercontent.com/chuanqi305/MobileNet-SSD/master/mobilenet_iter_73000.caffemodel', '/app/models/MobileNetSSD_deploy.caffemodel'); print('MobileNet SSD caffemodel pre-downloaded')" 2>&1 || echo "MobileNet SSD caffemodel download failed (will retry at runtime)"

COPY . .

CMD ["celery", "-A", "worker.celery_app", "worker", "--loglevel=info", "--concurrency=2", "--include=worker.tasks"]
