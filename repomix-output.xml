<file path="borrow-service/src/api/app.py">
from __future__ import annotations

import logging
from contextlib import asynccontextmanager

from fastapi import FastAPI
from fastapi.middleware.cors import CORSMiddleware

from src.api.routers import borrow
from src.config import settings

logger = logging.getLogger("borrow-service")


@asynccontextmanager
async def lifespan(app: FastAPI):
    from src.infra.database import init_db
    from src.lib.http_client import get_http_client
    await init_db()
    get_http_client()
    logger.info("Borrow service started (db=connected, http=ready)")
    yield
    from src.infra.database import close_db
    from src.lib.http_client import close_http_client
    await close_db()
    await close_http_client()
    logger.info("Borrow service shutting down")


def create_app() -> FastAPI:
    app = FastAPI(
        title="Borrow Service",
        version="0.1.0",
        description="Book borrow/return microservice",
        lifespan=lifespan,
    )

    app.add_middleware(
        CORSMiddleware,
        allow_origins=["*"],
        allow_credentials=True,
        allow_methods=["*"],
        allow_headers=["*"],
    )

    app.include_router(borrow.router)

    @app.get("/healthz")
    async def healthz():
        return {"status": "ok", "service": settings.service_name}

    @app.get("/ready")
    async def ready():
        from src.infra.database import Base
        db_ok = False
        try:
            from src.infra.database import engine
            from sqlalchemy import text
            async with engine.connect() as conn:
                await conn.execute(text("SELECT 1"))
            db_ok = True
        except Exception as e:
            logger.error("Health check DB failed: %s", e)
        status_str = "ok" if db_ok else "degraded"
        return {"status": status_str, "service": settings.service_name, "db_ok": db_ok}

    return app
</file>

<file path="borrow-service/src/clients/UserServiceClient.ts">
import { config } from '../config';
import { HttpError } from '../middlewares/errorHandler';
import { CircuitBreaker } from '../utils/circuitBreaker';

const circuit = new CircuitBreaker(5, 60_000);

export interface PatronSummary {
  id: string;
  fullName?: string | null;
  full_name?: string | null;
  studentCode?: string | null;
  student_code?: string | null;
  email?: string | null;
  cardNumber?: string | null;
  card_number?: string | null;
  currentStatus?: string | null;
  current_status?: string | null;
}

async function request(path: string, init?: RequestInit) {
  if (!circuit.canRequest()) {
    throw new HttpError(503, 'user-service is temporarily unavailable');
  }
  try {
    const res = await fetch(`${config.userServiceUrl}${path}`, {
      ...init,
      headers: {
        'x-internal-api-key': config.internalApiKey,
        ...(init?.headers || {}),
      },
      signal: AbortSignal.timeout(5000),
    });
    if (res.status >= 500) {
      circuit.recordFailure();
      throw new HttpError(503, 'Cannot lookup patron right now');
    }
    circuit.recordSuccess();
    return res;
  } catch (error) {
    if (error instanceof HttpError) throw error;
    circuit.recordFailure();
    throw new HttpError(503, 'Khong the tra cuu doc gia');
  }
}

export async function lookupPatronByStudentCode(studentCode: string): Promise<PatronSummary> {
  const normalized = studentCode.trim();
  if (!normalized) throw new HttpError(400, 'student_code is required');
  const res = await request(`/patrons/lookup?student_code=${encodeURIComponent(normalized)}`);
  if (res.status !== 200) throw new HttpError(404, 'Khong tim thay doc gia');
  const data = await res.json() as any;
  if (!data.exists || !data.patron) throw new HttpError(404, 'Khong tim thay doc gia voi MSSV nay');
  return data.patron;
}

export async function lookupPatronById(id: string): Promise<PatronSummary | null> {
  const res = await request(`/users/${encodeURIComponent(id)}`);
  if (res.status === 404) return null;
  if (res.status !== 200) throw new HttpError(503, 'Cannot lookup patron right now');
  return res.json() as Promise<PatronSummary>;
}
</file>

