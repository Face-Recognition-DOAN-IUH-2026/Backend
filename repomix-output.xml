import { Router, Response } from 'express';
import type { AuthRequest } from '../../../shared/auth/types';
import { sessionStore } from '../sessions';
import { processMessage } from '../agent/agent';
import { getToolDefsForRole } from '../tools/registry';

const router = Router();

// Legacy unified chat endpoint: POST /ai/chat
// Dispatches to role-appropriate tool registry based on JWT role.
// Kept for backward compatibility — frontend should prefer /ai/patrons|staff|admin/chat
router.post('/', async (req: AuthRequest, res: Response) => {
  try {
    const { message, sessionId } = req.body as { message: string; sessionId?: string };

    if (!message || typeof message !== 'string') {
      res.status(400).json({ error: 'message is required and must be a string' });
      return;
    }

    const user = req.user;
    if (!user) {
      res.status(401).json({ error: 'User not authenticated' });
      return;
    }

    const hasImageContent =
      message.includes('data:image/') ||
      /\bdata:image\/[^;]+;base64,/i.test(message) ||
      /\bimage\/[^;\s]*/i.test(message);

    if (hasImageContent) {
      res.status(400).json({
        error: 'Image input not supported',
        message: 'Xin loi, tinh nang nay chi ho tro tin nhan van ban.',
      });
      return;
    }

    const trimmed = message.trim().toLowerCase();
    if (trimmed === 'clipboard' || trimmed === 'paste' || trimmed === 'dan') {
      res.json({
        response: 'Xin loi, toi khong the truy cap clipboard cua ban. Ban vui long nhap noi dung truc tiep bang van ban.',
        requiresConfirmation: false,
        sessionId: undefined,
        userRole: user.role,
      });
      return;
    }

    const effectivePatronId = user.userId;
    let session = sessionId ? sessionStore.getOwned(sessionId, effectivePatronId) : undefined;
    if (!session) {
      session = sessionStore.create(effectivePatronId);
    }

    sessionStore.addMessage(session.id, {
      role: 'user',
      content: message,
      timestamp: Date.now(),
    });

    const sessionHistory = session.messages.map(m => ({
      role: m.role,
      content: m.content,
    }));

    const userContext = {
      userId: user.userId,
      email: user.email,
      role: user.role,
      fullName: user.fullName || undefined,
    };

    const toolDefs = getToolDefsForRole(user.role);

    const result = await processMessage(
      message,
      session.id,
      user.role,
      sessionHistory,
      userContext,
      toolDefs,
    );

    sessionStore.addMessage(session.id, {
      role: 'assistant',
      content: result.response,
      timestamp: Date.now(),
    });

    if (result.requiresConfirmation && result.pendingTool) {
      sessionStore.setConfirmation(session.id, {
        action: message,
        toolName: result.pendingTool.name,
        toolArgs: result.pendingTool.args,
        description: result.pendingTool.description,
      });
    } else if (session?.pendingConfirmation) {
      sessionStore.setConfirmation(session.id, undefined);
    }

    res.json({
      response: result.response,
      requiresConfirmation: result.requiresConfirmation,
      pendingAction: result.pendingTool ? {
        action: result.pendingTool.name,
        description: result.pendingTool.description,
        params: result.pendingTool.args,
      } : undefined,
      toolResults: result.toolResults,
      sessionId: session.id,
      userRole: user.role,
    });
  } catch (error) {
    console.error('Legacy chat error:', error);
    const errorMessage = error instanceof Error ? error.message : 'Unknown error';
    const isBothFailed = errorMessage.includes('Both LLM providers failed');
    const isRateLimit = errorMessage.includes('429') || errorMessage.includes('rate limit');
    const userMessage = isRateLimit
      ? 'He thong dang ban, vui long thu lai sau vai giay.'
      : isBothFailed
        ? 'Dich vu AI tam thoi khong kha dung, vui long thu lai sau.'
        : 'Da xay ra loi, vui long thu lai.';
    res.status(isRateLimit ? 429 : isBothFailed ? 503 : 500).json({
      error: isRateLimit ? 'Rate limit exceeded' : isBothFailed ? 'Service unavailable' : 'Internal server error',
      message: userMessage,
      details: process.env.NODE_ENV === 'development' ? errorMessage : undefined,
    });
  }
});

export default router;
</file>

<file path="ai-service/src/routes/companion.ts">
import { Router, Response } from 'express';
import type { AuthRequest } from '../../../shared/auth/types';
import { sessionStore } from '../sessions';
import { processCompanionMessage } from '../agent/agent';

const router = Router();

router.post('/stream', async (req: AuthRequest, res: Response) => {
  try {
    const { message, audioBase64, sessionId } = req.body as {
      message?: string;
      audioBase64?: string;
      sessionId?: string;
    };

    if ((!message || typeof message !== 'string') && !audioBase64) {
      res.status(400).json({ error: 'message or audioBase64 is required' });
      return;
    }

    const user = req.user;
    if (!user) {
      res.status(401).json({ error: 'User not authenticated' });
      return;
    }

    // Block image paste same as chat routes
    if (message) {
      const hasImageContent =
        message.includes('data:image/') ||
        /\bdata:image\/[^;]+;base64,/i.test(message) ||
        /\bimage\/[^;\s]*/i.test(message);
      if (hasImageContent) {
        res.status(400).json({
          error: 'Image input not supported',
          message: 'Xin loi, tinh nang nay chi ho tro tin nhan van ban.',
        });
        return;
      }
      const trimmed = message.trim().toLowerCase();
      if (trimmed === 'clipboard' || trimmed === 'paste' || trimmed === 'dan') {
        res.setHeader('Content-Type', 'text/event-stream');
        res.setHeader('Cache-Control', 'no-cache');
        res.setHeader('Connection', 'keep-alive');
        res.flushHeaders?.();
        const payload = JSON.stringify({
          type: 'text',
          data: { content: 'Xin loi, toi khong the truy cap clipboard cua ban. Ban vui long nhap noi dung truc tiep bang van ban.' },
        });
        res.write(`data: ${payload}\n\n`);
        const done = JSON.stringify({ type: 'companion_done', data: { sessionId: sessionId || '' } });
        res.write(`data: ${done}\n\n`);
        res.end();
        return;
      }
    }

    const effectivePatronId = user.userId;
    const role = user.role || 'patron';
    let session = sessionId ? sessionStore.getOwned(sessionId, effectivePatronId) : undefined;
    if (!session) {
      session = sessionStore.create(effectivePatronId);
    }

    if (message) {
      sessionStore.addMessage(session.id, {
        role: 'user',
        content: message,
        timestamp: Date.now(),
      });
    }

    const sessionHistory = session.messages.map(m => ({
      role: m.role,
      content: m.content,
    }));

    // SSE headers
    res.setHeader('Content-Type', 'text/event-stream');
    res.setHeader('Cache-Control', 'no-cache');
    res.setHeader('Connection', 'keep-alive');
    // Disable nginx buffering if present
    res.setHeader('X-Accel-Buffering', 'no');
    res.flushHeaders?.();

    let finalText = '';
    for await (const chunk of processCompanionMessage({
      message: message || undefined,
      audioBase64: audioBase64 || undefined,
      sessionId: session.id,
      role,
      patronId: effectivePatronId,
      sessionHistory,
    })) {
      if (chunk.type === 'text' && chunk.data?.content) {
        finalText += chunk.data.content;
      }
      // Persist final assistant message on companion_done
      if (chunk.type === 'companion_done') {
        if (finalText) {
          sessionStore.addMessage(session.id, {
            role: 'assistant',
            content: finalText,
            timestamp: Date.now(),
          });
        }
      }
      res.write(`data: ${JSON.stringify(chunk)}\n\n`);
      // flush if available
      (res as any).flush?.();
    }

    res.end();
  } catch (error) {
    console.error('Companion stream error:', error);
    if (!res.headersSent) {
      const msg = error instanceof Error ? error.message : 'Unknown error';
      res.status(500).json({ error: 'Companion stream failed', message: msg });
    } else {
      try {
        const errChunk = JSON.stringify({ type: 'error', data: { message: 'Companion stream failed' } });
        res.write(`data: ${errChunk}\n\n`);
        res.end();
      } catch {
        res.end();
      }
    }
  }
});

export default router;
</file>

<file path="ai-service/src/services/MemoryService.ts">
import { AppDataSource } from '../data-source';
import { AiMemory } from '../entities/AiMemory';

const memoryRepo = () => AppDataSource.getRepository(AiMemory);

export class MemoryService {
  async getMemoriesForPatron(patronId: string): Promise<Record<string, string>> {
    const memories = await memoryRepo().find({
      where: { patronId },
    });

    const result: Record<string, string> = {};
    for (const memory of memories) {
      result[memory.memoryKey] = memory.memoryValue;
    }
    return result;
  }

  async saveMemoryForPatron(patronId: string, key: string, value: string): Promise<void> {
    const existing = await memoryRepo().findOne({
      where: { patronId, memoryKey: key },
    });

    if (existing) {
      existing.memoryValue = value;
      existing.updatedAt = new Date();
      await memoryRepo().save(existing);
    } else {
      const memory = memoryRepo().create({
        patronId,
        memoryKey: key,
        memoryValue: value,
      });
      await memoryRepo().save(memory);
    }
  }

  async consolidateNewMemories(patronId: string, chatHistory: Array<{ role: string; content: string }>): Promise<void> {
    if (!chatHistory || chatHistory.length === 0) {
      return;
    }

    const memoriesToSave = this.extractMemoriesFromChat(chatHistory);

    for (const [key, value] of Object.entries(memoriesToSave)) {
      await this.saveMemoryForPatron(patronId, key, value);
    }
  }

  async deleteMemoryForPatron(patronId: string, key: string): Promise<void> {
    await memoryRepo().delete({
      patronId,
      memoryKey: key,
    });
  }

  private extractMemoriesFromChat(chatHistory: Array<{ role: string; content: string }>): Record<string, string> {
    const memories: Record<string, string> = {};

    for (const message of chatHistory) {
      if (message.role !== 'user') continue;

      const content = message.content.toLowerCase();

      if (content.includes('thích') || content.includes(' yêu thích') || content.includes('thể loại')) {
        memories['preference'] = message.content;
      }

      if (content.includes('tên tôi là') || content.includes('tôi tên')) {
        const nameMatch = message.content.match(/(?:tên tôi là|tôi tên)\s+([A-Za-zÀ-ỹ\s]+)/i);
        if (nameMatch) {
          memories['user_name'] = nameMatch[1].trim();
        }
      }

      if (content.includes('mượn') || content.includes('sách')) {
        memories['recent_topic'] = 'book_borrowing';
      }
    }

    return memories;
  }
}
