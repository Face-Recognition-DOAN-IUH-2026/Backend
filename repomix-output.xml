--   image_url TEXT,
--   access_time TIMESTAMP NOT NULL DEFAULT NOW(),
--   status VARCHAR(20) NOT NULL,
--   PRIMARY KEY (id, access_time)
-- ) PARTITION BY RANGE (access_time);

