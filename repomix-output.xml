import axios, { AxiosInstance } from 'axios';
import { config } from '../config';

interface ChatMessage {
  role: 'system' | 'user' | 'assistant';
  content: string;
}

interface ChatCompletionRequest {
  model: string;
  messages: ChatMessage[];
  temperature?: number;
  max_tokens?: number;
  stream?: boolean;
}

interface ChatCompletionResponse {
  id: string;
  choices: Array<{
    message: {
      role: string;
      content: string;
    };
    finish_reason: string;
  }>;
  usage?: {
    prompt_tokens: number;
    completion_tokens: number;
    total_tokens: number;
  };
}

class NvidiaNIMClient {
  private client: AxiosInstance;
  private maxRetries: number = 3;

  constructor() {
    const baseUrl = config.openRouter.apiKey
      ? (config.openRouter.baseUrl || 'https://openrouter.ai/api/v1')
      : 'https://integrate.api.nvidia.com/v1';
    const apiKey = config.openRouter.apiKey || config.nvidiaApiKey;

    this.client = axios.create({
      baseURL: baseUrl,
      headers: {
        'Authorization': `Bearer ${apiKey}`,
        'Content-Type': 'application/json',
      },
      timeout: 120000,
    });
  }

  async createChatCompletion(
    messages: ChatMessage[],
    options: {
      temperature?: number;
      maxTokens?: number;
    } = {}
  ): Promise<string> {
    const { temperature = 0.7, maxTokens = 2048 } = options;

    const request: ChatCompletionRequest = {
      model: config.openRouter.apiKey ? (config.nvidiaModel || 'openai/gpt-oss-20b:free') : config.nvidiaModel,
      messages,
      temperature,
      max_tokens: maxTokens,
      stream: false,
    };

    let lastError: Error | null = null;

    for (let attempt = 1; attempt <= this.maxRetries; attempt++) {
      try {
        const response = await this.client.post<ChatCompletionResponse>(
          '/chat/completions',
          request
        );

        if (response.data.choices && response.data.choices.length > 0) {
          const content = response.data.choices[0].message.content;
          return content || '';
        }

        throw new Error('No response content from NVIDIA NIM');
      } catch (error) {
        lastError = error as Error;
        if (attempt < this.maxRetries) {
          await this.delay(1000 * attempt);
        }
      }
    }

    throw new Error(`NVIDIA NIM request failed after ${this.maxRetries} attempts: ${lastError?.message}`);
  }

  private delay(ms: number): Promise<void> {
    return new Promise(resolve => setTimeout(resolve, ms));
  }
}

export const nvidiaClient = new NvidiaNIMClient();
export default nvidiaClient;
</file>

<file path="ai-service/src/docs/cau-hoi-thuong-gap.md">
# Câu hỏi thường gặp - Thư viện IUH

## Mượn sách

**Q: Làm sao để mượn sách?**
A: Đăng nhập hệ thống bằng khuôn mặt hoặc email/password → Tìm sách cần mượn trên hệ thống hoặc trực tiếp tại kệ → Xác nhận mượn tại quầy thủ thư. Lưu ý: Bạn phải đang ở trong thư viện (đã check-in qua camera) mới được mượn.

**Q: Tôi có thể mượn tối đa bao nhiêu cuốn?**
A: Mỗi độc giả được mượn tối đa 3 cuốn sách tại một thời điểm.

**Q: Tôi muốn mượn sách nhưng thư viện hết rồi. Tôi phải làm sao?**
A: Bạn có thể đặt trước (reservation) qua hệ thống hoặc để lại email/SDT để thư viện thông báo khi sách được trả.

**Q: Tôi muốn gia hạn sách. Làm thế nào?**
A: Đăng nhập → vào mục Mượn trả → Chọn sách muốn gia hạn → Nhấn Gia hạn. Lưu ý: Chỉ gia hạn được 1 lần và sách chưa quá hạn.

**Q: Có thể đặt trước sách online không?**
A: Có, bạn có thể tìm sách và đặt trước qua hệ thống thư viện.

## Thẻ thư viện

**Q: Làm thẻ thư viện ở đâu?**
A: Đăng ký tại quầy thủ thư hoặc đăng ký online qua hệ thống của thư viện. Cần cung cấp: MSSV, CMND/CCCD, ảnh thẻ, thông tin cá nhân.

**Q: Thẻ thư viện hết hạn thì làm sao?**
A: Gia hạn tại quầy thủ thư hoặc liên hệ bộ phận phục vụ bạn đọc. Thẻ hết hạn sẽ không thể mượn sách cho đến khi gia hạn.

**Q: Tôi bị khóa thẻ. Nguyên nhân và cách mở khóa?**
A: Thẻ bị khóa khi: (1) Sách quá hạn chưa trả, (2) Vi phạm quy định thư viện. Liên hệ bộ phận phục vụ để được mở khóa sau khi xử lý nguyên nhân.

## WiFi và tiện ích

**Q: Thư viện có WiFi không?**
A: Có. WiFi: IUH-Library. Đăng nhập bằng tài khoản sinh viên (MSSV và mật khẩu).

**Q: Có chỗ để xe không?**
A: Có khu vực để xe miễn phí cho sinh viên IUH ở tầng trệt.

**Q: Có chỗ đọc sách yên tĩnh không?**
A: Có. Tầng C có khu vực đọc yên tĩnh. Tầng B có khu vực học nhóm.

## Phòng học và thiết bị

**Q: Thư viện có phòng học nhóm không?**
A: Có. Liên hệ quản lý thư viện để đặt phòng học nhóm trước.

**Q: Có máy tính để tra cứu không?**
A: Có. Khu vực tra cứu có máy tính phục vụ tại mỗi tầng.
</file>

