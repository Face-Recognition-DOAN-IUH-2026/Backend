    token = _make_token(payload)

    with pytest.raises(Exception):
        decode_token(
            token=token,
            secret=SECRET,
            issuer=ISSUER,
            audience=AUDIENCE,
            expected_type="access",
        )


def test_decode_token_wrong_secret():
