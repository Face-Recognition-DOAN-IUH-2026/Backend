<file path="face-recognition-service/infra/milvus_client.py">
from __future__ import annotations

import uuid
from typing import Any

from pymilvus import Collection, CollectionSchema, DataType, FieldSchema, connections, utility


class MilvusClient:
    def __init__(
        self,
        *,
        host: str,
        port: int,
        collection_name: str,
        dim: int,
        metric_type: str = "COSINE",
    ) -> None:
        self.host = host
        self.port = port
        self.collection_name = collection_name
        self.dim = dim
        self.metric_type = metric_type

        connections.connect(alias="default", host=self.host, port=self.port)
        self.collection = self._get_or_create_collection()
        self._collection_loaded = True

    # ------------------------------------------------------------------
    # Internal helpers
    # ------------------------------------------------------------------

    def _ensure_collection_loaded(self) -> None:
        if self._collection_loaded:
            return
        try:
            self.collection.load()
            self._collection_loaded = True
        except Exception:
            pass

    def _get_or_create_collection(self) -> Collection:
        if utility.has_collection(self.collection_name):
            collection = Collection(self.collection_name)
            fields = {f.name: f for f in collection.schema.fields}
            # Migrate from old schema (missing quality_score or patron_id)
            if "patron_id" not in fields or "quality_score" not in fields:
                logger = __import__("logging").getLogger(__name__)
                logger.warning("Dropping old collection '%s' (missing patron_id or quality_score) and recreating...", self.collection_name)
                collection.release()
                utility.drop_collection(self.collection_name)
                return self._create_collection()
            if not collection.indexes:
                collection.create_index(
                    field_name="embedding",
                    index_params={"metric_type": self.metric_type},
                )
            try:
                collection.load()
            except Exception:
                pass
            return collection

        return self._create_collection()

    def _create_collection(self) -> Collection:
        fields = [
            FieldSchema(name="id", dtype=DataType.VARCHAR, max_length=64, is_primary=True),
            FieldSchema(name="patron_id", dtype=DataType.VARCHAR, max_length=128),
            FieldSchema(name="quality_score", dtype=DataType.FLOAT),
            FieldSchema(name="embedding", dtype=DataType.FLOAT_VECTOR, dim=self.dim),
        ]
        schema = CollectionSchema(fields=fields, description="face embeddings (multi per patron)")
        collection = Collection(
            name=self.collection_name,
            schema=schema,
            using="default",
        )
        collection.create_index(field_name="embedding", index_params={"metric_type": self.metric_type})
        collection.create_index(field_name="patron_id", index_name="idx_patron_id")
        collection.load()
        return collection

    # ------------------------------------------------------------------
    # Public API
    # ------------------------------------------------------------------

    def insert_embedding(self, *, patron_id: str, embedding: list[float], quality_score: float = 0.5) -> None:
        row_id = f"{patron_id}#{uuid.uuid4().hex[:12]}"
        self.collection.insert([[row_id], [patron_id], [quality_score], [embedding]])
        self.collection.flush()
        self._collection_loaded = False

    def search(self, *, embedding: list[float], top_k: int = 5) -> list[dict[str, Any]]:
        self._ensure_collection_loaded()
        search_params = {"metric_type": self.metric_type, "params": {"nprobe": 16}}
        res = self.collection.search(
            data=[embedding],
            anns_field="embedding",
            param=search_params,
            limit=top_k,
            output_fields=["patron_id", "quality_score"],
        )
        seen: dict[str, dict] = {}
        for r in res[0]:
            pid = r.entity.get("patron_id")
            score = float(r.score)
            qs = float(r.entity.get("quality_score") or 0.5)
            if pid not in seen or score > seen[pid]["score"]:
                seen[pid] = {"patron_id": pid, "score": score, "quality_score": qs}
        return list(seen.values())

    def get_embeddings_by_patron_id(self, patron_id: str) -> list[list[float]]:
        self._ensure_collection_loaded()
        results = self.collection.query(
            expr=f'patron_id == "{patron_id}"',
            output_fields=["embedding"],
            limit=100,
        )
        return [r["embedding"] for r in results if r.get("embedding")]

    def delete_by_patron_id(self, *, patron_id: str) -> None:
        collection = self.collection
        collection.delete(f'patron_id == "{patron_id}"')
        collection.flush()
